@page
@model website_e_commerce.Areas.Identity.Pages.Account.AccessDeniedModel
@{
    Layout = null; // ✅ full màn hình
    ViewData["Title"] = "403 - Access Denied";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/access-denied.css" rel="stylesheet" />
</head>

<body>
    <div class="access-wrapper">
        <div class="access-box">
            <div class="icon">
                <img src="~/images/access-denied.png" alt="Alternate Text" style="width: 410px;" />
            </div>

            <h1>403</h1>
            <h2>Không thể truy cập</h2>

            <p>
                Bạn <strong>không có quyền</strong> truy cập vào tài nguyên này.<br />
                Vui lòng đăng nhập bằng tài khoản phù hợp hoặc liên hệ quản trị viên.
            </p>

            <div class="buttons">
                <a href="/" class="btn btn-outline-light">🏠 Trang chủ</a>
                <a href="/Identity/Account/Login" class="btn btn-primary">🔐 Đăng nhập</a>
            </div>
        </div>
    </div>
</body>
</html>

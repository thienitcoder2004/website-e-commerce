@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="section-login">
    <!-- Breadcrumb -->
    <div class="bread-cumb">
        <div class="container">
            <ul class="breadcrumb">
                <li class="home">
                    <a href="/" class="text-black">
                        <span>Trang chủ</span>
                    </a>
                    <span class="mr-lr">
                        <i class="fa-solid fa-chevron-right"></i>
                    </span>
                </li>
                <li>
                    <strong><span>Quên mật khẩu</span></strong>
                </li>
            </ul>
        </div>
    </div>

    <!-- Form giống login -->
    <div class="section-form-register">
        <div class="container">
            <div class="tabs">
                <a href="/Identity/Account/Login" class="tab">ĐĂNG NHẬP</a>
                <a href="/Identity/Account/Register" class="tab">ĐĂNG KÝ</a>
            </div>

            <div class="form-box">
                <h2>QUÊN MẬT KHẨU</h2>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input" class="form-control"
                               placeholder="Nhập email hoặc số điện thoại..." />
                        <label asp-for="Input">Email hoặc Số điện thoại</label>
                        <span asp-validation-for="Input" class="text-danger"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-lg btn-primary">
                        Gửi mã xác nhận
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

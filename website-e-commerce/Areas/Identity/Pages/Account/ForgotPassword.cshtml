@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container mt-5">
    <div class="card shadow-lg mx-auto" style="max-width: 450px;">
        <div class="card-body">
            <h4 class="text-center mb-4 text-primary">🔐 Quên mật khẩu</h4>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Email hoặc Số điện thoại</label>
                    <input asp-for="Input" class="form-control" placeholder="Nhập email hoặc số điện thoại..." />
                    <span asp-validation-for="Input" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Gửi mã xác nhận</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

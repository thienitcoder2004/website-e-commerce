@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<style>
    .manage-header h5 {
        font-weight: 600;
        margin-bottom: 4px;
        font-size: 18px;
    }

    .manage-header small {
        color: #999;
        font-size: 13px;
    }

    .manage-row {
        display: flex;
        align-items: center;
        margin-bottom: 18px;
        font-size: 14px;
    }

    .manage-row-label {
        width: 150px;
        color: #757575;
        text-align: right;
        padding-right: 24px;
        white-space: nowrap;
    }

    .manage-row-control {
        flex: 1;
    }

        .manage-row-control .form-control {
            max-width: 360px;
            height: 36px;
            font-size: 14px;
            padding: 6px 10px;
        }

    .btn-manage-save {
        margin-left: 150px;
        padding: 6px 32px;
        font-size: 14px;
        border-radius: 2px;
        background-color: #ee4d2d;
        border-color: #ee4d2d;
    }

        .btn-manage-save:hover {
            background-color: #d73211;
            border-color: #d73211;
        }

    @@media (max-width: 992px) {
        .manage-row

    {
        flex-direction: column;
        align-items: flex-start;
    }

    .manage-row-label {
        width: 100%;
        text-align: left;
        margin-bottom: 4px;
    }

    .btn-manage-save {
        margin-left: 0;
    }

    }
</style>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="manage-header mb-4">
    <h5>Đổi mật khẩu</h5>
    <small>Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu cho người khác</small>
</div>

<form id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

    <!-- Mật khẩu hiện tại -->
    <div class="manage-row">
        <div class="manage-row-label">Mật khẩu hiện tại</div>
        <div class="manage-row-control">
            <input asp-for="Input.OldPassword"
                   class="form-control"
                   autocomplete="current-password"
                   placeholder="Nhập mật khẩu hiện tại" />
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>
    </div>

    <!-- Mật khẩu mới -->
    <div class="manage-row">
        <div class="manage-row-label">Mật khẩu mới</div>
        <div class="manage-row-control">
            <input asp-for="Input.NewPassword"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="Nhập mật khẩu mới" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>
    </div>

    <!-- Nhập lại mật khẩu -->
    <div class="manage-row">
        <div class="manage-row-label">Nhập lại mật khẩu</div>
        <div class="manage-row-control">
            <input asp-for="Input.ConfirmPassword"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="Nhập lại mật khẩu mới" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-manage-save">
        Lưu
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

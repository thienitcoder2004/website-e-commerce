@using website_e_commerce.Models
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@{
    ApplicationUser? user = null;
    if (User.Identity?.IsAuthenticated ?? false)
    {
        user = await UserManager.GetUserAsync(User);
    }
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    var name = user?.HoTen ?? "Tài khoản của tôi";
    var avatar = user?.AvatarUrl ?? Url.Content("~/images/avatar-default.png");
}

<style>
    .account-sidebar {
        background: #fff;
        border-radius: 8px;
        padding: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }

    .account-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .account-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        overflow: hidden;
        border: 1px solid #eee;
    }

    .account-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .account-name {
        font-weight: 600;
        font-size: 15px;
    }

    .account-edit {
        font-size: 12px;
        color: #888;
    }

    .account-edit a {
        color: #ee4d2d;
        text-decoration: none;
    }

    .account-section {
        font-size: 13px;
        color: #999;
        margin: 12px 0 6px;
    }

    .account-sidebar .nav-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 8px;
        font-size: 14px;
        color: #333;
        border-radius: 6px;
    }

    .account-sidebar .nav-link i {
        color: #ee4d2d;
        width: 18px;
    }

    .account-sidebar .nav-link.active,
    .account-sidebar .nav-link:hover {
        background: rgba(238, 77, 45, 0.1);
        color: #ee4d2d;
    }
</style>

<div class="account-sidebar">
    <div class="account-header">
        <div class="account-avatar">
            <img src="@avatar" />
        </div>
        <div>
            <div class="account-name">@name</div>
            <div class="account-edit">
                <a href="#profile-form">Sửa hồ sơ</a>
            </div>
        </div>
    </div>

    <div class="account-section">Tài khoản</div>

    <ul class="nav flex-column">
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index">
                <i class="fas fa-user"></i> Hồ sơ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email">
                <i class="fas fa-envelope"></i> Email
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword">
                <i class="fas fa-lock"></i> Đổi mật khẩu
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewContext.ActionDescriptor.DisplayName.Contains("Address") ? "active" : "")"
                asp-page="./Address">
                <i class="fas fa-map-marker-alt"></i> Địa chỉ của tôi
            </a>
        </li>
        @if (hasExternalLogins)
        {
            <li class="nav-item">
                <a class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" id="external-login"
                    asp-page="./ExternalLogins">
                    <i class="fas fa-share-alt"></i> Đăng nhập ngoài
                </a>
            </li>
        }
    </ul>
</div>
@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}

<!-- ❌ ĐÃ LOẠI BỎ:
     - Manage your account
     - Change your account settings
-->

<partial name="_StatusMessage" for="StatusMessage" />

<div class="profile-header mb-4">
    <h5>Hồ sơ của tôi</h5>
    <small>Quản lý thông tin cá nhân để bảo mật tài khoản</small>
</div>

<form id="profile-form" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label class="form-label">Tên đăng nhập</label>
        <input class="form-control" value="@Model.Username" disabled />
    </div>

    <div class="mb-3">
        <label class="form-label">Họ</label>
        <input asp-for="Input.Ho" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Tên</label>
        <input asp-for="Input.Ten" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Số điện thoại</label>
        <input asp-for="Input.PhoneNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Ảnh đại diện</label><br />
        <img src="@Model.AvatarUrl"
            style="width:90px;height:90px;border-radius:50%;object-fit:cover;margin-bottom:8px;" />
        <input asp-for="Input.AvatarFile" type="file" class="form-control" />
        <small class="text-muted">JPEG / PNG • Tối đa 1MB</small>
    </div>

    <button type="submit" class="btn btn-danger px-4">
        Lưu
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
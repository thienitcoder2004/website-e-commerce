    <section class="section-product-flashsale mb-5 mt-5">
        <div class="container">
            <h3 class="title-index">
                <span class="title-name">Flash Sale Ưu Đãi Lớn</span>
            </h3>

            <!-- SLOT THỜI GIAN -->
            @if (slots.Any())
            {
                <div class="flash-slots mt-3">
                    @foreach (var startTime in slots)
                    {
                        var fsSlot = flashSales.FirstOrDefault(x => x.StartTime == startTime);

                        bool isCurrent = fsSlot != null &&
                        DateTime.Now >= fsSlot.StartTime &&
                        DateTime.Now <= fsSlot.EndTime;

                        var startKey = startTime.ToString("yyyy-MM-ddTHH:mm");

                        <div class="flash-slot @(isCurrent ? "active" : "")" data-start="@startKey">
                            <div class="slot-hour">@startTime.ToString("HH:mm")</div>
                            <div class="slot-status">
                                @(isCurrent ? "Đang diễn ra" : "Sắp diễn ra")
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- SWIPER -->
            <div class="swiper flash-swiper mt-4">
                <div class="swiper-wrapper">

                    @foreach (var fs in flashSales)
                    {
                        var itemKey = fs.StartTime.ToString("yyyy-MM-ddTHH:mm");
                        int percent = fs.FlashQuantity > 0
                        ? (int)Math.Round((double)fs.SoldQuantity / fs.FlashQuantity * 100)
                        : 0;
                        if (percent > 100) percent = 100;

                        <div class="swiper-slide flash-item" data-start="@itemKey">
                            <a href="/Product/Details/@fs.Product.Id" class="flash-link">

                                <div class="flash-card">
                                    <div class="flash-img-wrap">
                                        <img src="@fs.Product.ImageUrl" class="flash-img" alt="@fs.Product.Name" />
                                    </div>

                                    <h5 class="flash-name">@fs.Product.Name</h5>

                                    <div class="flash-price">
                                        @fs.FlashPrice.ToString("N0") đ
                                    </div>

                                    <div class="flash-progress">
                                        <div class="flash-progress-bar">
                                            @percent% đã bán
                                        </div>
                                    </div>

                                    <div class="flash-countdown"
                                         data-end="@fs.EndTime.ToString("yyyy-MM-ddTHH:mm:ss")">
                                        00:00:00
                                    </div>
                                </div>

                            </a>
                        </div>
                    }

                </div>

                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>

        </div>
    </section>

}

<style>
    .flash-slots {
        display: flex;
        gap: 15px;
        overflow-x: auto;
        padding-bottom: 8px;
    }

    .flash-slot {
        padding: 10px 18px;
        border-radius: 8px;
        background: #f8f8f8;
        text-align: center;
        cursor: pointer;
        transition: .3s;
        border: 2px solid transparent;
    }

        .flash-slot:hover {
            transform: translateY(-3px);
            border-color: #ff5722;
        }

        .flash-slot.active {
            background: #ffdecf;
            border-color: #ff5722;
        }

    .slot-hour {
        font-size: 20px;
        font-weight: bold;
        color: #e53935;
    }

    .slot-status {
        font-size: 13px;
        margin-top: 2px;
        color: #666;
    }

    /* FLASH CARD */
    .flash-card {
        background: white;
        padding: 15px;
        border-radius: 12px;
        text-align: center;
        transition: .3s;
        border: 1px solid #eee;
    }

        .flash-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(255, 79, 0, 0.25);
        }

    .flash-img-wrap {
        width: 100%;
        height: 170px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .flash-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: .3s;
    }

    .flash-card:hover .flash-img {
        transform: scale(1.05);
    }

    .flash-name {
        font-size: 15px;
        height: 40px;
        margin-top: 10px;
        color: #333;
        font-weight: 600;
    }

    .flash-price {
        font-size: 22px;
        font-weight: 800;
        color: #ff2d0a;
        margin: 5px 0 10px;
    }

    /* PROGRESS BAR */
    .flash-progress {
        width: 100%;
        background: #ffeaea;
        height: 22px;
        border-radius: 20px;
        overflow: hidden;
        margin-bottom: 10px;
        box-shadow: inset 0 0 3px rgba(0,0,0,0.15);
    }

    .flash-progress-bar {
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, #ff2d0a, #ffa726);
        color: white;
        font-size: 12px;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* COUNTDOWN */
    .flash-countdown {
        background: #222;
        color: #fff;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
        letter-spacing: 1px;
        margin-top: 5px;
    }

    /* SWIPER */
    .swiper-button-next,
    .swiper-button-prev {
        color: #ff5722 !important;
        padding: 25px;
    }

        .swiper-button-next:hover,
        .swiper-button-prev:hover {
            color: #d84315 !important;
        }

</style>

<script>
    // Khởi tạo Swiper nếu thư viện tồn tại
    if (window.Swiper) {
        var swiper = new Swiper(".flash-swiper", {
            slidesPerView: 6,
            spaceBetween: 10,
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev"
            },
            breakpoints: {
                0: { slidesPerView: 2 },
                576: { slidesPerView: 3 },
                768: { slidesPerView: 4 },
                992: { slidesPerView: 5 },
                1200: { slidesPerView: 6 }
            }
        });
    }

    // Countdown: nếu > 24h thì chuyển thành "X ngày HH:MM:SS"
    document.querySelectorAll(".flash-countdown").forEach(cd => {
        const endStr = cd.dataset.end;
        if (!endStr) return;

        const end = new Date(endStr).getTime();

        function tick() {
            const now = Date.now();
            let diff = end - now;

            if (diff <= 0) {
                cd.innerText = "Hết giờ";
                return;
            }

            const dayMs = 1000 * 60 * 60 * 24;
            const hourMs = 1000 * 60 * 60;
            const minuteMs = 1000 * 60;

            const days = Math.floor(diff / dayMs);
            diff -= days * dayMs;

            const h = Math.floor(diff / hourMs);
            diff -= h * hourMs;

            const m = Math.floor(diff / minuteMs);
            diff -= m * minuteMs;

            const s = Math.floor(diff / 1000);

            const hh = h.toString().padStart(2, "0");
            const mm = m.toString().padStart(2, "0");
            const ss = s.toString().padStart(2, "0");

            if (days > 0) {
                cd.innerText = `${days} ngày ${hh}:${mm}:${ss}`;
            } else {
                cd.innerText = `${hh}:${mm}:${ss}`;
            }
        }

        tick();
        setInterval(tick, 1000);
    });

    // Lọc sản phẩm theo slot
    function applySlotFilter() {
        const activeSlot = document.querySelector(".flash-slot.active");
        const items = document.querySelectorAll(".flash-item");
        if (!activeSlot || !items.length) return;

        const start = activeSlot.dataset.start;
        items.forEach(item => {
            item.style.display = (item.dataset.start === start) ? "" : "none";
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        const slots = document.querySelectorAll(".flash-slot");

        if (slots.length) {
            // Nếu chưa có slot nào active (không nằm trong khung giờ hiện tại) thì chọn slot đầu
            if (!document.querySelector(".flash-slot.active")) {
                slots[0].classList.add("active");
            }

            applySlotFilter();

            slots.forEach(slot => {
                slot.addEventListener("click", function () {
                    slots.forEach(s => s.classList.remove("active"));
                    this.classList.add("active");
                    applySlotFilter();
                });
            });
        }
    });
</script>

@model website_e_commerce.Models.Brand

@{
    ViewData["Title"] = "Xóa thương hiệu";
}

<div class="container mt-5">
    <h3 class="text-center text-danger mb-4">🗑️ Xác nhận xóa thương hiệu</h3>

    <div class="card shadow-sm">
        <div class="card-body text-center">
            <h4 class="mb-3">@Model.Name</h4>
            @if (!string.IsNullOrEmpty(Model.LogoUrl))
            {
                <img src="@Model.LogoUrl" width="100" class="rounded shadow-sm mb-3" />
            }
            <p class="text-muted">@Model.Description</p>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-secondary me-2">Hủy</a>
                <button type="submit" class="btn btn-danger">Xóa</button>
            </form>
        </div>
    </div>
</div>

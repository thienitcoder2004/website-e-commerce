@model List<website_e_commerce.Controllers.StockStatistics>

@{
    ViewBag.Title = "Thống kê kho hàng";
    var from = ViewBag.From as string;
    var to = ViewBag.To as string;
}

<style>
    /* WRAPPER */
    .stats-page-wrapper {
        background: radial-gradient(circle at top left, #eef2ff, #ffffff);
        padding: 28px 24px;
        border-radius: 18px;
        margin-top: 20px;
        box-shadow: 0 8px 24px rgba(15,23,42,0.12);
    }

    /* HEADER */
    .stats-title {
        font-weight: 800;
        font-size: 20px;
        text-transform: uppercase;
        color: #0d6efd;
        letter-spacing: .06em;
    }

    .stats-subtitle {
        font-size: 13px;
        color: #6b7280;
    }

    .stats-badge-summary {
        font-size: 13px;
        padding: 7px 16px;
        border-radius: 999px;
        background: #f9fafb;
        color: #374151;
        border: 1px solid #e5e7eb;
    }

    /* FILTER CARD */
    .filter-card {
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    }

    .filter-card .card-header {
        border-radius: 16px 16px 0 0;
        background: #fff;
        border-bottom: none;
        font-weight: 600;
        color: #6b7280;
        font-size: 14px;
    }

    /* TABLE */
    .table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    }

    .table thead th {
        background: #0d6efd;
        color: #fff;
        border-bottom: none;
        text-transform: uppercase;
        font-size: 13px;
    }

    .table tbody tr:hover {
        background-color: #f3f4ff;
    }

    /* BADGES STOCK */
    .badge-stock-ok {
        background: #d1ffdf;
        color: #0a7f2e;
        border: 1px solid #a3f3b9;
    }

    .badge-stock-low {
        background: #fff4cc;
        color: #8a6d00;
        border: 1px solid #ffe187;
    }

    .badge-stock-out {
        background: #ffd6d6;
        color: #c70000;
        border: 1px solid #ff9f9f;
    }

    @@media(max-width: 768px) {
        .filter-inline { flex-direction: column; }
        .filter-inline > * { width: 100%!important; }
    }
</style>

<div class="container">
    <div class="stats-page-wrapper">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
            <div>
                <h2 class="stats-title mb-1">📦 Thống kê kho hàng</h2>
                <p class="stats-subtitle">Theo dõi tổng nhập, tổng xuất, tồn kho theo thời gian.</p>
            </div>

            <span class="stats-badge-summary">
                <i class="fa-solid fa-box-open me-1"></i>
                Tổng sản phẩm: <strong>@Model.Count</strong>
            </span>
        </div>

        <!-- FILTER + EXPORT -->
        <div class="card filter-card mb-4 shadow-sm">
            <div class="card-header">
                <i class="fa-solid fa-filter me-1"></i> Bộ lọc thống kê
            </div>

            <div class="card-body">
                <form method="get" class="d-flex filter-inline align-items-end gap-3 flex-wrap">

                    <div>
                        <label class="fw-semibold">Từ ngày:</label>
                        <input type="date" name="from" value="@from" class="form-control shadow-sm" />
                    </div>

                    <div>
                        <label class="fw-semibold">Đến ngày:</label>
                        <input type="date" name="to" value="@to" class="form-control shadow-sm" />
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary mt-3 shadow-sm">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Lọc
                        </button>

                        <a asp-action="ExportStatisticsExcel"
                           asp-route-from="@from"
                           asp-route-to="@to"
                           class="btn btn-success mt-3 shadow-sm">
                            <i class="fa-solid fa-file-excel me-1"></i> Xuất Excel
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- TABLE -->
        <div class="table-wrapper">
            <table class="table table-hover table-striped mb-0">
                <thead class="text-center">
                    <tr>
                        <th>STT</th>
                        <th>Sản phẩm</th>
                        <th>Tổng nhập</th>
                        <th>Tổng xuất</th>
                        <th>Tồn hiện tại</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Không có dữ liệu thống kê trong thời gian đã chọn.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];

                            string badgeClass =
                                item.CurrentStock <= 0 ? "badge-stock-out" :
                                item.CurrentStock <= 5 ? "badge-stock-low" :
                                "badge-stock-ok";

                            string statusText =
                                item.CurrentStock <= 0 ? "Hết hàng" :
                                item.CurrentStock <= 5 ? "Sắp hết" :
                                "Còn hàng";

                            <tr>
                                <td class="text-center fw-semibold">@(@i + 1)</td>

                                <td>
                                    <div class="fw-semibold">@item.ProductName</div>
                                    <div class="small text-muted">
                                        <span class="badge @badgeClass px-3 py-1 mt-1">
                                            @statusText – Tồn: @item.CurrentStock
                                        </span>
                                    </div>
                                </td>

                                <td class="text-center text-primary fw-semibold">
                                    @item.TotalImport
                                </td>

                                <td class="text-center text-danger fw-semibold">
                                    @item.TotalExport
                                </td>

                                <td class="text-center">
                                    <span class="badge bg-light text-dark px-3 py-2">
                                        <i class="fa-solid fa-box-open me-1"></i>
                                        @item.CurrentStock
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

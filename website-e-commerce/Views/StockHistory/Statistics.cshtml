@model List<website_e_commerce.Controllers.StockStatistics>
@{
    ViewBag.Title = "Thống kê kho hàng";
    var from = ViewBag.From as string;
    var to = ViewBag.To as string;
}

<style>
    .page-title {
        font-weight: 700;
        letter-spacing: .5px;
    }

    .filter-card {
        border-radius: 16px;
        border: none;
    }

        .filter-card .card-header {
            border-radius: 16px 16px 0 0;
        }

    .stats-badge {
        font-size: 0.85rem;
        border-radius: 999px;
    }

    .table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    }

    .table thead th {
        background: #0d6efd;
        color: #fff;
        vertical-align: middle;
        border-bottom: none;
    }

    .table tbody tr:hover {
        background-color: #f8f9ff;
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .badge-stock-ok {
        background-color: #198754;
    }

    .badge-stock-low {
        background-color: #ffc107;
        color: #212529;
    }

    .badge-stock-out {
        background-color: #dc3545;
    }

    @@media (max-width: 768px) {
        .filter-inline

    {
        flex-direction: column;
        align-items: flex-start !important;
    }

    .filter-inline > * {
        width: 100% !important;
    }

    }
</style>

<div class="container py-4">
    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title text-primary mb-1">
                📦 Thống kê kho hàng
            </h2>
            <p class="text-muted mb-0">
                Theo dõi lượng nhập – xuất – tồn của từng sản phẩm trong khoảng thời gian lựa chọn.
            </p>
        </div>
        <span class="badge bg-light text-secondary stats-badge">
            <i class="fa-solid fa-database me-1"></i>
            Tổng sản phẩm: <strong>@(Model?.Count ?? 0)</strong>
        </span>
    </div>

    <!-- Bộ lọc thời gian + Export -->
    <div class="card shadow-sm filter-card mb-4">
        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-secondary">
                <i class="fa-solid fa-filter me-1"></i> Bộ lọc thống kê
            </span>
        </div>
        <div class="card-body pt-0">
            <form method="get" class="d-flex filter-inline align-items-end gap-3 flex-wrap">
                <div>
                    <label class="form-label fw-semibold mb-1">Từ ngày:</label>
                    <input type="date" name="from" value="@from" class="form-control" />
                </div>

                <div>
                    <label class="form-label fw-semibold mb-1">Đến ngày:</label>
                    <input type="date" name="to" value="@to" class="form-control" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Lọc
                    </button>
                    <a asp-action="ExportStatisticsExcel"
                       asp-route-from="@from"
                       asp-route-to="@to"
                       class="btn btn-success mt-3">
                        <i class="fa-solid fa-file-excel me-1"></i> Xuất Excel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="table-wrapper bg-white">
        <table class="table table-striped table-hover mb-0">
            <thead class="text-center">
                <tr>
                    <th style="width:70px;">STT</th>
                    <th>Sản phẩm</th>
                    <th style="width:140px;">Tổng nhập</th>
                    <th style="width:140px;">Tổng xuất</th>
                    <th style="width:150px;">Tồn hiện tại</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            Không có dữ liệu thống kê trong khoảng thời gian đã chọn.
                        </td>
                    </tr>
                }
                else
                {
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        string stockBadgeClass;
                        string stockText;

                        if (item.CurrentStock <= 0)
                        {
                            stockBadgeClass = "badge-stock-out";
                            stockText = "Hết hàng";
                        }
                        else if (item.CurrentStock <= 5)
                        {
                            stockBadgeClass = "badge-stock-low";
                            stockText = "Sắp hết";
                        }
                        else
                        {
                            stockBadgeClass = "badge-stock-ok";
                            stockText = "Còn hàng";
                        }

                        <tr>
                            <td class="text-center fw-semibold">@(i + 1)</td>
                            <td>
                                <div class="fw-semibold">@item.ProductName</div>
                                <div class="text-muted small">
                                    <span class="badge @stockBadgeClass mt-1">
                                        @stockText - Tồn: @item.CurrentStock
                                    </span>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="text-primary fw-semibold">@item.TotalImport</span>
                            </td>
                            <td class="text-center">
                                <span class="text-danger fw-semibold">@item.TotalExport</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark px-3 py-2">
                                    <i class="fa-solid fa-box-open me-1"></i>
                                    @item.CurrentStock
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

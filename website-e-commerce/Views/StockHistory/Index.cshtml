@model IEnumerable<website_e_commerce.Models.StockHistory>

@{
    ViewData["Title"] = "Lịch sử nhập – xuất kho";
    int totalRecords = Model?.Count() ?? 0;
}

<style>
    .stock-page-wrapper {
        background: radial-gradient(circle at top left, #eef2ff, #ffffff);
        padding: 28px 24px;
        border-radius: 18px;
        margin-top: 20px;
        box-shadow: 0 8px 24px rgba(15,23,42,0.12);
    }

    .stock-title {
        font-weight: 800;
        font-size: 20px;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #d00000;
    }

    .stock-subtitle {
        font-size: 13px;
        color: #6b7280;
    }

    .stock-badge-summary {
        font-size: 13px;
        padding: 6px 14px;
        border-radius: 999px;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        color: #374151;
    }

    .filter-card {
        border-radius: 16px;
        background: #ffffff;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(15,23,42,0.08);
        margin-bottom: 20px;
    }

    .stock-table-wrapper {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(15,23,42,0.08);
    }

    .table thead th {
        background: #0d6efd;
        color: white;
        border-bottom: none;
        text-transform: uppercase;
        font-size: 13px;
    }

    .table tbody tr:hover {
        background: #f3f4ff;
    }

    .act-import {
        color: #0f8a39;
        font-weight: bold;
    }

    .act-export {
        color: #2563eb;
        font-weight: bold;
    }

    .btn-action {
        border-radius: 10px;
        padding: 6px 12px;
    }

    @@media(max-width: 768px) {
        .stock-page-wrapper { padding: 20px 16px; }
    }
</style>

<div class="container">
    <div class="stock-page-wrapper">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
            <div>
                <h2 class="stock-title mb-1">📜 Lịch sử nhập – xuất kho</h2>
                <p class="stock-subtitle">Theo dõi chi tiết các lần nhập và xuất hàng.</p>
            </div>

            <span class="stock-badge-summary">
                <i class="fa-solid fa-clock-rotate-left me-1"></i>
                Tổng giao dịch: <strong>@totalRecords</strong>
            </span>
        </div>

        <!-- FILTER CARD -->
        <div class="filter-card">
            <form method="get" class="row g-3">

                <div class="col-md-3">
                    <label class="fw-bold">Loại lọc</label>
                    <select name="filterType" class="form-select shadow-sm">
                        <option value="">-- Tất cả --</option>
                        <option value="day">Theo ngày</option>
                        <option value="week">Theo tuần</option>
                        <option value="month">Theo tháng</option>
                        <option value="range">Khoảng thời gian</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="fw-bold">Từ ngày</label>
                    <input type="date" name="from" class="form-control shadow-sm" />
                </div>

                <div class="col-md-3">
                    <label class="fw-bold">Đến ngày</label>
                    <input type="date" name="to" class="form-control shadow-sm" />
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary w-100 shadow-sm">
                        🔎 Lọc
                    </button>
                </div>
            </form>

            <a class="btn btn-success mt-3 shadow-sm"
               href="@Url.Action("ExportExcel", new {
                    filterType = Context.Request.Query["filterType"],
                    from = Context.Request.Query["from"],
                    to = Context.Request.Query["to"]
               })">
                📤 Xuất Excel
            </a>
        </div>

        <!-- TABLE -->
        <div class="stock-table-wrapper">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle text-center mb-0">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Thao tác</th>
                            <th>Số lượng</th>
                            <th>Ghi chú</th>
                            <th>Thời gian</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var h in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@h.Product?.Name</td>

                                <td>
                                    @if (h.ActionType == "Import")
                                    {
                                        <span class="act-import">Nhập kho</span>
                                    }
                                    else
                                    {
                                        <span class="act-export">Xuất kho</span>
                                    }
                                </td>

                                <td>@h.Quantity</td>
                                <td>@h.Note</td>

                                <td>@h.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <a href="/StockHistory/Details/@h.Id"
                                           class="btn btn-info btn-sm btn-action">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a href="/StockHistory/Delete/@h.Id"
                                               class="btn btn-danger btn-sm btn-action"
                                               onclick="return confirm('🗑️ Xóa giao dịch này?');">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

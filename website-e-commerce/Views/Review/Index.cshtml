@model IEnumerable<website_e_commerce.Models.Reviews>
@{
    ViewData["Title"] = "Danh sách đánh giá sản phẩm";
}

<div class="container mt-4">
    <h3 class="fw-bold text-danger mb-4">📋 Danh sách đánh giá sản phẩm</h3>

    @if (!string.IsNullOrEmpty(ViewBag.ProductName))
    {
        <p class="text-muted mb-3">Sản phẩm: <strong>@ViewBag.ProductName</strong></p>
    }

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-danger text-center align-middle">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th style="width: 200px;">Tên sản phẩm</th>
                    <th style="width: 140px;">Số sao</th>
                    <th style="width: 220px;">Tiêu đề</th>
                    <th>Nội dung</th>
                    <th style="width: 160px;">Ngày tạo</th>
                    <th style="width: 130px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var r in Model)
                {
                    <tr id="row-@r.Id">
                        <td class="text-center">@i</td>
                        <td>@r.Product?.Name</td>
                        <td class="text-center align-middle">
                            <span class="fw-bold text-dark">@r.Rating / 5</span>
                        </td>
                        <td>@r.Title</td>
                        <td>@r.Body</td>
                        <td class="text-center">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary me-1" onclick="replyReview(@r.Id)">
                                <i class="fa-solid fa-reply"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deleteReview(@r.Id)">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>

                    @* Hàng hiển thị các câu trả lời *@
                    @if (r.Replies != null && r.Replies.Any())
                    {
                        <tr class="bg-light">
                            <td></td>
                            <td colspan="6">
                                @foreach (var rep in r.Replies.OrderBy(x => x.CreatedAt))
                                {
                                    <div class="small mb-1">
                                        <span class="badge bg-primary me-1">
                                            @(rep.IsAuto
                                                                            ? "HTM Shop"
                                                                            : (string.IsNullOrEmpty(rep.UserName) ? "Nhân viên HTM Shop" : rep.UserName))
                            </span>
                            @rep.Content
                            <span class="text-muted ms-1">(@rep.CreatedAt.ToString("dd/MM/yyyy HH:mm"))</span>
                        </div>
                                                }
                            </td>
                        </tr>
                    }

                    i++;
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted text-center mt-3">Chưa có đánh giá nào được ghi nhận.</p>
    }
</div>

<script>
    function deleteReview(id) {
        if (!confirm("🗑️ Bạn có chắc muốn xóa đánh giá này không?")) return;

        const formData = new FormData();
        formData.append("id", id);

        fetch('/Review/Delete', {
            method: 'POST',
            body: formData
        })
            .then(response => {
                if (!response.ok) throw new Error("HTTP error " + response.status);
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    const row = document.getElementById("row-" + id);
                    if (row) row.remove();
                    alert("✅ Đã xóa đánh giá thành công!");
                    location.reload();
                } else {
                    alert("❌ " + (data.message || "Không thể xóa đánh giá!"));
                }
            })
            .catch(err => alert("⚠️ Lỗi: " + err.message));
    }

    function replyReview(id) {
        const content = prompt("Nhập nội dung trả lời cho đánh giá #" + id + ":");
        if (!content || !content.trim()) return;

        const formData = new FormData();
        formData.append("reviewId", id);
        formData.append("content", content);

        fetch('/Review/AddReply', {
            method: 'POST',
            body: formData
        })
            .then(r => {
                if (!r.ok) throw new Error("HTTP " + r.status);
                return r.json();
            })
            .then(data => {
                if (data.success) {
                    alert("✅ Đã gửi trả lời!");
                    location.reload();
                } else {
                    alert("❌ " + (data.message || "Không thể gửi trả lời!"));
                }
            })
            .catch(err => alert("⚠️ Lỗi: " + err.message));
    }
</script>

<style>
    .table {
        width: 100%;
        table-layout: auto;
        word-wrap: break-word;
    }

        .table td,
        .table th {
            white-space: normal !important;
        }

        .table th {
            background-color: #ffccd5 !important;
            color: #333;
            font-weight: 600;
        }

    .btn-danger {
        background-color: #dc3545;
        border: none;
        font-weight: 500;
    }

        .btn-danger:hover {
            background-color: #bb2d3b;
        }

    .table tbody tr:hover {
        background-color: #fff5f5;
        transition: background-color 0.3s ease;
    }

    .table-responsive {
        overflow-x: hidden !important;
        overflow-y: auto;
        max-height: 600px;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background: #ffccd5;
        z-index: 2;
    }
</style>

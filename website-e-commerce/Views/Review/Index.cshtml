@model IEnumerable<website_e_commerce.Models.Reviews>
@{
    ViewData["Title"] = "Danh sách đánh giá sản phẩm";
}

<div class="container mt-4">
    <h3 class="fw-bold text-danger mb-4">📋 Danh sách đánh giá sản phẩm</h3>

    @if (!string.IsNullOrEmpty(ViewBag.ProductName))
    {
        <p class="text-muted mb-3">Sản phẩm: <strong>@ViewBag.ProductName</strong></p>
    }

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-danger text-center align-middle">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th style="width: 200px;">Tên sản phẩm</th>
                    <th style="width: 140px;">Số sao</th>
                    <th style="width: 220px;">Tiêu đề</th>
                    <th>Nội dung</th>
                    <th style="width: 160px;">Ngày tạo</th>
                    <th style="width: 100px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var r in Model)
                {
                    <tr id="row-@r.Id">
                        <td class="text-center">@i</td>
                        <td>@r.Product?.Name</td>
                        <td class="text-center align-middle">
                            <span class="fw-bold text-dark">@r.Rating / 5</span>
                        </td>
                        <td>@r.Title</td>
                        <td>@r.Body</td>
                        <td class="text-center">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-danger" onclick="deleteReview(@r.Id)">
                                <i class="fa-solid fa-trash"></i> Xóa
                            </button>
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted text-center mt-3">Chưa có đánh giá nào được ghi nhận.</p>
    }
</div>

<!-- ========== SCRIPT XÓA ========== -->
<script>
    function deleteReview(id) {
        if (!confirm("🗑️ Bạn có chắc muốn xóa đánh giá này không?")) return;

        const formData = new FormData();
        formData.append("id", id);

        fetch('/Review/Delete', {
            method: 'POST',
            body: formData
        })
        .then(response => {
            if (!response.ok) throw new Error("HTTP error " + response.status);
            return response.json();
        })
        .then(data => {
            if (data.success) {
                const row = document.getElementById("row-" + id);
                if (row) row.remove();
                alert("✅ Đã xóa đánh giá thành công!");
            } else {
                alert("❌ " + (data.message || "Không thể xóa đánh giá!"));
            }
        })
        .catch(err => alert("⚠️ Lỗi: " + err.message));
    }
</script>

<!-- ========== CSS ========== -->
<style>
    .table {
        width: 100%;
        table-layout: auto; /* ✅ Cho cột tự co giãn theo nội dung */
        word-wrap: break-word; /* ✅ Cho text tự xuống dòng */
    }

        .table td, .table th {
            white-space: normal !important; /* ✅ Cho phép text xuống dòng */
        }


        .table th {
            background-color: #ffccd5 !important;
            color: #333;
            font-weight: 600;
        }

        .table td i.fa-star {
            font-size: 1.1rem;
            margin: 0 2px;
        }

        .table td {
            white-space: nowrap;
        }

            .table td:nth-child(3) {
                min-width: 130px;
            }

    .btn-danger {
        background-color: #dc3545;
        border: none;
        font-weight: 500;
    }

        .btn-danger:hover {
            background-color: #bb2d3b;
        }

    /* Làm nổi khi hover */
    .table tbody tr:hover {
        background-color: #fff5f5;
        transition: background-color 0.3s ease;
    }

    .table-responsive {
        overflow-x: hidden !important; /* ❌ Ẩn thanh cuộn ngang */
        overflow-y: auto; /* ✅ Chỉ cuộn dọc nếu bảng quá dài */
        max-height: 600px;
    }


    .table thead th {
        position: sticky;
        top: 0;
        background: #ffccd5;
        z-index: 2;
    }
</style>

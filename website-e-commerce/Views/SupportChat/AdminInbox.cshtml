@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model List<website_e_commerce.Models.Conversation>

<div class="messenger-container">
    <div class="sidebar">
        @foreach (var c in Model)
        {
            string me = UserManager.GetUserId(User);
            string otherId = (c.User1Id == me) ? c.User2Id : c.User1Id;

            var other = await UserManager.FindByIdAsync(otherId);

            string name = otherId.StartsWith("guest_")
            ? "Khách " + otherId.Replace("guest_", "")
            : other?.HoTen ?? "Người dùng";

            string avatar = other?.AvatarUrl;
            string text = name.Substring(0, 1).ToUpper();

            <div class="chat-item">
                <div class="chat-avatar">
                    @if (!string.IsNullOrEmpty(avatar))
                    {
                        <img src="@avatar" style="width:40px;height:40px;border-radius:50%;" />
                    }
                    else
                    {
                        @text
                    }
                </div>

                <div class="chat-info">
                    <a href="/SupportChat/ChatBox?id=@c.Id" style="text-decoration:none;color:inherit;">
                        <strong>@name</strong><br />
                        <small>Xem hội thoại...</small>
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="chat-content">
        Chọn một cuộc trò chuyện
    </div>
</div>

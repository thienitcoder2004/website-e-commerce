@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model List<website_e_commerce.Models.Conversation>

<div class="messenger-wrapper">
    <!-- 🧭 Sidebar danh sách hội thoại -->
    <div class="messenger-sidebar">
        <div class="sidebar-header">
            <div>
                <h5 class="fw-bold text-white mb-1">
                    💬 Hộp thư hỗ trợ
                </h5>
                <span class="sidebar-subtitle">
                    Quản lý các cuộc trò chuyện với khách hàng
                </span>
            </div>
        </div>

        <!-- Ô tìm kiếm -->
        <div class="sidebar-search">
            <div class="input-group input-group-sm">
                <span class="input-group-text">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" class="form-control" id="searchConversation"
                       placeholder="Tìm khách / mã guest..." />
            </div>
        </div>

        <div class="sidebar-list" id="conversationList">
            @if (Model != null && Model.Any())
            {
                @foreach (var c in Model)
                {
                    string me = UserManager.GetUserId(User);
                    string otherId = (c.User1Id == me) ? c.User2Id : c.User1Id;
                    var other = await UserManager.FindByIdAsync(otherId);

                    string name = otherId.StartsWith("guest_")
                    ? "Khách " + otherId.Replace("guest_", "")
                    : other?.HoTen ?? "Người dùng";

                    string avatar = other?.AvatarUrl;
                    string text = name.Substring(0, 1).ToUpper();

                    <a href="/SupportChat/ChatBox?id=@c.Id"
                       class="chat-item"
                       data-name="@name.ToLower()">
                        <div class="chat-avatar">
                            @if (!string.IsNullOrEmpty(avatar))
                            {
                                <img src="@avatar" alt="@name" />
                            }
                            else
                            {
                                <div class="avatar-placeholder">@text</div>
                            }
                        </div>
                        <div class="chat-info">
                            <div class="chat-name">@name</div>
                            <div class="chat-preview">
                                Xem hội thoại →
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="text-center text-muted p-4">
                    <i class="fa-regular fa-comments fa-2x mb-2"></i><br />
                    Chưa có cuộc trò chuyện nào
                </div>
            }
        </div>
    </div>

    <!-- 💭 Nội dung chat chính -->
    <div class="messenger-content">
        <div class="empty-chat">
            <i class="fa-regular fa-message fa-3x text-muted"></i>
            <p class="mt-3 text-muted">Chọn một cuộc trò chuyện để bắt đầu hỗ trợ khách hàng</p>
        </div>
    </div>
</div>

<!-- =================== 💅 CSS giao diện Messenger =================== -->
<style>
    .messenger-wrapper {
        display: flex;
        height: calc(100vh - 80px);
        background: #f4f6fb;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
        margin-top: 10px;
    }

    /* Sidebar trái */
    .messenger-sidebar {
        width: 320px;
        background: linear-gradient(180deg, #0d6efd, #0048b3);
        color: #fff;
        display: flex;
        flex-direction: column;
    }

    .sidebar-header {
        padding: 16px 18px 10px 18px;
        border-bottom: 1px solid rgba(255,255,255,0.15);
    }

    .sidebar-subtitle {
        font-size: 12px;
        opacity: 0.85;
    }

    .sidebar-search {
        padding: 10px 12px;
        background: rgba(255, 255, 255, 0.08);
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

        .sidebar-search .input-group-text {
            border-radius: 999px 0 0 999px;
            border: none;
            background: #fff;
            color: #6c757d;
        }

        .sidebar-search .form-control {
            border-radius: 0 999px 999px 0;
            border: none;
            font-size: 13px;
        }

            .sidebar-search .form-control:focus {
                box-shadow: none;
            }

    .sidebar-list {
        flex: 1;
        overflow-y: auto;
        background: #fdfdfd;
        color: #333;
    }

    .chat-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-bottom: 1px solid #f0f0f0;
        text-decoration: none;
        color: #222;
        transition: all 0.18s ease-in-out;
        background-color: #ffffff;
    }

        .chat-item:hover {
            background: #e8f1ff;
            transform: translateX(2px);
        }

    .chat-avatar img {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #0d6efd;
    }

    .avatar-placeholder {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #0d6efd;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        border: 2px solid #fff;
    }

    .chat-info {
        flex: 1;
        min-width: 0;
    }

    .chat-name {
        font-weight: 600;
        color: #111827;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 14px;
    }

    .chat-preview {
        font-size: 12px;
        color: #6b7280;
    }

    /* Khung chat bên phải */
    .messenger-content {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        background: radial-gradient(circle at top left, #e0f2fe, #ffffff);
        border-left: 1px solid #e5e7eb;
        position: relative;
    }

    .empty-chat {
        text-align: center;
    }

        .empty-chat p {
            font-size: 14px;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .messenger-wrapper {
            flex-direction: column;
            height: calc(100vh - 120px);
        }

        .messenger-sidebar {
            width: 100%;
            height: 50%;
        }

        .messenger-content {
            height: 50%;
        }
    }
</style>

@section Scripts {
    <script>
        // Lọc danh sách hội thoại theo tên / mã khách
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("searchConversation");
            const items = document.querySelectorAll(".chat-item");

            if (!searchInput) return;

            searchInput.addEventListener("input", function () {
                const keyword = this.value.trim().toLowerCase();

                items.forEach(item => {
                    const name = item.getAttribute("data-name") || "";
                    if (name.includes(keyword)) {
                        item.style.display = "";
                    } else {
                        item.style.display = "none";
                    }
                });
            });
        });
    </script>
}

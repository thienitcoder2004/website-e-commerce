@model List<website_e_commerce.Models.Message>

@{
    var currentUserId = ViewBag.CurrentUserId as string;
    var otherUserId = ViewBag.OtherUserId as string;
    int conversationId = ViewBag.ConversationId;
    string otherName = ViewBag.OtherUserName as string ?? "Người dùng";
}

<style>
    .messenger-wrapper {
        display: flex;
        height: 85vh;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #ddd;
    }

    .chat-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #e5e7eb;
    }

    .chat-header {
        padding: 12px 16px;
        background: #fff;
        border-bottom: 1px solid #ddd;
        font-size: 18px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .chat-header .back-btn {
            border: none;
            background: transparent;
            padding: 6px 8px;
            border-radius: 50%;
            transition: background 0.2s;
        }

            .chat-header .back-btn:hover {
                background: #f2f2f2;
            }

            .chat-header .back-btn i {
                font-size: 18px;
            }

    .msg-box {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .msg {
        max-width: 55%;
        padding: 12px 16px;
        border-radius: 20px;
        line-height: 1.4;
        font-size: 15px;
        word-break: break-word;
    }

    .me {
        align-self: flex-end;
        background: #0084ff;
        color: #fff;
        border-bottom-right-radius: 0;
    }

    .other {
        align-self: flex-start;
        background: #fff;
        color: #111;
        border-bottom-left-radius: 0;
    }

    .chat-input {
        padding: 15px 20px;
        background: #fff;
        border-top: 1px solid #ddd;
    }

    .input-group input {
        border-radius: 25px;
        padding: 12px 18px;
    }

    .input-group button {
        border-radius: 50%;
        width: 48px;
        height: 48px;
        margin-left: 10px;
    }
</style>

<div class="messenger-wrapper">
    <div class="chat-area">
        <div class="chat-header">
            <!-- Nút quay lại -->
            <button type="button" class="back-btn" onclick="window.history.back();">
                <i class="fa fa-arrow-left"></i>
            </button>

            <span>Đang chat với @otherName</span>
        </div>

        <div id="chatMessages" class="msg-box">
            @foreach (var m in Model)
            {
                bool isMe = m.SenderId == currentUserId;
                <div class="msg @(isMe ? "me" : "other")">
                    @m.Content
                </div>
            }
        </div>

        <div class="chat-input">
            <div class="input-group">
                <input id="msgInput" class="form-control" placeholder="Aa..." autocomplete="off" />
                <button id="sendBtn" class="btn btn-primary">
                    <i class="fa fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const convId = "@conversationId";
    const currentUser = "@currentUserId";
    const otherUser = "@otherUserId";

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/supportChatHub")
        .build();

    connection.start();

    const msgBox = document.getElementById("chatMessages");
    const input = document.getElementById("msgInput");
    const btn = document.getElementById("sendBtn");

    btn.onclick = sendMessage;
    input.addEventListener("keypress", e => {
        if (e.key === "Enter") sendMessage();
    });

    connection.on("ReceiveSupportMessage",
        function (conversationId, senderId, receiverId, content) {
            if (conversationId == convId && senderId !== currentUser) {
                addMessage(content, false);
            }
        });

    function sendMessage() {
        let text = input.value.trim();
        if (!text) return;

        fetch("/SupportChat/Send", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                receiverId: otherUser,
                content: text,
                conversationId: convId
            })
        })
            .then(res => res.json())
            .then(data => {
                connection.invoke("SendToAll",
                    data.conversationId,
                    currentUser,
                    otherUser,
                    text);
            });

        addMessage(text, true);
        input.value = "";
    }

    function addMessage(text, isMe) {
        let div = document.createElement("div");
        div.className = "msg " + (isMe ? "me" : "other");
        div.innerHTML = text;
        msgBox.appendChild(div);
        msgBox.scrollTop = msgBox.scrollHeight;
    }

    setTimeout(() => { msgBox.scrollTop = msgBox.scrollHeight; }, 200);
</script>

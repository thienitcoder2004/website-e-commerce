@model website_e_commerce.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var payment = Model.Payments.FirstOrDefault();
}

<div class="container py-5">
    <h2 class="fw-bold text-danger mb-4 text-center">🧾 Chi tiết đơn hàng #@Model.Id</h2>

    <!-- 🔹 Thông tin khách hàng -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="fw-bold text-primary">👤 Thông tin khách hàng</h5>
            <p><b>Họ tên:</b> @Model.ApplicationUser?.HoTen</p>
            <p><b>Email:</b> @Model.ApplicationUser?.Email</p>
            <p><b>SĐT:</b> @Model.ApplicationUser?.PhoneNumber</p>
            <p><b>Địa chỉ giao hàng:</b> @Model.ShippingAddress</p>
        </div>
    </div>

    <!-- 🔹 Sản phẩm trong đơn -->
    <h5 class="fw-bold text-secondary mb-3">📦 Sản phẩm trong đơn</h5>
    <table class="table table-bordered shadow-sm mb-4">
        <thead class="table-danger text-center">
            <tr>
                <th>Tên sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@item.Product?.Name</td>
                    <td>@item.Quantity</td>
                    <td>@String.Format("{0:N0} đ", item.Price)</td>
                    <td>@String.Format("{0:N0} đ", item.Price * item.Quantity)</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- 🔹 Thông tin thanh toán -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="fw-bold text-primary mb-3">💳 Thông tin thanh toán</h5>
            @if (payment != null)
            {
                <p><b>Phương thức:</b> @payment.PaymentMethod</p>
                <p>
                    <b>Trạng thái:</b>
                    <span class="badge bg-@(payment.Status == "Success" ? "success" :
                                                                      payment.Status == "Pending" ? "warning text-dark" : "danger")">
                        @(payment.Status == "Success" ? "Thành công" :
                                            payment.Status == "Pending" ? "Đang chờ" : "Thất bại")
                </span>
            </p>
            <p><b>Tổng tiền:</b> <span class="text-danger fw-bold">@String.Format("{0:N0} đ", payment.Amount)</span></p>
            <p><b>Ngày thanh toán:</b> @payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")</p>

                <!-- 🔹 Form cập nhật trạng thái -->
                <form asp-action="UpdateStatus" method="post" class="mt-3">
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <div class="input-group" style="max-width: 400px;">
                        <select name="status" class="form-select">
                            <option value="Pending" selected="@(payment.Status == "Pending")">Đang chờ</option>
                            <option value="Success" selected="@(payment.Status == "Success")">Thành công</option>
                            <option value="Failed" selected="@(payment.Status == "Failed")">Thất bại</option>
                        </select>
                        <button type="submit" class="btn btn-outline-success fw-bold">Cập nhật</button>
                    </div>
                </form>

                <!-- 🔹 Nút xác nhận nhanh -->
                <form asp-action="UpdateStatus" method="post" class="mt-3 d-inline-block">
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <input type="hidden" name="status" value="Success" />
                    <button type="submit" class="btn btn-success fw-bold shadow-sm"
                            onclick="return confirm('✅ Xác nhận đơn hàng này đã thanh toán thành công?');">
                        ✔️ Xác nhận thanh toán thành công
                    </button>
                </form>

                <form asp-action="UpdateStatus" method="post" class="mt-3 d-inline-block">
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <input type="hidden" name="status" value="Failed" />
                    <button type="submit" class="btn btn-outline-danger fw-bold shadow-sm"
                            onclick="return confirm('❌ Xác nhận đơn hàng này thất bại hoặc hủy?');">
                        ❌ Đánh dấu thất bại
                    </button>
                </form>
                        }
            else
            {
                <p class="text-muted">Chưa có thông tin thanh toán cho đơn hàng này.</p>
            }
        </div>
    </div>

    <div class="text-end mt-4">
        <h4>Tổng cộng: <span class="text-danger fw-bold">@String.Format("{0:N0} đ", Model.TotalPrice)</span></h4>
        <a asp-action="Index" class="btn btn-outline-danger mt-3">⬅ Quay lại danh sách</a>
    </div>
</div>

<style>
    .btn-success {
        background-color: #28a745;
        border: none;
        transition: 0.3s;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
    }

    .card-body p {
        margin-bottom: 0.4rem;
    }
</style>

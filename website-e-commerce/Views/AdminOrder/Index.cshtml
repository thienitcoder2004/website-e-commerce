@using System.Linq
@model IEnumerable<website_e_commerce.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    int totalOrders = Model?.Count() ?? 0;
}

<style>
    .order-page-wrapper {
        background: radial-gradient(circle at top left, #eef2ff, #ffffff);
        border-radius: 18px;
        padding: 28px 24px;
        margin-top: 20px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
    }

    .order-title {
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
        font-size: 18px;
    }

    .order-subtitle {
        font-size: 13px;
        color: #6b7280;
    }

    .order-badge-summary {
        font-size: 13px;
        border-radius: 999px;
        background: #f9fafb;
        color: #4b5563;
        border: 1px solid #e5e7eb;
        padding: 6px 14px;
    }

    .order-table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.08);
        background: #fff;
    }

    .table thead th {
        background: #0d6efd;
        color: #fff;
        border-bottom: none;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background-color: #f3f4ff;
    }

    .status-pill {
        font-size: 12px;
        padding: 5px 12px;
        border-radius: 999px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 120px;
    }

    .status-pending {
        background: #fff7e6;
        color: #b55a00;
        border: 1px solid #ffd89b;
    }

    .status-shipping {
        background: #e6f6ff;
        color: #0d6efd;
        border: 1px solid #9cd6ff;
    }

    .status-success {
        background: #e6ffed;
        color: #0f8a39;
        border: 1px solid #9ef8c2;
    }

    .status-cancel {
        background: #ffe6e6;
        color: #c0392b;
        border: 1px solid #ffb3b3;
    }

    .status-none {
        background: #f0f0f0;
        color: #6c757d;
        border: 1px solid #cccccc;
    }
</style>

<div class="container">
    <div class="order-page-wrapper">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="order-title text-primary mb-1">📦 Quản lý đơn hàng</h2>
                <p class="order-subtitle mb-0">
                    Theo dõi trạng thái và xử lý đơn hàng của khách hàng
                </p>
            </div>

            <span class="order-badge-summary">
                Tổng đơn hàng: <strong>@totalOrders</strong>
            </span>
        </div>

        <!-- TABLE -->
        <div class="order-table-wrapper">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="text-center">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody class="text-center">
                        @foreach (var order in (Model ?? Enumerable.Empty<website_e_commerce.Models.Order>()).OrderBy(o => o.Id))
                        {
                            var payment = order.Payments?.FirstOrDefault();

                            string text;
                            string cls;

                            if (payment == null)
                            {
                                text = "Chưa thanh toán";
                                cls = "status-none";
                            }
                            else
                            {
                                switch (payment.Status)
                                {
                                    case "Pending":
                                        text = "Chờ xác nhận";
                                        cls = "status-pending";
                                        break;

                                    case "Shipping":
                                        text = "Đang giao hàng";
                                        cls = "status-shipping";
                                        break;

                                    case "Completed":
                                    case "Success":
                                        text = "Hoàn thành";
                                        cls = "status-success";
                                        break;

                                    case "Cancelled":
                                        text = "Đã hủy";
                                        cls = "status-cancel";
                                        break;

                                    default:
                                        text = payment.Status ?? "Chưa thanh toán";
                                        cls = "status-none";
                                        break;
                                }
                            }

                            <tr>
                                <td class="fw-semibold">#@order.Id</td>
                                <td>@order.ApplicationUser?.HoTen</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-danger fw-bold">
                                    @String.Format("{0:N0} đ", order.TotalPrice)
                                </td>
                                <td>
                                    <span class="status-pill @cls">@text</span>
                                </td>
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-primary">
                                        Xem
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>

    </div>
</div>

@{
    ViewData["Title"] = "Thống kê cửa hàng";
    var labels = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChartLabels);
    var values = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChartValues);
}

<div class="container py-5">
    <h2 class="text-center text-danger fw-bold mb-5">📊 Thống kê tổng quan</h2>

    <!-- Tổng quan -->
    <div class="row g-4 text-center mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Tổng đơn hàng</h6>
                    <h3 class="fw-bold text-primary">@ViewBag.TotalOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Doanh thu</h6>
                    <h3 class="fw-bold text-success">@String.Format("{0:N0} đ", ViewBag.TotalRevenue)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Người dùng</h6>
                    <h3 class="fw-bold text-danger">@ViewBag.TotalUsers</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Bộ lọc thời gian -->
    <div class="d-flex justify-content-end mb-4">
        <form method="get" asp-action="Dashboard" class="d-flex gap-2">
            <select name="filter" class="form-select" onchange="this.form.submit()" style="width:180px;">
                @if (ViewBag.Filter == "day")
                {
                    <option value="day" selected>Theo ngày</option>
                }
                else
                {
                    <option value="day">Theo ngày</option>
                }

                @if (ViewBag.Filter == "week")
                {
                    <option value="week" selected>Theo tuần</option>
                }
                else
                {
                    <option value="week">Theo tuần</option>
                }

                @if (ViewBag.Filter == "month")
                {
                    <option value="month" selected>Theo tháng</option>
                }
                else
                {
                    <option value="month">Theo tháng</option>
                }

                @if (ViewBag.Filter == "year")
                {
                    <option value="year" selected>Theo năm</option>
                }
                else
                {
                    <option value="year">Theo năm</option>
                }
            </select>

        </form>
    </div>

    <!-- Biểu đồ doanh thu -->
    <div class="card shadow-sm border-0 p-4 mb-5">
        <h5 class="text-secondary mb-3 fw-bold text-center">
            💰 Biểu đồ doanh thu theo @(
            ViewBag.Filter == "day" ? "ngày" :
            ViewBag.Filter == "week" ? "tuần" :
            ViewBag.Filter == "month" ? "tháng" : "năm")
        </h5>
        <canvas id="revenueChart" height="100"></canvas>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('revenueChart');
    const chart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(labels),
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: @Html.Raw(values),
                backgroundColor: 'rgba(220, 53, 69, 0.8)',
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    ticks: {
                        callback: function (val) {
                            return val.toLocaleString('vi-VN') + " đ";
                        }
                    },
                    beginAtZero: true
                }
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            return context.formattedValue + " đ";
                        }
                    }
                }
            }
        }
    });
</script>

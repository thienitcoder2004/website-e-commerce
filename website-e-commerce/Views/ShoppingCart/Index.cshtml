@model website_e_commerce.Models.ShoppingCart

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container mt-5">
    <h2 class="mb-4 text-center">🛒 Giỏ hàng của bạn</h2>

    @if (Model.Items.Any())
    {
        <table class="table table-bordered text-center align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Giá</th>
                    <th>Tổng</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody id="cart-body">
                @foreach (var item in Model.Items)
                {
                    <tr data-id="@item.ProductId">
                        <td>@item.Name</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary decrease-btn">−</button>
                            <span class="mx-2 quantity">@item.Quantity</span>
                            <button class="btn btn-sm btn-outline-secondary increase-btn">+</button>
                        </td>
                        <td>@String.Format("{0:N0} đ", item.Price)</td>
                        <td class="item-total">@String.Format("{0:N0} đ", item.Total)</td>
                        <td>
                            <a asp-action="RemoveFromCart" asp-route-productId="@item.ProductId"
                               class="btn btn-outline-danger btn-sm">🗑 Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end mt-3">
            <h4>Tổng cộng: <span id="cart-total" class="text-danger fw-bold">@String.Format("{0:N0} đ", Model.GetTotal())</span></h4>
            <a asp-action="Checkout" class="btn btn-success mt-3 px-4">Tiến hành thanh toán</a>
        </div>
    }
    else
    {
        <p class="text-center text-muted">Giỏ hàng của bạn đang trống.</p>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {

            $(".increase-btn").click(function () {
                const row = $(this).closest("tr");
                const productId = row.data("id");

                $.post("/ShoppingCart/IncreaseQuantityAjax", { productId }, function (res) {
                    if (res.success) {
                        row.find(".quantity").text(res.quantity);
                        row.find(".item-total").text(res.itemTotal.toLocaleString('vi-VN') + " đ");
                        $("#cart-total").text(res.total.toLocaleString('vi-VN') + " đ");
                    }
                });
            });

            // 🔽 Giảm số lượng
            $(".decrease-btn").click(function () {
                const row = $(this).closest("tr");
                const productId = row.data("id");

                $.post("/ShoppingCart/DecreaseQuantityAjax", { productId }, function (res) {
                    if (res.success) {
                        if (res.quantity > 0) {
                            row.find(".quantity").text(res.quantity);
                            row.find(".item-total").text(res.itemTotal.toLocaleString('vi-VN') + " đ");
                        } else {
                            row.fadeOut(200, function () { $(this).remove(); });
                        }
                        $("#cart-total").text(res.total.toLocaleString('vi-VN') + " đ");
                    }
                });
            });
        });
    </script>
}

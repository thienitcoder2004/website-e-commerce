@model website_e_commerce.Models.ShoppingCart

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="shoppingcart-page pb-5">

    <!-- BREADCRUMB -->
    <div class="bread-cumb py-3 bg-light border-bottom mb-4">
        <div class="container">
            <ul class="breadcrumb mb-0">
                <li class="home">
                    <a href="/" class="text-decoration-none text-dark fw-semibold">Trang chủ</a>
                    <span class="mx-2 text-muted">
                        <i class="fa-solid fa-chevron-right"></i>
                    </span>
                </li>
                <li class="fw-bold text-danger">Giỏ hàng</li>
            </ul>
        </div>
    </div>

    <!-- NỘI DUNG GIỎ HÀNG -->
    <div class="container mt-4">
        <h2 class="mb-4 text-center fw-bold text-uppercase text-danger">🛒 Giỏ hàng của bạn</h2>

        @if (Model.Items.Any())
        {
            <div class="row">

                <!-- LIST CART -->
                <div class="col-lg-8">

                    @foreach (var item in Model.Items)
                    {
                        <div class="cart-item-fpt shadow-sm rounded-4 mb-3 p-3" data-id="@item.ProductId">

                            <div class="row align-items-center">

                                <!-- ẢNH -->
                                <div class="col-3">
                                    <img src="@item.ImageUrl"
                                         class="img-fluid rounded"
                                         style="max-height:120px; object-fit:contain;" />

                                </div>

                                <!-- TÊN + GIÁ -->
                                <div class="col-5">
                                    <h6 class="fw-bold">@item.Name</h6>

                                    <div class="text-danger fw-bold fs-5">
                                        @String.Format("{0:N0} đ", item.Price)
                                    </div>
                                </div>

                                <!-- NÚT TĂNG GIẢM -->
                                <div class="col-2 text-center">
                                    <div class="qty-box d-flex justify-content-center align-items-center">
                                        <button class="btn-qty decrease-btn">−</button>
                                        <span class="mx-2 fw-bold quantity">@item.Quantity</span>
                                        <button class="btn-qty increase-btn">+</button>
                                    </div>
                                </div>

                                <!-- TỔNG + XÓA -->
                                <div class="col-2 text-end">
                                    <div class="fw-bold text-danger item-total">
                                        @String.Format("{0:N0} đ", item.Total)
                                    </div>

                                    <a asp-action="RemoveFromCart"
                                       asp-route-productId="@item.ProductId"
                                       class="text-muted small remove-item">
                                        Xóa
                                    </a>
                                </div>

                            </div>
                        </div>
                    }

                </div>

                <!-- BILL -->
                <div class="col-lg-4">
                    <div class="card p-3 shadow-sm sticky-top" style="top:80px;">
                        <h5 class="fw-bold mb-3">Thông tin thanh toán</h5>

                        <!-- MÃ GIẢM GIÁ -->
                        <form asp-action="ApplyCoupon" method="post" class="input-group mb-3">
                            <input type="text" name="code" class="form-control border-danger"
                                   placeholder="Nhập mã giảm giá..." required />
                            <button class="btn btn-danger fw-bold">Áp dụng</button>
                        </form>

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">@TempData["Success"]</div>
                        }
                        else if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger">@TempData["Error"]</div>
                        }

                        <hr />

                        <!-- TỔNG TIỀN -->
                        <div class="d-flex justify-content-between mb-3">
                            <span class="fw-semibold">Tạm tính:</span>
                            <span class="fw-bold" id="cart-total">@String.Format("{0:N0} đ", Model.GetTotal())</span>
                        </div>

                        <a asp-action="Checkout"
                           class="btn btn-danger w-100 fw-bold py-2 rounded-pill shadow">
                            Thanh toán ngay
                        </a>
                    </div>
                </div>

            </div>
        }
        else
        {
            <div class="text-center mt-5">
                <img src="/images/empty_cart.svg" alt="Empty cart" style="width: 220px;" />
                <h5 class="mt-3 text-muted">Giỏ hàng của bạn đang trống</h5>
                <a href="/" class="btn btn-outline-danger mt-3">Tiếp tục mua sắm</a>
            </div>
        }
    </div>
</div>

<!-- TOAST -->
<div id="toast" class="toast-message">✅ Giỏ hàng đã được cập nhật</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        function showToast() {
            const toast = $("#toast");
            toast.fadeIn(200);
            setTimeout(() => toast.fadeOut(400), 2000);
        }

        $(document).ready(function () {

            $(".increase-btn").click(function () {
                const row = $(this).closest(".cart-item-fpt");
                const productId = row.data("id");

                $.post("/ShoppingCart/IncreaseQuantityAjax", { productId }, function (res) {
                    if (res.success) {
                        row.find(".quantity").text(res.quantity);
                        row.find(".item-total").text(res.itemTotal.toLocaleString('vi-VN') + " đ");
                        $("#cart-total").text(res.total.toLocaleString('vi-VN') + " đ");
                        showToast();
                    }
                });
            });

            $(".decrease-btn").click(function () {
                const row = $(this).closest(".cart-item-fpt");
                const productId = row.data("id");

                $.post("/ShoppingCart/DecreaseQuantityAjax", { productId }, function (res) {
                    if (res.success) {
                        if (res.quantity > 0) {
                            row.find(".quantity").text(res.quantity);
                            row.find(".item-total").text(res.itemTotal.toLocaleString('vi-VN') + " đ");
                        } else {
                            row.fadeOut(200, function () { $(this).remove(); });
                        }

                        $("#cart-total").text(res.total.toLocaleString('vi-VN') + " đ");
                        showToast();
                    }
                });
            });

        });
    </script>

    <!-- CSS FPTSHOP STYLE -->
    <style>

        /* CARD SẢN PHẨM */
        .cart-item-fpt {
            border: 1px solid #eee;
            transition: 0.2s ease;
        }

            .cart-item-fpt:hover {
                border-color: #ff4d4f;
                background: #fff9f9;
            }

        /* NÚT TĂNG GIẢM */
        .btn-qty {
            width: 32px;
            height: 32px;
            border: 1px solid #ddd;
            border-radius: 50%;
            background: white;
            font-size: 18px;
            line-height: 20px;
        }

            .btn-qty:hover {
                background: #ff4d4f;
                color: #fff;
            }

        /* BILL */
        .card hr {
            opacity: .2;
            margin: 10px 0;
        }

        /* TOAST */
        .toast-message {
            display: none;
            position: fixed;
            bottom: 30px;
            right: 30px;
            background-color: #28a745;
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            z-index: 9999;
            font-weight: 500;
        }
    </style>
}

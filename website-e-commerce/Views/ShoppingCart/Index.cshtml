@model website_e_commerce.Models.ShoppingCart

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="shoppingcart-page pb-5">
    <!-- 🔹 Breadcrumb -->
    <div class="bread-cumb py-3 bg-light border-bottom mb-4">
        <div class="container">
            <ul class="breadcrumb mb-0">
                <li class="home">
                    <a href="/" class="text-decoration-none text-dark fw-semibold">
                        Trang chủ
                    </a>
                    <span class="mx-2 text-muted">
                        <i class="fa-solid fa-chevron-right"></i>
                    </span>
                </li>
                <li class="fw-bold text-danger">Giỏ hàng</li>
            </ul>
        </div>
    </div>

    <!-- 🔹 Nội dung giỏ hàng -->
    <div class="container mt-4">
        <h2 class="mb-4 text-center fw-bold text-uppercase text-danger">🛒 Giỏ hàng của bạn</h2>

        @if (Model.Items.Any())
        {
            <div class="table-responsive shadow-sm rounded-4">
                <table class="table align-middle text-center mb-0">
                    <thead class="table-danger text-dark">
                        <tr>
                            <th style="width: 120px;">Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá</th>
                            <th style="width:150px;">Số lượng</th>
                            <th>Tổng</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="cart-body" class="bg-white">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="cart-item-row" data-id="@item.ProductId">
                                <td>
                                    <img src="/images/product/default.png"
                                         class="img-fluid rounded shadow-sm"
                                         alt="@item.Name"
                                         style="width:100px; height:100px; object-fit:contain;" />
                                </td>
                                <td class="text-start fw-semibold">@item.Name</td>
                                <td class="text-danger fw-bold">@String.Format("{0:N0} đ", item.Price)</td>
                                <td>
                                    <div class="d-flex justify-content-center align-items-center">
                                        <button class="btn btn-sm btn-light border decrease-btn rounded-circle">−</button>
                                        <span class="mx-2 quantity fw-bold">@item.Quantity</span>
                                        <button class="btn btn-sm btn-light border increase-btn rounded-circle">+</button>
                                    </div>
                                </td>
                                <td class="item-total text-danger fw-bold">@String.Format("{0:N0} đ", item.Total)</td>
                                <td>
                                    <a asp-action="RemoveFromCart" asp-route-productId="@item.ProductId"
                                       class="btn btn-outline-danger btn-sm rounded-circle" title="Xóa sản phẩm">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-end mt-4">
                <h4 class="fw-bold">
                    Tổng cộng:

                    <form asp-action="ApplyCoupon" method="post" class="d-flex justify-content-end mt-4">
                        <input type="text" name="code" class="form-control w-auto me-2" placeholder="Nhập mã khuyến mãi..." required />
                        <button type="submit" class="btn btn-outline-danger fw-bold">Áp dụng</button>
                    </form>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success mt-3">@TempData["Success"]</div>
                    }
                    else if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger mt-3">@TempData["Error"]</div>
                    }

                    <span id="cart-total" class="text-danger">@String.Format("{0:N0} đ", Model.GetTotal())</span>
                </h4>
                <a asp-action="Checkout" class="btn btn-success mt-3 px-5 py-2 fw-bold rounded-pill shadow">
                    Thanh toán ngay
                </a>
            </div>
        }
        else
        {
            <div class="text-center mt-5">
                <img src="/images/empty_cart.svg" alt="Empty cart" style="width: 220px;" />
                <h5 class="mt-3 text-muted">Giỏ hàng của bạn đang trống</h5>
                <a href="/" class="btn btn-outline-danger mt-3">Tiếp tục mua sắm</a>
            </div>
        }
    </div>
</div>

<!-- 🔹 Toast thông báo -->
<div id="toast" class="toast-message">✅ Giỏ hàng đã được cập nhật</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // ======= Toast thông báo =======
        function showToast() {
            const toast = $("#toast");
            toast.fadeIn(200);
            setTimeout(() => toast.fadeOut(400), 2000);
        }

        // ======= Tăng / giảm số lượng =======
        $(document).ready(function () {

            $(".increase-btn").click(function () {
                const row = $(this).closest("tr");
                const productId = row.data("id");

                $.post("/ShoppingCart/IncreaseQuantityAjax", { productId }, function (res) {
                    if (res.success) {
                        row.find(".quantity").text(res.quantity);
                        row.find(".item-total").text(res.itemTotal.toLocaleString('vi-VN') + " đ");
                        $("#cart-total").text(res.total.toLocaleString('vi-VN') + " đ");
                        showToast();
                    }
                });
            });

            $(".decrease-btn").click(function () {
                const row = $(this).closest("tr");
                const productId = row.data("id");

                $.post("/ShoppingCart/DecreaseQuantityAjax", { productId }, function (res) {
                    if (res.success) {
                        if (res.quantity > 0) {
                            row.find(".quantity").text(res.quantity);
                            row.find(".item-total").text(res.itemTotal.toLocaleString('vi-VN') + " đ");
                        } else {
                            row.fadeOut(200, function () { $(this).remove(); });
                        }
                        $("#cart-total").text(res.total.toLocaleString('vi-VN') + " đ");
                        showToast();
                    }
                });
            });
        });
    </script>

    <style>
        /* ===== GIAO DIỆN CHUNG ===== */
        .breadcrumb li {
            display: inline;
            font-size: 0.95rem;
        }

        /* ===== BẢNG GIỎ HÀNG ===== */
        .table {
            border-collapse: separate;
        }

        .cart-item-row {
            transition: all 0.25s ease;
        }

        /* ===== NÚT TĂNG GIẢM ===== */
        .btn-light.border {
            width: 32px;
            height: 32px;
            line-height: 20px;
            padding: 0;
            font-size: 1.2rem;
        }

            .btn-light.border:hover {
                background-color: #ff4d4f;
                color: #fff;
            }

        /* ===== NÚT THANH TOÁN ===== */
        .btn-success {
            background-color: #28a745;
            border: none;
            transition: all 0.3s;
        }

            .btn-success:hover {
                background-color: #218838;
            }

        /* ===== NÚT XÓA ===== */
        .btn-outline-danger {
            border: 1.5px solid #dc3545;
            color: #dc3545;
        }

            .btn-outline-danger:hover {
                background-color: #dc3545;
                color: white;
            }

        /* ===== TOAST THÔNG BÁO ===== */
        .toast-message {
            display: none;
            position: fixed;
            bottom: 30px;
            right: 30px;
            background-color: #28a745;
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            z-index: 9999;
            font-weight: 500;
        }

        /* ===== ẢNH GIỎ HÀNG TRỐNG ===== */
        .empty-cart {
            width: 220px;
        }
    </style>
}

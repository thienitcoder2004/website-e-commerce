@model IEnumerable<website_e_commerce.Models.Contact>

@{
    ViewData["Title"] = "Quản lý liên hệ";
    int totalContacts = Model?.Count() ?? 0;
}

<style>
    .contact-page-wrapper {
        background: radial-gradient(circle at top left, #eef2ff, #ffffff);
        border-radius: 18px;
        padding: 28px 24px;
        margin-top: 20px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
    }

    .contact-title {
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        font-size: 18px;
    }

    .contact-subtitle {
        font-size: 13px;
        color: #6b7280;
    }

    .contact-badge-summary {
        font-size: 13px;
        padding: 6px 14px;
        border-radius: 999px;
        background: #f9fafb;
        color: #4b5563;
        border: 1px solid #e5e7eb;
    }

    .btn-contact-add {
        border-radius: 999px;
        font-size: 14px;
        padding: 8px 18px;
    }

    .contact-table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.08);
    }

    .table thead th {
        background: #0d6efd;
        color: white;
        border-bottom: none;
        font-size: 14px;
        text-transform: uppercase;
    }

    .table tbody tr:hover {
        background: #f3f4ff;
    }

    /* ==========================
       TOAST - GÓC PHẢI TRÊN
    ========================== */
    #toastNotif {
        position: fixed;
        top: 25px;
        right: 25px;
        background: linear-gradient(135deg, #28a745, #42d67c);
        padding: 14px 26px;
        border-radius: 10px;
        color: white;
        font-weight: 600;
        opacity: 0;
        transform: translateY(-20px);
        transition: all .4s ease;
        z-index: 9999;
        pointer-events: none;
    }

        #toastNotif.show {
            opacity: 1;
            transform: translateY(0);
        }


    @@media(max-width: 768px) {
        .contact-page-wrapper { padding: 20px 16px; border-radius: 12px; }
        .table-responsive { font-size: 13px; }
    }
</style>

<div class="container">
    <div class="contact-page-wrapper">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="contact-title text-primary mb-1">📬 Quản lý liên hệ</h2>
                <p class="contact-subtitle mb-0">Theo dõi và xử lý các yêu cầu được gửi từ khách hàng.</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="contact-badge-summary">
                    <i class="fa-solid fa-envelope-open-text me-1"></i>
                    Tổng liên hệ: <strong>@totalContacts</strong>
                </span>
            </div>
        </div>

        <!-- ALERT cũ (bạn muốn bỏ thì nói mình) -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- TABLE -->
        <div class="contact-table-wrapper">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead>
                        <tr>
                            <th style="width:60px;">ID</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th class="text-start">Nội dung</th>
                            <th>Ngày gửi</th>
                            <th style="width:160px;">Hành động</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var contact in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@contact.Id</td>
                                    <td>@contact.FullName</td>
                                    <td>@contact.Email</td>
                                    <td>@contact.Phone</td>
                                    <td class="text-start">@contact.Message</td>
                                    <td>@contact.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="Edit" asp-route-id="@contact.Id"
                                               class="btn btn-sm btn-warning">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>

                                            <a asp-action="Details" asp-route-id="@contact.Id"
                                               class="btn btn-sm btn-info">
                                                <i class="fa-solid fa-circle-info"></i>
                                            </a>

                                            <form asp-action="DeleteConfirmed" asp-route-id="@contact.Id" method="post"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa liên hệ này?');">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="py-4 text-muted fst-italic">Không có liên hệ nào.</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>

        <!-- PAGINATION -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">Trước</a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        }

    </div>
</div>

<!-- TOAST -->
<div id="toastNotif">
    <span id="toastMessage"></span>
</div>

@section Scripts {

    <script>
        // =========================
        // TOAST FUNCTION
        // =========================
        function showToast(message) {
            const toast = document.getElementById("toastNotif");
            const msg = document.getElementById("toastMessage");

            msg.innerText = message;
            toast.classList.add("show");

            setTimeout(() => toast.classList.remove("show"), 2500);
        }

        // =========================
        // SHOW FROM TempData
        // =========================
        @if (TempData["Success"] != null)
        {
            <text>
                showToast(@Json.Serialize(TempData["Success"]));
            </text>
        }

        @if (TempData["Error"] != null)
        {
            <text>
                showToast(@Json.Serialize(TempData["Error"]));
            </text>
        }
    </script>

}

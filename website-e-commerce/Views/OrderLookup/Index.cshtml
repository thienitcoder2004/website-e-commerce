@model website_e_commerce.Models.ViewModels.OrderLookupViewModel

@{
    ViewData["Title"] = "Tra cứu đơn hàng";
}

@functions {
    string GetStatusText(string status)
    {
        return status switch
        {
            "Pending" => "Chờ xác nhận",
            "Packing" => "Đang chuẩn bị hàng",
            "Shipping" => "Đang giao hàng",
            "Completed" => "Đã giao thành công",
            "Cancelled" => "Đã hủy",
            _ => status
        };
    }
}

<style>
    /* =========================================================
       PHONG CÁCH TỔNG – GIỐNG THE GRAND HỒ TRÀM
       ========================================================= */
    .lux-title {
        font-size: 32px;
        font-weight: 700;
        text-align: center;
        margin-bottom: 25px;
        color: #1a1a1a;
        letter-spacing: 1px;
    }

    .lux-form {
        background: #ffffff;
        padding: 30px;
        border-radius: 18px;
        border: 1px solid #ececec;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .lux-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 6px;
    }

    .lux-input {
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px solid #ccc;
    }

    .lux-btn {
        background: #c70404;
        border: none;
        width: 100%;
        padding: 13px;
        font-size: 17px;
        border-radius: 12px;
        color: white;
        font-weight: 600;
        transition: 0.2s;
    }

    .lux-btn:hover {
        background: #a70202;
    }

    /* =========================================================
       CARD THÔNG TIN ĐƠN HÀNG – SANG TRỌNG
       ========================================================= */
    .lux-card {
        background: white;
        padding: 25px;
        border-radius: 18px;
        border: 1px solid #e8e8e8;
        box-shadow: 0 4px 18px rgba(0,0,0,0.05);
        margin-top: 25px;
    }

    .lux-section-title {
        font-weight: 700;
        font-size: 20px;
        margin-bottom: 15px;
        color: #333;
    }

    /* =========================================================
       TRACKING – DẠNG DỌC CAO CẤP
       ========================================================= */
    .tracking-vertical {
        margin-top: 20px;
        border-left: 3px solid #e0e0e0;
        padding-left: 20px;
    }

    .track-item {
        position: relative;
        margin-bottom: 25px;
    }

    .track-icon {
        position: absolute;
        left: -35px;
        top: 0;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        color: white;
    }

    .track-item.done .track-icon {
        background: #28a745;
        box-shadow: 0 0 8px rgba(40,167,69,0.4);
    }

    .track-item.cancelled .track-icon {
        background: #dc3545;
        box-shadow: 0 0 8px rgba(220,53,69,0.4);
    }

    .track-label {
        font-size: 16px;
        font-weight: 600;
        color: #333;
    }

    .track-desc {
        font-size: 14px;
        color: #777;
    }

    .badge-status {
        padding: 7px 14px;
        border-radius: 12px;
        font-size: 14px;
    }
</style>

<div class="container mt-5 mb-5" style="max-width: 900px;">

    <h2 class="lux-title">Tra cứu đơn hàng của bạn</h2>

    <!-- ================= FORM ================= -->
    <div class="lux-form">

        <form asp-action="Index" method="post">
            <label class="lux-label">Mã đơn hàng</label>
            <input asp-for="OrderCode" class="form-control lux-input mb-3"
                   placeholder="VD: A1B2C3D4E5" />

            <label class="lux-label">Số điện thoại hoặc Email</label>
            <input asp-for="PhoneOrEmail" class="form-control lux-input mb-3"
                   placeholder="Thông tin đã sử dụng khi đặt hàng" />

            <button type="submit" class="lux-btn">
                Tra cứu ngay
            </button>
        </form>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-warning mt-3">@Model.Message</div>
        }

    </div>


    <!-- ================= HIỂN THỊ ĐƠN HÀNG ================= -->
    @if (Model.Order != null)
    {
        var o = Model.Order;

        <div class="lux-card">

            <h4 class="lux-section-title">Thông tin đơn hàng</h4>

            <p><strong>Mã đơn hàng: </strong>@o.OrderCode</p>
            <p><strong>Ngày đặt: </strong>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p>
                <strong>Trạng thái: </strong>
                <span class="badge bg-info badge-status" id="order-status">
                    @GetStatusText(o.OrderStatus)
                </span>
            </p>
            <p><strong>Tổng tiền: </strong>@o.TotalPrice.ToString("N0") đ</p>
            <p><strong>Địa chỉ giao hàng: </strong>@o.ShippingAddress</p>
            <p><strong>Ghi chú: </strong>@o.Notes</p>

            <hr />

            <h4 class="lux-section-title">Sản phẩm trong đơn</h4>

            <table class="table table-bordered table-sm mt-2">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in o.OrderDetails)
                    {
                        var lineTotal = item.Quantity * item.Price;
                        <tr>
                            <td>@item.Product?.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("N0") đ</td>
                            <td>@lineTotal.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
            </table>

            <hr />

            <!-- ================= TRACKING DỌC ================= -->
            <h4 class="lux-section-title">Tiến trình đơn hàng</h4>

            <div class="tracking-vertical">

                <div id="step1" class="track-item">
                    <div class="track-icon"><i class="fa-solid fa-check"></i></div>
                    <div class="track-label">Đặt hàng thành công</div>
                </div>

                <div id="step2" class="track-item">
                    <div class="track-icon"><i class="fa-solid fa-box-open"></i></div>
                    <div class="track-label">Đang chuẩn bị hàng</div>
                </div>

                <div id="step3" class="track-item">
                    <div class="track-icon"><i class="fa-solid fa-truck"></i></div>
                    <div class="track-label">Đang giao hàng</div>
                </div>

                <div id="step4" class="track-item">
                    <div class="track-icon"><i class="fa-solid fa-check-double"></i></div>
                    <div class="track-label">Giao hàng thành công</div>
                </div>

            </div>

        </div>
    }
</div>

<!-- ================= SIGNALR ================= -->
@if (Model.Order != null)
{
<script>
    function updateSteps(status) {
        let steps = ["step1", "step2", "step3", "step4"];

        steps.forEach(id => {
            document.getElementById(id).classList.remove("done", "cancelled");
        });

        switch (status) {
            case "Pending":
                step1.classList.add("done");
                break;

            case "Packing":
                step1.classList.add("done");
                step2.classList.add("done");
                break;

            case "Shipping":
                step1.classList.add("done");
                step2.classList.add("done");
                step3.classList.add("done");
                break;

            case "Completed":
                steps.forEach(x => document.getElementById(x).classList.add("done"));
                break;

            case "Cancelled":
                steps.forEach(x => document.getElementById(x).classList.add("cancelled"));
                break;
        }
    }

    updateSteps("@Model.Order.OrderStatus");
</script>
}

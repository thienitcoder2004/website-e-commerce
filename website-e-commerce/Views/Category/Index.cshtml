@model IEnumerable<website_e_commerce.Models.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
    int totalCategories = Model?.Count() ?? 0;
}

<style>
    .category-page-wrapper {
        background: radial-gradient(circle at top left, #eef2ff, #ffffff);
        border-radius: 18px;
        padding: 28px 24px;
        margin-top: 20px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
    }

    .category-title {
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        font-size: 18px;
    }

    .category-subtitle {
        font-size: 13px;
        color: #6b7280;
    }

    .category-badge-summary {
        font-size: 13px;
        padding: 6px 14px;
        border-radius: 999px;
        background: #f9fafb;
        color: #4b5563;
        border: 1px solid #e5e7eb;
    }

    .btn-category-add {
        border-radius: 999px;
        font-size: 14px;
        padding: 8px 18px;
    }

    .category-table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.08);
    }

    .table thead th {
        background: #0d6efd;
        color: white;
        border-bottom: none;
        font-size: 14px;
    }

    .table tbody tr:hover {
        background: #f3f4ff;
    }

    @@media(max-width: 768px) {
        .category-page-wrapper { padding: 20px 16px; border-radius: 12px; }
        .table-responsive { font-size: 13px; }
    }
</style>

<div class="container">
    <div class="category-page-wrapper">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="category-title text-primary mb-1">
                    📂 Quản lý danh mục
                </h2>
                <p class="category-subtitle mb-0">
                    Quản lý và điều chỉnh danh mục sản phẩm trong cửa hàng của bạn.
                </p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="category-badge-summary">
                    <i class="fa-solid fa-layer-group me-1"></i>
                    Tổng danh mục: <strong>@totalCategories</strong>
                </span>

                <a asp-action="Add" class="btn btn-success btn-category-add">
                    <i class="fa-solid fa-plus"></i> Thêm danh mục
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Bảng -->
        <div class="category-table-wrapper">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead>
                        <tr>
                            <th style="width:80px;">Mã</th>
                            <th>Tên danh mục</th>
                            <th style="width:180px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var category in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@category.Id</td>
                                    <td class="fw-semibold text-start ps-4">@category.Name</td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-1">

                                            <a asp-action="Details" asp-route-id="@category.Id"
                                               class="btn btn-sm btn-info">
                                                <i class="fa-solid fa-circle-info"></i>
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@category.Id"
                                               class="btn btn-sm btn-warning">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@category.Id"
                                               class="btn btn-sm btn-danger"
                                               onclick="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="py-4 text-muted">Không có danh mục nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Phân trang -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">Trước</a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

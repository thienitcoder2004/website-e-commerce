@model IEnumerable<website_e_commerce.Models.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="container mt-5">
    <h2 class="text-center text-primary mb-4">📂 Danh sách danh mục</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3 text-end">
        <a asp-action="Add" class="btn btn-success">
            <i class="fa-solid fa-plus"></i> Thêm danh mục
        </a>
    </div>

    <table class="table table-bordered table-hover align-middle shadow-sm">
        <thead class="table-primary text-center">
            <tr>
                <th style="width:80px;">ID</th>
                <th>Tên danh mục</th>
                <th style="width:180px;">Hành động</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @if (Model != null && Model.Any())
            {
                foreach (var category in Model)
                {
                    <tr>
                        <td>@category.Id</td>
                        <td class="fw-semibold">@category.Name</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@category.Id"
                               class="btn btn-sm btn-info me-1">
                                <i class="fa-solid fa-circle-info"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@category.Id"
                               class="btn btn-sm btn-warning me-1">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@category.Id"
                               class="btn btn-sm btn-danger">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">Không có danh mục nào.</td>
                </tr>
            }
        </tbody>
    </table>

    @if (ViewBag.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">Trước</a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>

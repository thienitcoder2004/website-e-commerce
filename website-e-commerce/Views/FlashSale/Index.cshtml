@model List<FlashSale>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-danger">
        <i class="fa-solid fa-bolt"></i> Quản lý Flash Sale
    </h2>

    <a href="/FlashSale/Add" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Tạo Flash Sale
    </a>
</div>

<table class="table table-hover table-bordered align-middle text-center shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>STT</th>
            <th>Sản phẩm</th>
            <th>Giá Flash</th>
            <th>Tồn kho</th>
            <th>Đã bán</th>
            <th>Bắt đầu</th>
            <th>Kết thúc</th>
            <th>Trạng thái</th>
            <th style="width:160px">Hành động</th>
        </tr>
    </thead>

    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="9" class="text-muted py-4">
                    <i class="fa-solid fa-circle-exclamation"></i> Chưa có Flash Sale nào
                </td>
            </tr>
        }
        else
        {
            @for (int i = 0; i < Model.Count; i++)
            {
                var fs = Model[i];

                bool ended = DateTime.Now > fs.EndTime;
                bool soon = DateTime.Now < fs.StartTime;
                bool active = !ended && !soon;

                <tr class="@(active ? "table-warning" : "")">
                    <td>@(i + 1)</td>

                    <td class="text-start">
                        <b>@fs.Product?.Name</b> <br />
                        <span class="text-muted small">ID: @fs.ProductId</span>
                    </td>

                    <td class="text-danger fw-bold">
                        @fs.FlashPrice.ToString("N0") đ
                    </td>

                    <td>@fs.FlashQuantity</td>
                    <td>@fs.SoldQuantity</td>

                    <td>@fs.StartTime.ToString("HH:mm dd/MM/yyyy")</td>
                    <td>@fs.EndTime.ToString("HH:mm dd/MM/yyyy")</td>

                    <td>
                        @if (ended)
                        {
                            <span class="badge bg-danger px-3 py-2"><i class="fa-solid fa-xmark"></i> Hết hạn</span>
                        }
                        else if (soon)
                        {
                            <span class="badge bg-info px-3 py-2"><i class="fa-solid fa-clock"></i> Sắp diễn ra</span>
                        }
                        else
                        {
                            <span class="badge bg-success px-3 py-2"><i class="fa-solid fa-bolt"></i> Đang diễn ra</span>
                        }
                    </td>

                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/FlashSale/Edit/@fs.Id">
                            <i class="fa-solid fa-pen-to-square"></i> Sửa
                        </a>

                        <a class="btn btn-danger btn-sm"
                           href="/FlashSale/Delete/@fs.Id"
                           onclick="return confirm('Bạn có chắc muốn xóa Flash Sale này?')">
                            <i class="fa-solid fa-trash"></i> Xóa
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@using Microsoft.AspNetCore.Identity
@using website_e_commerce.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="d-flex justify-content-center align-items-center gap-3">
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        <li>
            <i class="fas fa-user"></i>
            <a id="manage" class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                Hello @(currentUser?.HoTen ?? currentUser?.UserName)!
            </a>
        </li>
        <li>
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">
                    Đăng xuất
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <i class="fas fa-user"></i>
            <a class="nav-link" id="login" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
        </li>
    }
</ul>

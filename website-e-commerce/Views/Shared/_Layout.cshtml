    <!-- 💬 Chatbot floating button -->
    <button id="chatbotBtn" class="chatbot-btn">
        <i class="fa-solid fa-robot fa-xl"></i>
    </button>

    <div id="chatbotBox" class="chatbot-box">
        <div class="chatbot-header d-flex justify-content-between align-items-center">
            <span>🤖 Trợ lý HTM Shop</span>
            <button id="resetChat" title="Xóa lịch sử chat" class="btn btn-sm btn-outline-danger py-0 px-2">
                <i class="fa-solid fa-rotate-right"></i> Reset
            </button>
        </div>

        <div id="chatMessages" class="chatbot-messages"></div>

        <div class="chatbot-input">
            <input type="text" id="chatInput" placeholder="Nhập tin nhắn..." />
            <button id="sendBtn"><i class="fa-solid fa-paper-plane"></i></button>
        </div>
    </div>

    <!-- 💬 Script xử lý chatbot -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.getElementById("chatbotBtn");
            const box = document.getElementById("chatbotBox");
            const input = document.getElementById("chatInput");
            const sendBtn = document.getElementById("sendBtn");
            const messages = document.getElementById("chatMessages");
            const resetBtn = document.getElementById("resetChat"); // ⬅️ Nút Reset

            // 🧠 1️⃣ KHÔI PHỤC LỊCH SỬ CHAT
            let savedHistory = localStorage.getItem("chatHistory");
            if (savedHistory && savedHistory.trim() !== "") {
                messages.innerHTML = savedHistory;
                console.log("✅ Đã khôi phục lịch sử chat");
            } else {
                const hello = `<div class="bot"><b>🤖 Bot:</b> Xin chào! Mình là trợ lý HTM Shop, bạn cần hỗ trợ gì không?</div>`;
                messages.innerHTML = hello;
                localStorage.setItem("chatHistory", hello);
                console.log("🚀 Tạo lời chào đầu tiên");
            }
            messages.scrollTop = messages.scrollHeight;

            // 💬 2️⃣ NÚT MỞ / ẨN CHAT
            btn.addEventListener("click", () => {
                box.style.display = box.style.display === "flex" ? "none" : "flex";
            });

            // ✉️ 3️⃣ GỬI TIN NHẮN
            sendBtn.addEventListener("click", sendMessage);
            input.addEventListener("keypress", (e) => { if (e.key === "Enter") sendMessage(); });

            function appendMessage(sender, text) {
                const div = document.createElement("div");
                div.className = sender;
                div.innerHTML = `<b>${sender === "user" ? "Bạn" : "🤖 Bot"}:</b> ${text}`;
                messages.appendChild(div);
                messages.scrollTop = messages.scrollHeight;
                localStorage.setItem("chatHistory", messages.innerHTML);
            }

            function sendMessage() {
                const text = input.value.trim();
                if (!text) return;

                appendMessage("user", text);
                input.value = "";

                const typing = document.createElement("div");
                typing.className = "bot";
                typing.textContent = "🤖 Bot đang gõ...";
                messages.appendChild(typing);
                messages.scrollTop = messages.scrollHeight;

                const formData = new FormData();
                formData.append("message", text);

                fetch("/chat/send", { method: "POST", body: formData })
                    .then(res => res.json())
                    .then(data => {
                        typing.remove();
                        appendMessage("bot", data.reply);
                    })
                    .catch(() => {
                        typing.remove();
                        appendMessage("bot", "⚠️ Không thể kết nối đến server!");
                    });
            }

            // 🔁 4️⃣ ĐỒNG BỘ GIỮA CÁC TAB
            window.addEventListener("storage", e => {
                if (e.key === "chatHistory") {
                    messages.innerHTML = e.newValue;
                    messages.scrollTop = messages.scrollHeight;
                }
            });

            // 🧷 5️⃣ TRƯỚC KHI ĐÓNG TRÌNH DUYỆT — LUÔN LƯU LẠI
            window.addEventListener("beforeunload", () => {
                localStorage.setItem("chatHistory", messages.innerHTML);
            });

            // 🔄 6️⃣ NÚT RESET CHAT
            resetBtn.addEventListener("click", function () {
                if (confirm("Bạn có chắc muốn xóa toàn bộ nội dung chat không?")) {
                    const hello = `<div class="bot"><b>🤖 Bot:</b> Xin chào! Mình là trợ lý HTM Shop, bạn cần hỗ trợ gì không?</div>`;
                    messages.innerHTML = hello;
                    localStorage.setItem("chatHistory", hello);
                    messages.scrollTop = messages.scrollHeight;
                    console.log("🧹 Đã reset toàn bộ lịch sử chat!");
                }
            });
        });
    </script>



    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            let searchBox = $('.search-auto');
            let suggestionBox = $('<div class="suggestion-box shadow-lg"></div>');
            suggestionBox.css({
                position: 'absolute',
                top: '100%',
                left: 0,
                width: '100%',
                zIndex: 9999,
                display: 'none'
            });
            searchBox.parent().css('position', 'relative');
            searchBox.after(suggestionBox);

            searchBox.on('keyup', function () {
                let term = $(this).val().trim();
                if (term.length < 1) {
                    suggestionBox.hide();
                    return;
                }

                $.getJSON('/Product/SearchSuggestions', { term: term }, function (data) {
                    suggestionBox.empty();

                    if (data.length > 0) {
                        data.forEach(item => {
                            let html = `
                            <a href="/Product/Details/${item.id}" class="suggestion-item d-flex justify-content-between align-items-center">
                                <div class="suggestion-info">
                                    <div class="product-name">${item.name}</div>
                                    <div class="product-prices">
                                        <span class="new-price">${item.newPrice.toLocaleString()}đ</span>
                                        ${item.oldPrice > 0 ? `<span class="old-price">${item.oldPrice.toLocaleString()}đ</span>` : ''}
                                    </div>
                                </div>
                                <img src="${item.imageUrl}" alt="${item.name}" class="suggestion-img">
                            </a>`;
                            suggestionBox.append(html);
                        });
                        suggestionBox.show();
                    } else {
                        suggestionBox.hide();
                    }
                });
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('.search-auto, .suggestion-box').length) {
                    suggestionBox.hide();
                }
            });
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/chatbot.js"></script>
    <script>
        const newsPopup = document.getElementById("newsPopup");
        const newsToggle = document.getElementById("newsToggle");
        const newsWrapper = document.getElementById("newsWrapper");
        const newsCount = document.getElementById("newsCount");
        const newsList = document.getElementById("newsList");
        const bellIcon = document.getElementById("bellIcon");

        newsToggle.addEventListener("click", () => {
            const visible = newsPopup.style.display === "block";
            newsPopup.style.display = visible ? "none" : "block";
            if (!visible) loadLatestNews();
        });

        document.addEventListener("click", (e) => {
            if (!newsWrapper.contains(e.target)) {
                newsPopup.style.display = "none";
            }
        });

        // 🔄 Hàm load tin tức
        function loadLatestNews() {
            fetch("/News/GetLatest")
                .then(res => res.json())
                .then(data => {
                    newsList.innerHTML = "";
                    if (data.length === 0) {
                        newsList.innerHTML = `<li class="list-group-item text-center text-muted">Không có tin mới</li>`;
                    } else {
                        data.forEach(n => {
                            newsList.innerHTML += `
                                <li class="list-group-item">
                                    <a href="/News/Detail/${n.id}" class="text-decoration-none text-dark d-block">
                                        <div class="fw-semibold">${n.title}</div>
                                        <small class="text-muted">${n.publishedDate}</small>
                                    </a>
                                </li>`;
                        });
                    }
                    newsCount.innerText = data.length;
                })
                .catch(() => {
                    newsList.innerHTML = `<li class="list-group-item text-center text-danger">Lỗi tải dữ liệu</li>`;
                });
        }

        // 🕒 Auto reload mỗi 30s
        setInterval(loadLatestNews, 30000);
        loadLatestNews();

        // 🔔 Kết nối SignalR
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/newsHub")
            .build();

        // Khi nhận tin mới từ server
        connection.on("ReceiveNews", (title) => {
            // Rung chuông
            bellIcon.classList.add("ring");
            setTimeout(() => bellIcon.classList.remove("ring"), 2000);

            // Cập nhật danh sách tin mới nhất
            loadLatestNews();

            // Hiển thị thông báo nhỏ
            const toast = document.createElement("div");
            toast.className = "position-fixed top-0 end-0 p-3";
            toast.innerHTML = `
                <div class="toast align-items-center text-bg-primary border-0 show" style="z-index:2000">
                    <div class="d-flex">
                        <div class="toast-body">
                            📰 Tin mới: <strong>${title}</strong>
                        </div>
                    </div>
                </div>`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        });

        connection.start().catch(err => console.error(err.toString()));
    </script>


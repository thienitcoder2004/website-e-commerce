                            <a href="https://www.sapo.vn/?utm_campaign=cpn:kho_theme-plm:footer&amp;utm_source=Tu_nhien&amp;utm_medium=referral&amp;utm_content=fm:text_link-km:-sz:&amp;utm_term=&amp;campaign=kho_theme-sapo" rel="noopener" title="Sapo" target="_blank">Gear 5</a>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- 💬 Chatbot floating button (AI – Gemini) -->
    <button id="chatbotBtn" class="chatbot-btn">
        <i class="fa-solid fa-robot fa-xl"></i>
    </button>

    <div id="chatbotBox" class="chatbot-box">
        <div class="chatbot-header d-flex justify-content-between align-items-center">
            <span>🤖 Trợ lý HTM Shop</span>
            <button id="resetChat" title="Xóa lịch sử chat" class="btn btn-sm btn-outline-danger py-0 px-2">
                <i class="fa-solid fa-rotate-right"></i>
            </button>
        </div>

        <div id="chatMessages" class="chatbot-messages"></div>

        <div class="chatbot-input">
            <input type="text" id="chatInput" placeholder="Nhập tin nhắn..." />
            <button id="sendBtn"><i class="fa-solid fa-paper-plane"></i></button>
        </div>
    </div>

    <!-- 💬 Chat hỗ trợ người thật (Support Chat) -->
    <div id="supportChatBtn"
         style="position:fixed; bottom:90px; right:30px; z-index:999999;">
        <button style="width:55px;height:55px;border-radius:50%;background:#1A3B79;color:white;border:none;">
            <i class="fa-solid fa-comments"></i>
        </button>
    </div>

    <div id="supportChatBox"
         style="display:none; position:fixed; bottom:150px; right:25px; width:330px; height:480px;
                background:#fff; border-radius:15px; box-shadow:0 0 10px rgba(0,0,0,0.2); z-index:999999;">
        <div style="padding:12px; background:#1A3B79; color:white;">Hỗ trợ khách hàng</div>

        <div id="supportMessages" style="height:350px; overflow-y:auto; padding:10px;">
            <p><b>HTM Shop:</b> Xin chào! Bạn cần hỗ trợ gì?</p>
        </div>

        <div style="padding:10px; display:flex;">
            <input id="supportInput" class="form-control" placeholder="Nhập tin..." autocomplete="off" />
            <button id="supportSend" class="btn btn-primary" style="margin-left:8px;">
                <i class="fa fa-paper-plane"></i>
            </button>
        </div>
    </div>

    <!-- SignalR (dùng chung cho SupportChat + NewsHub, v.v.) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // ================== 0. Toggle 2 popup – không đè nhau ==================
                  const loggedUser = "@loggedUserId";       // User ID hoặc ""
        const loggedUserName = "@loggedUserName"; // Tên người dùng
        const defaultReceiver = "@receiver";      // Nhân viên hỗ trợ

            const chatbotBtn = document.getElementById("chatbotBtn");
            const chatbotBox = document.getElementById("chatbotBox");

            const supportBtn = document.getElementById("supportChatBtn");
            const supportBox = document.getElementById("supportChatBox");

            if (chatbotBox) chatbotBox.style.display = "none";
            if (supportBox) supportBox.style.display = "none";

            if (chatbotBtn) {
                chatbotBtn.addEventListener("click", () => {
                    if (!chatbotBox) return;

                    const isOpen = chatbotBox.style.display === "flex";
                    chatbotBox.style.display = isOpen ? "none" : "flex";

                    // mở chatbot → tắt support chat
                    if (!isOpen && supportBox) supportBox.style.display = "none";
                });
            }

            if (supportBtn) {
                supportBtn.addEventListener("click", () => {
                    if (!supportBox) return;

                    const isOpen = supportBox.style.display === "block";
                    supportBox.style.display = isOpen ? "none" : "block";

                    // mở support chat → tắt chatbot
                    if (!isOpen && chatbotBox) chatbotBox.style.display = "none";
                });
            }

            // ================== 1. CHATBOT AI – gọi /chat/send ==================
            const botInput = document.getElementById("chatInput");
            const botSendBtn = document.getElementById("sendBtn");
            const botMessages = document.getElementById("chatMessages");
            const resetBtn = document.getElementById("resetChat");

            if (botMessages) {
                // 1.1 Khôi phục lịch sử chat
                let savedHistory = localStorage.getItem("chatHistory");
                if (savedHistory && savedHistory.trim() !== "") {
                    botMessages.innerHTML = savedHistory;
                } else {
                    const hello = `<div class="bot"><b>🤖 Bot:</b> Xin chào! Mình là trợ lý HTM Shop, bạn cần hỗ trợ gì không?</div>`;
                    botMessages.innerHTML = hello;
                    localStorage.setItem("chatHistory", hello);
                }
                botMessages.scrollTop = botMessages.scrollHeight;

                // 1.2 Gửi tin nhắn
                function appendBotMessage(sender, text) {
                    const div = document.createElement("div");
                    div.className = sender;
                    div.innerHTML = `<b>${sender === "user" ? "Bạn" : "🤖 Bot"}:</b> ${text}`;
                    botMessages.appendChild(div);
                    botMessages.scrollTop = botMessages.scrollHeight;
                    localStorage.setItem("chatHistory", botMessages.innerHTML);
                }

                function sendBotMessage() {
                    const text = botInput.value.trim();
                    if (!text) return;

                    appendBotMessage("user", text);
                    botInput.value = "";

                    const typing = document.createElement("div");
                    typing.className = "bot";
                    typing.textContent = "🤖 Bot đang gõ...";
                    botMessages.appendChild(typing);
                    botMessages.scrollTop = botMessages.scrollHeight;

                    const formData = new FormData();
                    formData.append("message", text);

                    fetch("/chat/send", { method: "POST", body: formData })
                        .then(res => res.json())
                        .then(data => {
                            typing.remove();
                            appendBotMessage("bot", data.reply);
                        })
                        .catch(() => {
                            typing.remove();
                            appendBotMessage("bot", "⚠️ Không thể kết nối đến server!");
                        });
                }

                if (botSendBtn) botSendBtn.addEventListener("click", sendBotMessage);
                if (botInput) {
                    botInput.addEventListener("keypress", e => {
                        if (e.key === "Enter") sendBotMessage();
                    });
                }

                // 1.3 Đồng bộ giữa các tab
                window.addEventListener("storage", e => {
                    if (e.key === "chatHistory") {
                        botMessages.innerHTML = e.newValue;
                        botMessages.scrollTop = botMessages.scrollHeight;
                    }
                });

                // 1.4 Reset chat
                if (resetBtn) {
                    resetBtn.addEventListener("click", () => {
                        if (!confirm("Bạn có chắc muốn xóa toàn bộ nội dung chat không?")) return;
                        const hello = `<div class="bot"><b>🤖 Bot:</b> Xin chào! Mình là trợ lý HTM Shop, bạn cần hỗ trợ gì không?</div>`;
                        botMessages.innerHTML = hello;
                        localStorage.setItem("chatHistory", hello);
                        botMessages.scrollTop = botMessages.scrollHeight;
                    });
                }
            }

            // ================== 2. SUPPORT CHAT – khách ↔ nhân viên ==================

                           const supportInput = document.getElementById("supportInput");
        const supportSendBtn = document.getElementById("supportSend");
        const supportMessages = document.getElementById("supportMessages");

        if (supportInput && supportSendBtn && supportMessages) {

            let hub = new signalR.HubConnectionBuilder()
                .withUrl("/supportChatHub")
                .build();

            hub.start();


            // ====================================================
            // 1. NHẬN TIN NHẮN
            // ====================================================
            hub.on("ReceiveSupportMessage",
                function (convId, senderId, receiverId, content) {

                    let myRealId = loggedUser || sessionStorage.getItem("guestId");

                    // CHỈ nhận khi ADMIN gửi đúng cho mình
                    if (receiverId === myRealId && senderId !== myRealId) {
                        addSupportMessage(content, false);
                    }
                }
            );


            // ====================================================
            // 2. SHOW TIN NHẮN
            // ====================================================
            function addSupportMessage(text, isMe) {
                let p = document.createElement("p");
                p.style.textAlign = isMe ? "right" : "left";
                p.innerHTML = `<b>${isMe ? loggedUserName : "HTM"}:</b> ${text}`;
                supportMessages.appendChild(p);
                supportMessages.scrollTop = supportMessages.scrollHeight;
            }


            // ====================================================
            // 3. GỬI TIN NHẮN
            // ====================================================
            function sendSupport() {
                let text = supportInput.value.trim();
                if (!text) return;

                addSupportMessage(text, true);
                supportInput.value = "";

                fetch("/SupportChat/Send", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        receiverId: defaultReceiver,
                        content: text,
                        conversationId: null
                    })
                })
                .then(res => res.json())
                .then(data => {

                    // Lưu guestId thật trả về từ server
                    if (!loggedUser) {
                        sessionStorage.setItem("guestId", data.senderId);
                    }

                    let myRealId = loggedUser || data.senderId;

                    hub.invoke("SendToAll",
                        data.conversationId,
                        myRealId,
                        defaultReceiver,
                        text
                    );
                });
            }


            supportSendBtn.addEventListener("click", sendSupport);
            supportInput.addEventListener("keypress", e => {
                if (e.key === "Enter") sendSupport();
            });
        }

               
        });

        // Loader
        window.addEventListener("load", function () {
            const loader = document.getElementById("page-loader");
            if (loader) {
                loader.classList.add("hide");
                setTimeout(() => loader.remove(), 400);
            }
        });
    </script>

    <script>
        $(document).ready(function () {
            let searchBox = $('.search-auto');
            let suggestionBox = $('<div class="suggestion-box shadow-lg"></div>');
            suggestionBox.css({
                position: 'absolute',
                top: '100%',
                left: 0,
                width: '100%',
                zIndex: 9999,
                display: 'none'
            });
            searchBox.parent().css('position', 'relative');
            searchBox.after(suggestionBox);

            searchBox.on('keyup', function () {
                let term = $(this).val().trim();
                if (term.length < 1) {
                    suggestionBox.hide();
                    return;
                }

                $.getJSON('/Product/SearchSuggestions', { term: term }, function (data) {
                    suggestionBox.empty();

                    if (data.length > 0) {
                        data.forEach(item => {
                            let html = `
                            <a href="/Product/Details/${item.id}" class="suggestion-item d-flex justify-content-between align-items-center">
                                <div class="suggestion-info">
                                    <div class="product-name">${item.name}</div>
                                    <div class="product-prices">
                                        <span class="new-price">${item.newPrice.toLocaleString()}đ</span>
                                        ${item.oldPrice > 0 ? `<span class="old-price">${item.oldPrice.toLocaleString()}đ</span>` : ''}
                                    </div>
                                </div>
                                <img src="${item.imageUrl}" alt="${item.name}" class="suggestion-img">
                            </a>`;
                            suggestionBox.append(html);
                        });
                        suggestionBox.show();
                    } else {
                        suggestionBox.hide();
                    }
                });
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('.search-auto, .suggestion-box').length) {
                    suggestionBox.hide();
                }
            });
        });
    </script>
    
    <script>
        const newsPopup = document.getElementById("newsPopup");
        const newsToggle = document.getElementById("newsToggle");
        const newsWrapper = document.getElementById("newsWrapper");
        const newsCount = document.getElementById("newsCount");
        const newsList = document.getElementById("newsList");
        const bellIcon = document.getElementById("bellIcon");

        newsToggle.addEventListener("click", () => {
            const visible = newsPopup.style.display === "block";
            newsPopup.style.display = visible ? "none" : "block";
            if (!visible) loadLatestNews();
        });

        document.addEventListener("click", (e) => {
            if (!newsWrapper.contains(e.target)) {
                newsPopup.style.display = "none";
            }
        });

        // 🔄 Hàm load tin tức
        function loadLatestNews() {
            fetch("/News/GetLatest")
                .then(res => res.json())
                .then(data => {
                    newsList.innerHTML = "";
                    if (data.length === 0) {
                        newsList.innerHTML = `<li class="list-group-item text-center text-muted">Không có tin mới</li>`;
                    } else {
                        data.forEach(n => {
                            newsList.innerHTML += `
                                <li class="list-group-item">
                                    <a href="/News/Detail/${n.id}" class="text-decoration-none text-dark d-block">
                                        <div class="fw-semibold">${n.title}</div>
                                        <small class="text-muted">${n.publishedDate}</small>
                                    </a>
                                </li>`;
                        });
                    }
                    newsCount.innerText = data.length;
                })
                .catch(() => {
                    newsList.innerHTML = `<li class="list-group-item text-center text-danger">Lỗi tải dữ liệu</li>`;
                });
        }

        // 🕒 Auto reload mỗi 30s
        setInterval(loadLatestNews, 30000);
        loadLatestNews();

        // 🔔 Kết nối SignalR
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/newsHub")
            .build();

        // Khi nhận tin mới từ server
        connection.on("ReceiveNews", (title) => {
            // Rung chuông
            bellIcon.classList.add("ring");
            setTimeout(() => bellIcon.classList.remove("ring"), 2000);

            // Cập nhật danh sách tin mới nhất
            loadLatestNews();

            // Hiển thị thông báo nhỏ
            const toast = document.createElement("div");
            toast.className = "position-fixed top-0 end-0 p-3";
            toast.innerHTML = `
                <div class="toast align-items-center text-bg-primary border-0 show" style="z-index:2000">
                    <div class="d-flex">
                        <div class="toast-body">
                            📰 Tin mới: <strong>${title}</strong>
                        </div>
                    </div>
                </div>`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        });

        connection.start().catch(err => console.error(err.toString()));
    </script>

    <!-- Các script khác -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/news.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

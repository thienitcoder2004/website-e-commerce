@using website_e_commerce.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gear 5 Admin</title>

    <link rel="icon" type="image/png" href="/images/logo-wb.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body {
            background: #f2f4f7;
        }

        /* ---------------------
           SIDEBAR BASE
        --------------------- */
        .admin-sidebar {
            width: 240px;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            background: #fff;
            border-right: 1px solid #e3e6ea;
            transition: width .25s ease;
            z-index: 1035;
            overflow-y: auto;
        }

        .admin-sidebar.collapsed {
            width: 72px !important;
        }

        /* Logo */
        .brand {
            height: 60px;
            padding: 0 16px;
            border-bottom: 1px solid #e3e6ea;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 20px;
            font-weight: 700;
            color: #0d6efd;
            position: relative;
        }

        /* Collapse button */
        #btnCollapseGhost {
            position: absolute;
            right: -18px;
            top: 50%;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: white;
            border: 1px solid #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(0, 0, 0, .15);
            transition: .3s;
        }

        /* Link style */
        .admin-sidebar .nav-link {
            color: #444;
            padding: .65rem 1rem;
            border-radius: .55rem;
            display: flex;
            align-items: center;
            gap: .85rem;
            font-size: 15px;
            transition: .25s ease;
            position: relative;
        }

        .admin-sidebar .nav-link i {
            font-size: 18px;
            width: 22px;
            text-align: center;
        }

        .admin-sidebar .nav-link:hover {
            background: #eef6ff;
            color: #0d6efd;
            transform: translateX(4px);
            font-weight: 600;
        }

        .admin-sidebar .nav-link.active {
            background: #e1ecff;
            color: #0d6efd;
            font-weight: 700;
            border-left: 4px solid #0d6efd;
            transform: translateX(4px);
        }

        /* Collapse hide text */
        .admin-sidebar.collapsed .text-label {
            opacity: 0 !important;
            width: 0 !important;
            margin-left: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
        }

        .admin-sidebar.collapsed .nav-link {
            justify-content: center !important;
        }

        /* Tooltip */
        .admin-sidebar.collapsed .nav-link:hover::after {
            content: attr(data-title);
            position: absolute;
            left: 70px;
            background: #111;
            color: #fff;
            padding: 4px 10px;
            border-radius: 6px;
            white-space: nowrap;
            opacity: 1;
            z-index: 10;
        }

        .admin-main {
            margin-left: 240px;
            padding: 24px;
            transition: margin-left .25s ease;
        }

        .admin-main.expanded {
            margin-left: 72px;
        }

        /* GROUP TITLE */
        .menu-title {
            font-size: 12px;
            text-transform: uppercase;
            font-weight: 700;
            color: #999;
            margin: 18px 0 6px 12px;
        }

        /* Brand Section */
        .brand {
            height: 64px;
            border-bottom: 1px solid #e5e7eb;
            position: relative;
        }

        .brand a {
            color: #0d6efd;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: .5px;
        }

        /* Icon Gear */
        .brand-icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: #e7f1ff;
            color: #0d6efd;
            font-size: 18px;
            box-shadow: inset 0 0 4px rgba(0, 0, 0, .05);
        }

        /* Brand text */
        .brand-title {
            font-size: 18px;
            font-weight: 800;
            color: #0d6efd;
            transition: .2s ease;
        }

        /* Hover effect */
        .brand:hover .brand-title {
            color: #0b5ed7;
            letter-spacing: .8px;
        }

        .brand:hover .brand-icon {
            background: #d9e9ff;
        }

        /* Collapse - hidden text */
        .admin-sidebar.collapsed .brand-title {
            opacity: 0 !important;
            width: 0 !important;
            overflow: hidden !important;
            padding: 0 !important;
        }

        @@media (max-width: 991px) {
            .admin-sidebar {
                display: none !important;
            }

            .admin-main {
                margin-left: 0 !important;
            }
        }
    </style>

    @functions {
        string Active(string controller, string action = "Index")
        {
            var cc = ViewContext.RouteData.Values["controller"]?.ToString();
            var ca = ViewContext.RouteData.Values["action"]?.ToString();
            return (cc == controller && ca == action) ? "active" : "";
        }
    }

</head>

<body>

    <!-- ------------------------------
         NAVBAR (CÓ NÚT ĐĂNG XUẤT)
    ------------------------------- -->
    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
        <div class="container-fluid">

            <div class="d-flex ms-auto align-items-center gap-3">
                <div class="nav-item dropdown me-3" id="newsWrapper" style="position:relative;">
                    <a class="nav-link position-relative" href="javascript:void(0);" id="newsToggle">
                        <i class="fa-solid fa-bell" id="bellIcon"></i>
                        <span class="badge bg-danger position-absolute" id="newsCount"
                            style="top:-6px; right:-12px; font-size:.7rem;">0</span>
                    </a>
                    <div id="newsPopup" class="shadow bg-white border rounded position-absolute end-0 mt-2"
                        style="display:none; width:340px; max-height:420px; overflow-y:auto;">
                        <ul id="newsList" class="list-group list-group-flush"></ul>
                    </div>

                </div>
                <!-- Avatar -->
                <div class="d-flex align-items-center gap-2">
                    <img src="https://ui-avatars.com/api/?name=@User.Identity.Name" class="rounded-circle" width="38"
                        height="38" />

                    <div class="d-none d-md-block">
                        <div class="fw-semibold">@User.Identity.Name</div>
                        <div class="small text-muted">@User.Identity.Name</div>
                    </div>
                </div>

                <!-- BUTTON ĐĂNG XUẤT -->
                <a href="/Identity/Account/Logout" class="btn btn-outline-danger btn-sm fw-semibold">
                    <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                </a>

            </div>
        </div>
    </nav>


    <!-- ------------------------------
            SIDEBAR
    ------------------------------- -->
    <aside id="sidebar" class="admin-sidebar d-none d-lg-flex flex-column">

        <div class="brand d-flex align-items-center gap-2 px-3">
            <a href="/" class="d-flex align-items-center text-decoration-none">

                <!-- ICON (Gear đẹp màu xanh) -->
                <div class="brand-icon d-flex align-items-center justify-content-center">
                    <i class="fa-solid fa-gear"></i>
                </div>

                <!-- TEXT LABEL -->
                <span class="brand-title text-label ms-2">Gear 5 Admin</span>
            </a>
        </div>

        <div class="p-3 nav flex-column">

            <div class="menu-title">Tổng quan</div>

            <a class="nav-link @Active("AdminOrder", "Dashboard")" href="/AdminOrder/Dashboard" data-title="Dashboard">
                <i class="fa-solid fa-chart-line text-primary"></i>
                <span class="text-label">Dashboard</span>
            </a>

            <a class="nav-link @Active("AdminOrder", "Index")" href="/AdminOrder/Index" data-title="Đơn hàng">
                <i class="fa-solid fa-receipt text-info"></i>
                <span class="text-label">Đơn hàng</span>
            </a>

            <div class="menu-title">Sản phẩm</div>

            <a class="nav-link @Active("Brand")" href="/Brand/Index" data-title="Thương hiệu">
                <i class="fa-solid fa-copyright text-warning"></i>
                <span class="text-label">Thương hiệu</span>
            </a>

            <a class="nav-link @Active("Category")" href="/Category/Index" data-title="Danh mục">
                <i class="fa-solid fa-layer-group text-success"></i>
                <span class="text-label">Danh mục</span>
            </a>

            <a class="nav-link @Active("Product")" href="/Product/Index" data-title="Sản phẩm">
                <i class="fa-solid fa-box-open text-primary"></i>
                <span class="text-label">Sản phẩm</span>
            </a>

            <a class="nav-link @Active("FlashSale")" href="/FlashSale/Index" data-title="Flash Sale">
                <i class="fa-solid fa-bolt text-warning"></i>
                <span class="text-label">Flash Sale</span>
            </a>

            <a class="nav-link @Active("Promotion")" href="/Promotion/Index" data-title="Khuyến mãi">
                <i class="fa-solid fa-gift text-danger"></i>
                <span class="text-label">Mã khuyến mãi</span>
            </a>


            <div class="menu-title">Nội dung</div>

            <a class="nav-link @Active("News")" href="/News/Index" data-title="Tin tức">
                <i class="fa-solid fa-newspaper text-primary"></i>
                <span class="text-label">Tin tức</span>
            </a>

            <a class="nav-link @Active("Contact")" href="/Contact/Index" data-title="Liên hệ">
                <i class="fa-solid fa-envelope text-success"></i>
                <span class="text-label">Liên hệ</span>
            </a>

            <a class="nav-link @Active("Review")" href="/Review/Index" data-title="Đánh giá">
                <i class="fa-solid fa-star text-warning"></i>
                <span class="text-label">Đánh giá</span>
            </a>


            <div class="menu-title">Kho hàng</div>

            <a class="nav-link @Active("StockHistory", "Index")" href="/StockHistory/Index" data-title="Lịch sử kho">
                <i class="fa-solid fa-clock-rotate-left text-info"></i>
                <span class="text-label">Lịch sử kho</span>
            </a>

            <a class="nav-link @Active("StockHistory", "Statistics")" href="/StockHistory/Statistics"
                data-title="Thống kê kho">
                <i class="fa-solid fa-chart-column text-primary"></i>
                <span class="text-label">Thống kê kho</span>
            </a>


            <div class="menu-title">Hệ thống</div>

            <a class="nav-link @Active("SupportChat")" href="/SupportChat/AdminInbox" data-title="Tin nhắn">
                <i class="fa-solid fa-comments text-success"></i>
                <span class="text-label">Tin nhắn</span>
            </a>

            <a class="nav-link @Active("User")" href="/User/Index" data-title="Tài khoản">
                <i class="fa-solid fa-users-gear text-primary"></i>
                <span class="text-label">Tài khoản</span>
            </a>

        </div>
    </aside>


    <!-- ------------------------------
            MAIN CONTENT
    ------------------------------- -->
    <main id="mainContent" class="admin-main">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub") // Đảm bảo URL này chính xác
            .build();

        connection.on("NewOrderNotification", function (orderId) {
            // Cập nhật số lượng thông báo mới
            var newsCount = document.getElementById("newsCount");
            var currentCount = parseInt(newsCount.innerText) || 0;
            newsCount.innerText = currentCount + 1;

            // Thêm thông báo vào danh sách thông báo
            var newsList = document.getElementById("newsList");
            var listItem = document.createElement("li");
            listItem.textContent = "Đơn hàng #" + orderId + " cần xử lý.";

            // Khi nhấn vào thông báo, chuyển đến trang chi tiết đơn hàng
            listItem.onclick = function () {
                window.location.href = "/AdminOrder/Details/" + orderId;
            };

            newsList.appendChild(listItem);
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });

        document.getElementById("newsToggle").onclick = function () {
            var popup = document.getElementById("newsPopup");
            popup.style.display = (popup.style.display === "none" || popup.style.display === "") ? "block" : "none";
        };

        const sidebar = document.getElementById('sidebar');
        const main = document.getElementById('mainContent');
        const btn = document.getElementById('btnCollapseGhost');

        btn.onclick = () => {
            sidebar.classList.toggle('collapsed');
            main.classList.toggle('expanded');
        };

        const newsPopup = document.getElementById("newsPopup");
        const newsToggle = document.getElementById("newsToggle");
        const newsWrapper = document.getElementById("newsWrapper");
        const newsCount = document.getElementById("newsCount");
        const newsList = document.getElementById("newsList");
        const bellIcon = document.getElementById("bellIcon");

        newsToggle.addEventListener("click", () => {
            const visible = newsPopup.style.display === "block";
            newsPopup.style.display = visible ? "none" : "block";
            if (!visible) loadLatestNews();
        });

        document.addEventListener("click", (e) => {
            if (!newsWrapper.contains(e.target)) {
                newsPopup.style.display = "none";
            }
        });

        // 🔄 Hàm load tin tức
        function loadLatestNews() {
            fetch("/News/GetLatest")
                .then(res => res.json())
                .then(data => {
                    newsList.innerHTML = "";
                    if (data.length === 0) {
                        newsList.innerHTML = `<li class="list-group-item text-center text-muted">Không có tin mới</li>`;
                    } else {
                        data.forEach(n => {
                            newsList.innerHTML += `
                                <li class="list-group-item">
                                    <a href="/News/Detail/${n.id}" class="text-decoration-none text-dark d-block">
                                        <div class="fw-semibold">${n.title}</div>
                                        <small class="text-muted">${n.publishedDate}</small>
                                    </a>
                                </li>`;
                        });
                    }
                    newsCount.innerText = data.length;
                })
                .catch(() => {
                    newsList.innerHTML = `<li class="list-group-item text-center text-danger">Lỗi tải dữ liệu</li>`;
                });
        }

        // 🕒 Auto reload mỗi 30s
        setInterval(loadLatestNews, 30000);
        loadLatestNews();

        // 🔔 Kết nối SignalR
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/newsHub")
            .build();

        // Khi nhận tin mới từ server
        connection.on("ReceiveNews", (title) => {
            // Rung chuông
            bellIcon.classList.add("ring");
            setTimeout(() => bellIcon.classList.remove("ring"), 2000);

            // Cập nhật danh sách tin mới nhất
            loadLatestNews();

            // Hiển thị thông báo nhỏ
            const toast = document.createElement("div");
            toast.className = "position-fixed top-0 end-0 p-3";
            toast.innerHTML = `
                <div class="toast align-items-center text-bg-primary border-0 show" style="z-index:2000">
                    <div class="d-flex">
                        <div class="toast-body">
                            📰 Tin mới: <strong>${title}</strong>
                        </div>
                    </div>
                </div>`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        });

        connection.start().catch(err => console.error(err.toString()));
    </script>

    @RenderSection("Scripts", required: false)

</body>

</html>
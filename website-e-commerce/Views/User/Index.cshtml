@model IEnumerable<website_e_commerce.Models.UserListVM>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";

    var currentFilter = ViewData["CurrentFilter"] as string;
}

<section class="py-4">
    <div class="container-fluid">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-primary text-white border-0 py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1 text-uppercase fw-bold">👥 Quản lý tài khoản</h5>
                    <small>Theo dõi, tìm kiếm, khóa/mở khóa và xóa tài khoản trong hệ thống.</small>
                </div>
                <a href="/Identity/Account/Register" class="btn btn-success">
                    <i class="fa-solid fa-user-plus me-1"></i> Thêm tài khoản
                </a>
            </div>

            <div class="card-body bg-light">

                <!-- Tìm kiếm theo email -->
                <form asp-action="Index" method="get" class="mb-3 d-flex flex-wrap gap-2">
                    <input type="text"
                           name="searchEmail"
                           value="@currentFilter"
                           class="form-control"
                           style="max-width: 320px;"
                           placeholder="Tìm theo email..." />
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Tìm kiếm
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Làm mới
                    </a>
                </form>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-primary">
                            <tr>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>Số điện thoại</th>
                                <th>Quyền</th>
                                <th>Trạng thái</th>
                                <th class="text-center" style="width: 210px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model)
                            {
                                <tr>
                                    <td>@u.HoTen</td>
                                    <td>@u.Email</td>
                                    <td>@u.SoDienThoai</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@u.RoleDisplay</span>
                                    </td>
                                    <td>
                                        @if (u.IsLocked)
                                        {
                                            <span class="badge bg-danger">Đã khóa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                    </td>
                                    <td class="text-center">

                                        <!-- Sửa -->
                                        <a asp-action="Edit" asp-route-id="@u.Id"
                                           class="btn btn-sm btn-primary me-1"
                                           title="Sửa thông tin">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <!-- Khóa / mở khóa -->
                                        <form asp-action="LockUnlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                            <button type="submit"
                                                    class="btn btn-sm @(u.IsLocked ? "btn-success" : "btn-warning")"
                                                    title="Khóa / Mở khóa">
                                                <i class="fa-solid @(u.IsLocked ? "fa-lock-open" : "fa-lock")"></i>
                                            </button>
                                        </form>

                                        <!-- Xóa -->
                                        <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Xóa tài khoản này?');">
                                            <button type="submit" class="btn btn-sm btn-danger ms-1" title="Xóa">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</section>

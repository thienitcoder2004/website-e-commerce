@model website_e_commerce.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container mt-5 text-center">
    <h3 class="text-danger mb-4">⚠️ Bạn có chắc muốn xóa sản phẩm này không?</h3>

    <div class="card shadow-sm p-4">
        <img src="@Model.ImageUrl" class="img-fluid rounded mb-3" style="max-width:200px;" />
        <h4>@Model.Name</h4>
        <p class="text-muted">@String.Format("{0:N0} đ", Model.NewPrice)</p>
    </div>

    <form asp-action="Delete" method="post" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger px-4">🗑️ Xóa</button>
        <a asp-action="Index" class="btn btn-secondary px-4">⬅ Quay lại</a>
    </form>
</div>

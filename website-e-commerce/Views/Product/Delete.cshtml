@model website_e_commerce.Models.Product
@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container mt-4">
    <h3 class="text-danger mb-3">⚠️ Xác nhận xóa sản phẩm</h3>

    <dl class="row">
        <dt class="col-sm-3">Tên sản phẩm</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Giá mới</dt>
        <dd class="col-sm-9">@String.Format("{0:N0}đ", Model.NewPrice)</dd>

        <dt class="col-sm-3">Danh mục</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>

        <dt class="col-sm-3">Ảnh</dt>
        <dd class="col-sm-9">
            <img src="@Model.ImageUrl" style="max-width: 150px;" />
        </dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">🗑 Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">⬅ Trở lại</a>
    </form>
</div>

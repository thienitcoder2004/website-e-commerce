@model website_e_commerce.Models.Product
@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="container py-5">
    <h2 class="fw-bold text-danger text-center mb-4">
        <i class="fa-solid fa-plus"></i> Thêm sản phẩm mới
    </h2>

    <form asp-action="Add" method="post" enctype="multipart/form-data"
          class="shadow p-4 bg-white rounded-4">

        <!-- TÊN SP + CATEGORY + BRAND -->
        <div class="row mb-4">
            <div class="col-md-4">
                <label class="form-label fw-bold">Tên sản phẩm</label>
                <input asp-for="Name" class="form-control" placeholder="iPhone 15 Pro Max..." />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Danh mục</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Thương hiệu</label>
                <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-select">
                    <option value="">-- Chọn thương hiệu --</option>
                </select>
                <span asp-validation-for="BrandId" class="text-danger"></span>
            </div>
        </div>

        <!-- GIÁ -->
        <div class="row mb-4">
            <div class="col-md-4">
                <label class="form-label fw-bold">Giá cũ</label>
                <input asp-for="OldPrice" type="number" class="form-control" id="oldPrice" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">% Giảm giá</label>
                <input asp-for="DiscountPercent" type="number" id="discountPercent" class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Giá sau giảm</label>
                <input asp-for="NewPrice" type="number" id="newPrice" class="form-control" readonly />
                <small class="text-muted">Tự tính theo giá cũ + % giảm</small>
            </div>
        </div>

        <!-- KHO -->
        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label fw-bold">Tồn kho ban đầu</label>
                <input asp-for="StockQuantity" type="number" min="0" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Số lượng hiển thị web</label>
                <input asp-for="WebQuantity" type="number" min="0" class="form-control" placeholder="Nên để 0" />
            </div>
        </div>

        <!-- HÌNH ẢNH -->
        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label fw-bold">Ảnh đại diện</label>
                <input type="file" name="thumbnail" class="form-control" />
                <small class="text-muted">Ảnh thumbnail chính</small>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Gallery (nhiều ảnh)</label>
                <input type="file" name="galleryImages" multiple class="form-control" />
                <small class="text-muted">Chọn nhiều ảnh phụ</small>
            </div>
        </div>

        <!-- MÔ TẢ -->
        <div class="mb-4">
            <label class="form-label fw-bold">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <!-- SPEC -->
        <div class="mb-4">
            <label class="form-label fw-bold">Thông số kỹ thuật</label>
            <textarea asp-for="Specifications" class="form-control" rows="5"
                      placeholder="RAM: 8GB&#10;ROM: 256GB&#10;Pin: 4500mAh"></textarea>
        </div>

        <!-- PROMO -->
        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label fw-bold">Quà tặng</label>
                <input asp-for="GiftPromotion" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Khuyến mãi</label>
                <input asp-for="SalePromotion" class="form-control" />
            </div>
        </div>

        <div class="text-end">
            <button type="submit" class="btn btn-danger px-4">Lưu sản phẩm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const oldP = document.getElementById("oldPrice");
        const dis = document.getElementById("discountPercent");
        const newP = document.getElementById("newPrice");

        function update() {
            let o = parseFloat(oldP.value) || 0;
            let d = parseFloat(dis.value) || 0;

            if (o > 0 && d >= 0)
                newP.value = (o - o * d / 100).toFixed(0);
        }

        oldP.addEventListener("input", update);
        dis.addEventListener("input", update);
    });
</script>

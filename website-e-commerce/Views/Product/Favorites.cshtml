@model IEnumerable<website_e_commerce.Models.Product>

@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}

<div class="shoppingcart-page pb-5">

    <!-- BREADCRUMB -->
    <div class="bread-cumb py-3 bg-light border-bottom mb-4">
        <div class="container">
            <ul class="breadcrumb mb-0">
                <li class="home">
                    <a href="/" class="text-decoration-none text-dark fw-semibold">Trang chủ</a>
                    <span class="mx-2 text-muted">
                        <i class="fa-solid fa-chevron-right"></i>
                    </span>
                </li>
                <li class="fw-bold text-danger">Sản phẩm yêu thích</li>
            </ul>
        </div>
    </div>

    <div class="container mt-4">

        <h2 class="mb-4 text-center fw-bold text-uppercase text-danger">
            💖 Danh sách yêu thích
        </h2>

        @if (!Model.Any())
        {
            <div class="text-center mt-5">
                <i class="fa-solid fa-heart-crack" style="font-size:110px; color:#ff4d4f; opacity:0.9;"></i>
                <h5 class="mt-3 text-muted">Bạn chưa thích sản phẩm nào</h5>
                <a href="/" class="btn btn-outline-danger mt-3">Tiếp tục mua sắm</a>
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var item in Model)
                {
                    <div class="col-md-3 col-sm-6">
                        <div class="fav-card shadow-sm rounded-4 p-3 position-relative">

                            <!-- ICON TRÁI TIM -->
                            <div class="position-absolute top-0 end-0 mt-2 me-2">
                                <form asp-controller="Product" asp-action="ToggleFavorite" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.Id" />

                                    <button type="submit" class="btn btn-light rounded-circle shadow-sm fav-heart">
                                        <i class="fa-solid fa-heart text-danger"></i>
                                    </button>
                                </form>
                            </div>

                            <!-- ẢNH -->
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id"
                               class="text-decoration-none text-dark">
                                <img src="@item.ImageUrl"
                                     class="img-fluid mb-3"
                                     style="height:180px; object-fit:contain;" />

                                <!-- Tên -->
                                <h6 class="fw-bold">@item.Name</h6>
                            </a>

                            <!-- Giá -->
                            <div class="text-danger fw-bold">
                                @item.NewPrice.ToString("N0") ₫

                                @if (item.OldPrice > item.NewPrice)
                                {
                                    <span class="text-muted text-decoration-line-through ms-1" style="font-size:0.85rem">
                                        @item.OldPrice.ToString("N0") ₫
                                    </span>
                                }
                            </div>

                            <!-- Nút -->
                            <div class="mt-3 d-grid gap-2">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-danger fw-bold">
                                    Xem chi tiết
                                </a>

                                <form asp-controller="Product" asp-action="ToggleFavorite" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <button class="btn btn-outline-secondary">
                                        Bỏ yêu thích
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                }

            </div>
        }

    </div>
</div>

<style>
    /* CARD YÊU THÍCH */
    .fav-card {
        border: 1px solid #eee;
        transition: 0.25s ease;
        background: #fff;
    }

        .fav-card:hover {
            border-color: #ff4d4f;
            background: #fff5f5;
            transform: translateY(-3px);
        }

    /* ICON TRÁI TIM */
    .fav-heart i {
        font-size: 18px;
    }

    /* Responsive */
    @@media (max-width: 575px) {
        .fav-card img {
            height: 150px;
        }
    }
</style>

@model IEnumerable<website_e_commerce.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<section class="container mt-4">
    <h2 class="mb-4 text-center fw-bold">🛍️ Danh sách sản phẩm</h2>

    <!-- Bộ lọc và sắp xếp -->
    <form method="get" class="mb-4 d-flex flex-wrap gap-3 justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <label for="priceRange" class="fw-semibold">Lọc giá:</label>
            <select id="priceRange" name="priceRange" class="form-select" style="width: 220px;" onchange="this.form.submit()">
                <option value="">Tất cả</option>
                <option value="1" selected="@(ViewBag.PriceRange == "1")">Dưới 500.000đ</option>
                <option value="2" selected="@(ViewBag.PriceRange == "2")">500.000đ - 2.000.000đ</option>
                <option value="3" selected="@(ViewBag.PriceRange == "3")">2.000.000đ - 5.000.000đ</option>
                <option value="4" selected="@(ViewBag.PriceRange == "4")">5.000.000đ - 10.000.000đ</option>
                <option value="5" selected="@(ViewBag.PriceRange == "5")">Trên 10.000.000đ</option>
            </select>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label for="sortOrder" class="fw-semibold">Sắp xếp:</label>
            <select id="sortOrder" name="sortOrder" class="form-select" style="width: 200px;" onchange="this.form.submit()">
                <option value="">Mặc định</option>
                <option value="price_asc" selected="@(ViewBag.SortOrder == "price_asc")">Giá: Thấp → Cao</option>
                <option value="price_desc" selected="@(ViewBag.SortOrder == "price_desc")">Giá: Cao → Thấp</option>
                <option value="name_asc" selected="@(ViewBag.SortOrder == "name_asc")">Tên: A → Z</option>
                <option value="name_desc" selected="@(ViewBag.SortOrder == "name_desc")">Tên: Z → A</option>
            </select>
        </div>
    </form>

    <!-- Danh sách sản phẩm -->
    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var product in Model)
            {
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="product-card position-relative p-3 shadow-sm rounded-4 text-center">
                        <div class="discount-badge position-absolute top-0 start-0 bg-danger text-white px-2 py-1 rounded-end">
                            Giảm @product.DiscountPercent%
                        </div>

                        <img src="@(product.ImageUrl ?? "~/images/product/default.png")"
                             alt="@product.Name"
                             class="img-fluid mb-2 rounded"
                             style="max-height: 220px; object-fit: contain;" />

                        <div class="product-name fw-bold mt-2 mb-1 text-truncate" title="@product.Name">
                            @product.Name
                        </div>

                        <div class="old-price text-muted text-decoration-line-through">
                            @String.Format("{0:N0}đ", product.OldPrice)
                        </div>

                        <div class="new-price text-danger fw-semibold mb-2">
                            @String.Format("{0:N0}đ", product.NewPrice)
                        </div>

                        <a href="@Url.Action("Details", "Product", new { id = product.Id })"
                           class="buy-btn btn btn-primary rounded-pill px-3 py-1">
                            <i class="fa-solid fa-cart-shopping"></i> Xem chi tiết
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p>Không có sản phẩm nào phù hợp.</p>
            </div>
        }
    </div>
</section>

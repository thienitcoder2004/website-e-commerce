@model IEnumerable<website_e_commerce.Models.Product>
@inject website_e_commerce.Models.ApplicationDbContext _context

@{
    ViewData["Title"] = "Danh sách sản phẩm";

    string currentFilter = ViewBag.Filter as string ?? "";
    string currentSort = ViewBag.SortOrder as string ?? "";
    string searchKeyword = ViewBag.SearchKeyword as string ?? "";
    int? brandId = ViewBag.BrandId as int?;
    int? catId = ViewBag.CategoryId as int?;
    var favoriteIds = ViewBag.FavoriteIds as List<int> ?? new List<int>();
    int totalProducts = Model?.Count() ?? 0;
    bool showDynamic = ViewBag.DynamicFilters != null;  
}


@if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_StockManager))
{
    <style>
    .product-page-wrapper {
        background: radial-gradient(circle at top left, #eef2ff, #ffffff);
        border-radius: 18px;
        padding: 28px 24px;
        margin-top: 20px;
        box-shadow: 0 8px 24px rgba(15,23,42,0.12);
    }

    .product-title {
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
        font-size: 18px;
    }

    .product-subtitle {
        font-size: 13px;
        color: #6b7280;
    }

    .product-badge-summary {
        font-size: 13px;
        padding: 6px 14px;
        border-radius: 999px;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        color: #4b5563;
    }

    .btn-add-product {
        border-radius: 999px;
        padding: 8px 18px;
        font-size: 14px;
    }

    .product-table-wrapper {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(15,23,42,0.08);
        overflow: hidden;
    }

    .table thead th {
        background: #dc3545;
        color: #fff;
        border-bottom: none;
    }

    .table tbody tr:hover {
        background: #fff3f3;
    }

    .stock-badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .st-out { background: #ffe6e6; color: #b40000; border: 1px solid #ffb3b3; }
    .st-low { background: #fff4d6; color: #a86a00; border: 1px solid #ffd57e; }
    .st-available { background: #e7ffe9; color: #0a8a27; border: 1px solid #a8eab3; }

    @@media(max-width: 768px) {
        .product-page-wrapper { padding: 20px 16px; }
        .table-responsive { font-size: 13px; }
    }
</style>

<div class="container">
    <div class="product-page-wrapper">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h2 class="product-title text-danger mb-1">📦 Quản lý sản phẩm & Kho tồn</h2>
                <p class="product-subtitle mb-0">Theo dõi số lượng tồn - sản phẩm sắp hết - điều chỉnh kho.</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="product-badge-summary">
                    <i class="fa-solid fa-boxes-stacked me-1"></i>
                    Tổng sản phẩm: <strong>@totalProducts</strong>
                </span>

                <a asp-action="Add" class="btn btn-danger btn-add-product">
                    <i class="fa-solid fa-plus"></i> Thêm sản phẩm
                </a>
            </div>
        </div>

        <!-- ALERT -->
        @if (TempData["success"] != null)
        {
            <div class="alert alert-success">@TempData["success"]</div>
        }
        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger">@TempData["error"]</div>
        }

        <!-- SEARCH + IMPORT -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

            <!-- SEARCH -->
            <form asp-action="Index" method="get" class="d-flex" style="max-width:350px;">
                <input type="text" name="query"
                       value="@ViewBag.SearchKeyword"
                       class="form-control shadow-sm me-2"
                       placeholder="🔍 Tìm sản phẩm...">
                <button class="btn btn-outline-secondary shadow-sm">Tìm</button>
            </form>

            <!-- IMPORT EXCEL -->
            <form asp-action="ImportExcel" enctype="multipart/form-data" method="post"
                  class="d-flex align-items-center">
                <input type="file" name="file"
                       class="form-control shadow-sm" style="max-width:280px;">
                <button type="submit" class="btn btn-success ms-2 shadow-sm">
                    <i class="fa-solid fa-file-excel"></i> Nhập Excel
                </button>
            </form>

        </div>

        <!-- TABLE -->
        <div class="product-table-wrapper">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th class="text-start ps-3">Tên sản phẩm</th>
                            <th>Giá bán</th>
                            <th>Tồn kho</th>
                            <th>Đang bán</th>
                            <th>Trạng thái</th>
                            <th>Nhập / Xuất</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var p in Model)
                        {
                            var available = p.StockQuantity - p.WebQuantity;

                            string statusClass =
                                available <= 0 ? "st-out" :
                                available < 10 ? "st-low" : "st-available";

                            string statusText =
                                available <= 0 ? "Hết hàng" :
                                available < 10 ? "Sắp hết" : "Còn hàng";

                            <tr>
                                <td class="fw-bold">@p.Id</td>

                                <td class="text-start fw-semibold">@p.Name</td>

                                <td class="fw-bold text-danger">@p.NewPrice.ToString("N0") đ</td>

                                <td>@p.StockQuantity</td>

                                <td>@p.WebQuantity</td>

                                <td>
                                    <span class="stock-badge @statusClass">@statusText</span>
                                </td>

                                <!-- NHẬP XUẤT KHO -->
                                <td>
                                    <form asp-action="ImportToStock" method="post"
                                          class="d-inline-flex align-items-center mb-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="number" min="1"
                                               name="importQuantity" placeholder="SL"
                                               class="form-control form-control-sm me-1"
                                               style="width:70px;">
                                        <button class="btn btn-sm btn-outline-success shadow-sm">Nhập</button>
                                    </form>

                                    <form asp-action="ExportToWeb" method="post"
                                          class="d-inline-flex align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="number" min="1"
                                               name="exportQuantity" placeholder="SL"
                                               class="form-control form-control-sm me-1"
                                               style="width:70px;">
                                        <button class="btn btn-sm btn-outline-primary shadow-sm">Xuất</button>
                                    </form>
                                </td>

                                <!-- ACTION -->
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-secondary shadow-sm">
                                            Chi tiết
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-warning shadow-sm">
                                            Sửa
                                        </a>

                                        <form asp-action="DeleteConfirmed" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button class="btn btn-sm btn-outline-danger shadow-sm"
                                                    onclick="return confirm('Xóa sản phẩm này?')">
                                                Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PAGINATION -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="?page=@i&query=@ViewBag.SearchKeyword">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

    </div>
</div>
}
else if (User.IsInRole(SD.Role_Employee))
{
    <div class="container py-5">
        <h2 class="fw-bold text-danger text-center mb-4">📦 Quản lý sản phẩm & kho tồn</h2>

        <table class="table table-hover text-center align-middle shadow-sm">
            <thead class="table-danger">
                <tr>
                    <th>Mã</th>
                    <th>Tên sản phẩm</th>
                    <th>Giá</th>
                    <th>Tồn kho</th>
                    <th>Đang bán (Web)</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var available = p.StockQuantity - p.WebQuantity;
                    var rowClass = available <= 0 ? "table-danger" : available < 10 ? "table-warning" : "";

                    <tr class="@rowClass">
                        <td>@p.Id</td>
                        <td class="text-start fw-semibold">@p.Name</td>
                        <td>@String.Format("{0:N0} đ", p.NewPrice)</td>
                        <td>@p.StockQuantity</td>
                        <td>@p.WebQuantity</td>
                        <td>
                            @(available <= 0 ? "Hết hàng" :
                                                available < 10 ? "Sắp hết" :
                                                "Còn hàng")
                </td>
            </tr>
                        }
            </tbody>
        </table>

        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        var active = i == ViewBag.CurrentPage ? "active" : "";
                        <li class="page-item @active">
                            <a class="page-link"
                               href="?page=@i@(ViewBag.CategoryId != null ? $"&categoryId={ViewBag.CategoryId}" : "")">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
}
else
{
    <div class="container mt-4">
        <div class="row">

            <!-- ------------------------------------------------------------
                 BỘ LỌC BÊN TRÁI
            ------------------------------------------------------------- -->
            <div class="col-lg-3 col-md-4">

                <div class="filter-sidebar p-3 shadow-sm">

                    <!-- ==========================
                         ACCORDION
                    =========================== -->
                    <div class="accordion" id="filterAccordion">

                        <!-- ==========================
                             FILTER HÃNG
                        =========================== -->
                        <div class="accordion-item mb-3">
                            <h2 class="accordion-header" id="brandHeading">
                                <button class="accordion-button collapsed fw-bold"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#brandCollapse">
                                    Hãng
                                </button>
                            </h2>

                            <div id="brandCollapse"
                                 class="accordion-collapse collapse"
                                 data-bs-parent="#filterAccordion">

                                <div class="accordion-body">

                                    @if (ViewBag.Brands != null)
                                    {
                                        foreach (var b in ViewBag.Brands)
                                        {
                                            bool active = (brandId == b.Id);

                                            string url =
                                            $"?query={searchKeyword}&brand={b.Id}&filter={currentFilter}&sortOrder={currentSort}";

                                            <div class="filter-row mb-1">
                                                <input id="brand_@b.Id"
                                                       class="form-check-input filter-check"
                                                       type="checkbox"
                                                       value="@b.Id"
                                                       @(brandId == b.Id ? "checked" : "")
                                                       data-type="brand" />

                                                <label for="brand_@b.Id" class="filter-label">
                                                    @b.Name
                                                </label>
                                            </div>
                                        }
                                    }

                                </div>
                            </div>
                        </div>

                        <!-- ==========================
                             FILTER GIÁ TIỀN
                        =========================== -->
                        <div class="accordion-item mb-3">
                            <h2 class="accordion-header" id="priceHeading">
                                <button class="accordion-button collapsed fw-bold"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#priceCollapse">
                                    Giá tiền
                                </button>
                            </h2>

                            <div id="priceCollapse"
                                 class="accordion-collapse collapse"
                                 data-bs-parent="#filterAccordion">

                                <div class="accordion-body">

                                    @{
                                        var ranges = new List<(string label, int min, int max)>
                                                                {
                                                                ("Dưới 5 triệu", 0, 5000000),
                                                                ("5 - 10 triệu", 5000000, 10000000),
                                                                ("10 - 15 triệu", 10000000, 15000000),
                                                                ("15 - 20 triệu", 15000000, 20000000),
                                                                ("20 - 30 triệu", 20000000, 30000000),
                                                                ("30 - 40 triệu", 30000000, 40000000),
                                                                ("40 - 50 triệu", 40000000, 50000000),
                                                                ("Trên 50 triệu", 50000000, 999999999),
                                                                };
                                    }

                                    @foreach (var r in ranges)
                                    {
                                        string priceTag = $"price={r.min}-{r.max}";
                                        bool active = currentFilter.Contains(priceTag);

                                        string next =
                                        active
                                        ? currentFilter.Replace(priceTag, "").Trim(',')
                                        : ((currentFilter + "," + priceTag).Trim(','));

                                        string url =
                                        $"?query={searchKeyword}&brand={brandId}&filter={next}&sortOrder={currentSort}";

                                        <div class="form-check mb-1">
                                            <input class="form-check-input filter-check"
                                                   type="checkbox"
                                                   value="price=@r.min-@r.max"
                                                   @(active ? "checked" : "")
                                                   data-type="filter" />

                                            <label class="form-check-label">@r.label</label>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>


                        <!-- ==========================
                            BỘ LỌC NÂNG CAO
                        =========================== -->
                        @if (showDynamic)
                        {
                            <div class="accordion-item mb-3">

                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed fw-bold"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#advCollapse">
                                        Bộ lọc nâng cao
                                    </button>
                                </h2>

                                <div id="advCollapse"
                                     class="accordion-collapse collapse"
                                     data-bs-parent="#filterAccordion">

                                    <div class="accordion-body">

                                        @foreach (var g in ViewBag.DynamicFilters)
                                        {
                                            <div class="mb-2">
                                                <div class="fw-bold">@g.Label</div>

                                                @foreach (var v in g.Values)
                                                {
                                                    string opt = $"{g.Key}={v}";
                                                    bool active = currentFilter.Contains(opt);

                                                    string next =
                                                    active
                                                    ? currentFilter.Replace(opt, "").Trim(',')
                                                    : ((currentFilter + "," + opt).Trim(','));

                                                    string url =
                                                    $"?query={searchKeyword}&categoryId={catId}&brand={brandId}&filter={next}&sortOrder={currentSort}";

                                                    <div class="form-check mb-1">
                                                        <input class="form-check-input filter-check"
                                                               type="checkbox"
                                                               value="@($"{g.Key}={v}")"
                                                               @(active ? "checked" : "")
                                                               data-type="filter" />

                                                        <label class="form-check-label">@v</label>
                                                    </div>
                                                }
                                            </div>
                                        }

                                    </div>
                                </div>
                            </div>
                        }

                    </div>

                </div>

            </div>


            <!-- ------------------------------------------------------------
                 DANH SÁCH SẢN PHẨM
            ------------------------------------------------------------- -->
            <div class="col-lg-9 col-md-8">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold">Kết quả tìm kiếm</h5>

                    <div style="min-width:180px;">
                        <select class="form-select form-select-sm"
                                onchange="location = this.value;">

                            @{
                                string baseUrl =
                                $"?query={searchKeyword}&categoryId={(catId > 0 ? catId : "")}&brand={brandId}&filter={currentFilter}";
                            }

                            <!-- Default -->
                            <option value="@($"{baseUrl}&sortOrder=")">
                                Sắp xếp theo
                            </option>

                            <!-- Giá tăng dần -->
                            <option value="@($"{baseUrl}&sortOrder=price_asc")"
                                    selected="@(currentSort == "price_asc")">
                                Giá tăng dần
                            </option>

                            <!-- Giá giảm dần -->
                            <option value="@($"{baseUrl}&sortOrder=price_desc")"
                                    selected="@(currentSort == "price_desc")">
                                Giá giảm dần
                            </option>

                            <!-- Tên A-Z -->
                            <option value="@($"{baseUrl}&sortOrder=name_asc")"
                                    selected="@(currentSort == "name_asc")">
                                Tên A-Z
                            </option>

                            <!-- Tên Z-A -->
                            <option value="@($"{baseUrl}&sortOrder=name_desc")"
                                    selected="@(currentSort == "name_desc")">
                                Tên Z-A
                            </option>

                        </select>
                    </div>
                </div>



                <!-- ----------------------------------------------------------------
                     TAG FILTER ĐANG CHỌN
                ---------------------------------------------------------------- -->
                @if (brandId != null || !string.IsNullOrEmpty(currentFilter))
                {
                    <div class="mb-3">
                        <!-- FILTER TAGS -->
                        @if (brandId != null || !string.IsNullOrEmpty(currentFilter))
                        {
                            <div class="mb-3">
                                <strong class="me-2">Đang lọc:</strong>

                                <!-- Brand tag -->
                                @if (brandId != null)
                                {
                                    var brands = ViewBag.Brands as List<Brand>;
                                    var brandName = brands?.FirstOrDefault(x => x.Id == brandId)?.Name;
                                    string removeBrand = $"?query={searchKeyword}&filter={currentFilter}&sortOrder={currentSort}";

                                    <span class="badge bg-primary me-2">
                                        Hãng: @brandName
                                        <a href="@removeBrand" class="text-white ms-1">×</a>
                                    </span>
                                }

                                <!-- Filter tags -->
                                @if (!string.IsNullOrEmpty(currentFilter))
                                {
                                    var items = currentFilter.Split(",", StringSplitOptions.RemoveEmptyEntries);

                                    foreach (var f in items)
                                    {
                                        string newFilter = string.Join(",", items.Where(x => x != f));
                                        string url = $"?query={searchKeyword}&categoryId={catId}&brand={brandId}&filter={newFilter}&sortOrder={currentSort}";

                                        <span class="badge bg-secondary me-2">
                                            @f
                                            <a href="@url" class="text-white ms-1">×</a>
                                        </span>
                                    }
                                }

                                <!-- ⭐ NÚT XÓA TẤT CẢ BỘ LỌC -->
                                @{
                                    string clearAllUrl = $"?query={searchKeyword}";
                                }
                                <a href="@clearAllUrl" class="badge bg-danger ms-2 text-white"
                                   style="cursor:pointer; padding:8px 12px; font-size:13px; border-radius:6px;">
                                    <i class="fa-solid fa-xmark me-1"></i> Xóa bộ lọc
                                </a>
                            </div>
                        }

                    </div>
                }


                <!-- ------------------------------------------------------------
                     LIST SẢN PHẨM
                ------------------------------------------------------------- -->
                <div class="row g-3 mb-lg-5">

                    @foreach (var p in Model)
                    {
                        <div class="col-md-4 col-sm-6">
                            <div class="product-card text-center p-3 rounded shadow-sm position-relative">

                                <!-- YÊU THÍCH -->
                                <div class="d-flex">
                                    <div class="position-absolute top-0 end-0 mt-2 me-2">
                                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                                        {
                                            bool isFavorite = favoriteIds.Contains(p.Id);

                                            <form asp-controller="Product" asp-action="ToggleFavorite" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@p.Id" />
                                                <button class="btn btn-sm btn-light rounded-circle shadow-sm">
                                                    <i class="@(isFavorite ? "fa-solid fa-heart text-danger" : "fa-regular fa-heart")"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-area="Identity" asp-page="/Account/Login"
                                               class="btn btn-sm btn-light rounded-circle shadow-sm">
                                                <i class="fa-regular fa-heart"></i>
                                            </a>
                                        }
                                    </div>

                                    <!-- So sánh -->
                                    <form asp-controller="Product" asp-action="AddToCompare" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="btn btn-outline-primary btn-sm mb-2">
                                            <i class="fa-solid fa-code-compare me-1"></i> So sánh
                                        </button>
                                    </form>
                                </div>

                                <!-- Ảnh + tên -->
                                <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">
                                    <img src="@p.ImageUrl" class="img-fluid mb-2" style="width: 230px; height: 250px;"/>
                                    <h6 class="fw-semibold">@p.Name</h6>
                                </a>

                                <div class="text-danger fw-bold">@p.NewPrice.ToString("N0") ₫</div>

                            </div>
                        </div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="col-12 text-center text-muted">
                            Không có sản phẩm nào phù hợp.
                        </div>
                    }
                </div>

                <!-- ------------------------------------------------------------
                     PHÂN TRANG
                ------------------------------------------------------------- -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                bool active = i == ViewBag.CurrentPage;

                                string url =
                                $"?query={searchKeyword}&categoryId={catId}&brand={brandId}&filter={currentFilter}&sortOrder={currentSort}&page={i}";

                                <li class="page-item @(active ? "active" : "")">
                                    <a class="page-link" href="@url">@i</a>
                                </li>
                            }

                        </ul>
                    </nav>
                }

            </div>

        </div>
    </div>
}

<style>
    .filter-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 4px;
        cursor: pointer;
        border-radius: 6px;
    }

        .filter-row:hover {
            background: #f5f5f5;
        }

    .filter-label {
        cursor: pointer;
        user-select: none;
    }

    .form-check-input {
        cursor: pointer;
    }

    .filter-sidebar {
        background: #fff;
        border: 1px solid #eee;
        border-radius: 12px;
    }

    .filter-option a {
        display: block;
        padding: 6px 10px;
        font-size: 14px;
        color: #333;
        border-radius: 6px;
        transition: 0.2s;
    }

        .filter-option a:hover {
            background: #f2f2f2;
        }

    .filter-option.active a {
        color: #e40004 !important;
        font-weight: 600;
    }

    .form-check-input:checked {
        background-color: #ff424e;
        border-color: #ff424e;
    }

    .form-check-label {
        cursor: pointer;
    }

    .form-check {
        margin-left: 2px;
    }

</style>

<script>
    document.querySelectorAll(".filter-check").forEach(chk => {
        chk.addEventListener("change", () => {
            let url = new URL(window.location.href);

            let type = chk.dataset.type;
            let val = chk.value;

            if (type === "brand") {
                if (chk.checked) url.searchParams.set("brand", val);
                else url.searchParams.delete("brand");
            }

            if (type === "filter") {
                let filters = url.searchParams.get("filter")?.split(",") || [];

                if (chk.checked) {
                    if (!filters.includes(val)) filters.push(val);
                } else {
                    filters = filters.filter(x => x !== val);
                }

                if (filters.length > 0)
                    url.searchParams.set("filter", filters.join(","));
                else
                    url.searchParams.delete("filter");
            }

            // Reset về trang 1 mỗi lần filter
            url.searchParams.set("page", 1);

            window.location.href = url.toString();
        });
    });
</script>

@model website_e_commerce.Models.Product
@using System.Text.RegularExpressions
@{
    var fs = ViewBag.FlashSale as website_e_commerce.Models.FlashSale;
    ViewData["Title"] = "Chi tiết sản phẩm";

    // ==============================
    // ✅ PARSE SPECIFICATIONS (key=value;feature=...;...)
    // ==============================
    var specDict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var featureList = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model?.Specifications))
    {
        var parts = Model.Specifications.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var p in parts)
        {
            if (string.IsNullOrWhiteSpace(p)) continue;

            var idx = p.IndexOf('=');
            if (idx > 0)
            {
                var k = p.Substring(0, idx).Trim();
                var v = p.Substring(idx + 1).Trim();

                if (k.Equals("feature", StringComparison.OrdinalIgnoreCase))
                {
                    if (!string.IsNullOrWhiteSpace(v)) featureList.Add(v);
                }
                else
                {
                    if (!string.IsNullOrWhiteSpace(k) && !string.IsNullOrWhiteSpace(v))
                        specDict[k] = v;
                }
            }
            else
            {
                // nếu chuỗi không có "=" thì coi như feature
                featureList.Add(p.Trim());
            }
        }
    }

    string V(string key, string fallback = "Đang cập nhật")
        => specDict.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v : fallback;

    string Label(string key) => key.ToLower() switch
    {
        "os" => "Hệ điều hành",
        "cpu" => "Chip xử lý (CPU)",
        "gpu" => "Chip đồ hoạ (GPU)",
        "ram" => "RAM",
        "rom" => "Bộ nhớ trong",
        "screen" => "Màn hình",
        "tech" => "Công nghệ màn hình",
        "resolution" => "Độ phân giải",
        "refresh" => "Tần số quét",
        "camerarear" => "Camera sau",
        "camerafront" => "Camera trước",
        "camera" => "Camera",
        "battery" => "Dung lượng pin",
        "charge" => "Sạc",
        "wireless" => "Sạc không dây",
        "network" => "Mạng di động",
        "sim" => "SIM",
        "water" => "Kháng nước/bụi",
        "weight" => "Khối lượng",
        "connect" => "Kết nối",
        "size" => "Kích thước",
        _ => key
    };

    string Pretty(string key, string val)
    {
        if (string.IsNullOrWhiteSpace(val)) return "Đang cập nhật";
        var k = key.ToLower();
        var v = val.Trim();

        // Thêm đơn vị nếu thiếu
        if (k == "ram" && !v.ToLower().Contains("gb")) v += " GB";
        if (k == "rom" && !v.ToLower().Contains("gb")) v += " GB";
        if (k == "battery" && !v.ToLower().Contains("mah")) v += " mAh";
        if (k == "refresh" && !v.ToLower().Contains("hz")) v += " Hz";
        if (k == "camerarear" && !v.ToLower().Contains("mp")) v += " MP";
        if (k == "camerafront" && !v.ToLower().Contains("mp")) v += " MP";
        if (k == "camera" && !v.ToLower().Contains("mp")) v += " MP";

        // Normalize
        if (k == "network" && v.Equals("5g", StringComparison.OrdinalIgnoreCase)) v = "5G";
        if (k == "charge" && v.Equals("fastcharge", StringComparison.OrdinalIgnoreCase)) v = "Sạc nhanh";
        if (k == "wireless" && v.Equals("magsafe", StringComparison.OrdinalIgnoreCase)) v = "MagSafe";
        if (k == "sim") v = v.Replace("esim", "eSIM", StringComparison.OrdinalIgnoreCase);

        return v;
    }

    // Gợi ý 1 số thông số nổi bật
    var quickSpecs = new List<(string k, string v)>
    {
        ("screen", V("screen")),
        ("cpu", V("cpu")),
        ("ram", V("ram")),
        ("rom", V("rom")),
        ("battery", V("battery")),
    };

    // Group specs kiểu “web thị trường”
    var groups = new List<(string Title, List<(string Key, string Value)> Rows)>
    {
        ("Cấu hình & Bộ nhớ", new()
        {
            ("os", V("os")),
            ("cpu", V("cpu")),
            ("gpu", V("gpu")),
            ("ram", V("ram")),
            ("rom", V("rom")),
        }),
        ("Màn hình", new()
        {
            ("screen", V("screen")),
            ("tech", V("tech")),
            ("resolution", V("resolution")),
            ("refresh", V("refresh")),
        }),
        ("Camera", new()
        {
            ("cameraRear", V("cameraRear", V("camera"))),
            ("cameraFront", V("cameraFront")),
        }),
        ("Pin & Sạc", new()
        {
            ("battery", V("battery")),
            ("charge", V("charge")),
            ("wireless", V("wireless")),
        }),
        ("Kết nối & Tiện ích", new()
        {
            ("network", V("network")),
            ("sim", V("sim")),
            ("connect", V("connect")),
            ("water", V("water")),
            ("weight", V("weight")),
        }),
    };

    // Bỏ dòng “Đang cập nhật” để gọn
    for (int i = 0; i < groups.Count; i++)
    {
        groups[i].Rows.RemoveAll(r => r.Value == "Đang cập nhật");
    }
}

<div class="container mt-4 mb-5 pd-page">

    <!-- =========================
         TOP: Gallery + Info
    ========================== -->
    <div class="pd-top card border-0 shadow-sm">
        <div class="card-body p-3 p-lg-4">
            <div class="row g-4">

                <!-- ===== LEFT: GALLERY ===== -->
                <div class="col-lg-5">
                    <div class="pd-gallery">
                        <div class="pd-main-img text-center">
                            <img id="mainProductImage"
                                 src="@Model.ImageUrl"
                                 onerror="this.onerror=null;this.src='/images/no-image.png';"
                                 class="img-fluid"
                                 alt="@Model.Name" />
                        </div>

                        <button class="pd-thumb-btn left" id="thumbPrev" type="button" aria-label="Prev">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <button class="pd-thumb-btn right" id="thumbNext" type="button" aria-label="Next">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>

                        <div class="pd-thumbs" id="thumbContainer">
                            <img src="@Model.ImageUrl"
                                 onerror="this.onerror=null;this.src='/images/no-image.png';"
                                 class="thumb-image active" alt="thumb" />

                            @if (Model.ProductImages != null && Model.ProductImages.Any())
                            {
                                foreach (var img in Model.ProductImages)
                                {
                                    <img src="@img.ImageUrl"
                                         onerror="this.onerror=null;this.src='/images/no-image.png';"
                                         class="thumb-image" alt="thumb" />
                                }
                            }
                        </div>
                    </div>

                    <!-- “Ưu đãi / chính sách” giống style web thị trường -->
                    <div class="pd-policy mt-3">
                        <div class="pd-policy-item">
                            <i class="fa-solid fa-truck-fast"></i>
                            <div>
                                <div class="t1">Giao hàng toàn quốc</div>
                                <div class="t2">Giao nhanh - nhận tại nhà</div>
                            </div>
                        </div>
                        <div class="pd-policy-item">
                            <i class="fa-solid fa-rotate"></i>
                            <div>
                                <div class="t1">Đổi trả dễ dàng</div>
                                <div class="t2">Đổi mới 7 ngày đầu</div>
                            </div>
                        </div>
                        <div class="pd-policy-item">
                            <i class="fa-solid fa-shield-halved"></i>
                            <div>
                                <div class="t1">Bảo hành chính hãng</div>
                                <div class="t2">Hỗ trợ 24 tháng</div>
                            </div>
                        </div>
                        <div class="pd-policy-item">
                            <i class="fa-solid fa-headset"></i>
                            <div>
                                <div class="t1">Hỗ trợ nhiệt tình</div>
                                <div class="t2">Tư vấn miễn phí 24/7</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== RIGHT: INFO ===== -->
                <div class="col-lg-7">
                    <div class="pd-info">
                        <h2 class="pd-name">@Model.Name</h2>

                        <!-- Price -->
                        <div class="pd-price-wrap">
                            @if (fs != null)
                            {
                                <div class="pd-price">
                                    <span class="new">@fs.FlashPrice.ToString("N0") đ</span>
                                    <span class="old">@Model.NewPrice.ToString("N0") đ</span>
                                    <span class="badge-sale">🔥 Flash Sale</span>
                                </div>
                                <div class="pd-flash-note">
                                    <span class="sold">ĐÃ BÁN: <b>@fs.SoldQuantity</b> / @fs.FlashQuantity</span>
                                </div>
                            }
                            else
                            {
                                <div class="pd-price">
                                    <span class="new">@Model.NewPrice.ToString("N0") đ</span>
                                    <span class="old">@Model.OldPrice.ToString("N0") đ</span>
                                    <span class="badge-sale">-@Model.DiscountPercent%</span>
                                </div>
                            }
                        </div>

                        <!-- Stock -->
                        <div class="pd-stock mt-2">
                            @if (Model.WebQuantity <= 0)
                            {
                                <div class="alert alert-danger fw-bold py-2 mb-0">❌ Sản phẩm hiện đã <span class="text-uppercase">hết hàng</span></div>
                            }
                            else if (Model.WebQuantity < 10)
                            {
                                <div class="alert alert-warning fw-bold py-2 mb-0">⚠️ Chỉ còn lại <span class="text-dark">@Model.WebQuantity</span> sản phẩm!</div>
                            }
                            else
                            {
                                <div class="alert alert-success fw-bold py-2 mb-0">✅ Còn <span class="text-dark">@Model.WebQuantity</span> sản phẩm sẵn hàng</div>
                            }
                        </div>

                        <!-- Quick specs highlight -->
                        <div class="pd-quick-spec mt-3">
                            <div class="pd-quick-title">Thông số nổi bật</div>
                            <div class="pd-quick-grid">
                                @foreach (var q in quickSpecs)
                                {
                                    <div class="q-item">
                                        <div class="q-k">@Label(q.k)</div>
                                        <div class="q-v">@Pretty(q.k, q.v)</div>
                                    </div>
                                }
                            </div>

                            @if (featureList.Any())
                            {
                                <div class="pd-feature-tags">
                                    @foreach (var f in featureList.Distinct(StringComparer.OrdinalIgnoreCase).Take(10))
                                    {
                                        <span class="tag">@f</span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Actions -->
                        <div class="pd-actions mt-3">
                            <form id="addToCartForm"
                                  asp-controller="ShoppingCart"
                                  asp-action="AddToCart"
                                  method="post"
                                  class="pd-form">

                                <input type="hidden" name="productId" value="@Model.Id" />

                                <div class="pd-action-row">
                                    <div class="quantity-selector">
                                        <button type="button" class="btn-qty minus">−</button>
                                        <input type="text" name="quantity" value="1" readonly class="qty-input" />
                                        <button type="button" class="btn-qty plus">+</button>
                                    </div>

                                    <button type="button" class="btn btn-outline-primary btn-lg fw-bold pd-btn-call">
                                        📞 Liên hệ
                                    </button>

                                    @if (Model.WebQuantity > 0)
                                    {
                                        if (User.Identity != null && User.Identity.IsAuthenticated)
                                        {
                                            <button type="submit" class="btn btn-danger btn-lg fw-bold pd-btn-cart">
                                                🛒 Thêm vào giỏ hàng
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="/Identity/Account/Login" class="btn btn-danger btn-lg fw-bold pd-btn-cart">
                                                🛒 Thêm vào giỏ hàng
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary btn-lg fw-bold pd-btn-cart" disabled>
                                            🚫 Hết hàng
                                        </button>
                                    }
                                </div>
                            </form>

                            @if (!string.IsNullOrEmpty(Model.SalePromotion))
                            {
                                <div class="pd-promo mt-3">
                                    <div class="pd-promo-title">💸 Khuyến mãi</div>
                                    <div class="pd-promo-box">
                                        @Html.Raw(Model.SalePromotion.Replace("\n", "<br/>"))
                                    </div>
                                </div>
                            }

                            <div class="pd-showroom mt-3">
                                <div class="pd-showroom-title">🏬 Hệ thống cửa hàng</div>
                                <div class="pd-showroom-grid">
                                    <div class="s-col">
                                        <div class="s-head">Showroom HCM</div>
                                        <ul>
                                            <li>78-80-82 Hoàng Hoa Thám, P. Bảy Hiền, Tân Bình</li>
                                            <li>905 Kha Vạn Cân, Thủ Đức</li>
                                            <li>1081-1083 Trần Hưng Đạo, Q.5</li>
                                            <li>63 Nguyễn Cư Trinh, Q.1</li>
                                        </ul>
                                    </div>
                                    <div class="s-col">
                                        <div class="s-head">Showroom HN</div>
                                        <ul>
                                            <li>162-164 Thái Hà, Đống Đa</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div> <!-- /pd-info -->
                </div>
            </div>
        </div>
    </div>

    <!-- =========================
         RELATED PRODUCTS
    ========================== -->
    <div class="related-products mt-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h5 class="fw-bold text-danger mb-0">🔥 Sản phẩm tương tự</h5>
        </div>

        <div class="row g-3">
            @if (ViewBag.RelatedProducts != null)
            {
                foreach (var p in ViewBag.RelatedProducts)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/Product/Details/@p.Id" class="pd-rel-card text-decoration-none">
                            <div class="img-wrap">
                                <img src="@p.ImageUrl" onerror="this.onerror=null;this.src='/images/no-image.png';" alt="@p.Name" />
                            </div>
                            <div class="body">
                                <div class="name">@p.Name</div>
                                <div class="price">@String.Format("{0:N0}đ", p.NewPrice)</div>
                                <div class="btn-like">Xem chi tiết</div>
                            </div>
                        </a>
                    </div>
                }
            }
        </div>
    </div>

    <!-- =========================
         TABS: Specs / Description
    ========================== -->
    <div class="product-tabs mt-4">
        <div class="pd-tabs-head">
            <button class="tab-btn active" data-tab="specs" type="button">
                <i class="fa-solid fa-file-lines me-1"></i> Thông số kỹ thuật
            </button>
            <button class="tab-btn" data-tab="desc" type="button">
                <i class="fa-solid fa-circle-info me-1"></i> Thông tin sản phẩm
            </button>
        </div>

        <div class="pd-tabs-body">
            <!-- ===== TAB 1: SPECS (ĐẸP KIỂU TGDD) ===== -->
            <div id="tab-specs" class="pd-pane active">
                @if (string.IsNullOrWhiteSpace(Model.Specifications))
                {
                    <div class="pd-empty">Chưa có thông số kỹ thuật cho sản phẩm này.</div>
                }
                else
                {
                    <div class="pd-spec-wrap">
                        <div class="pd-spec-title">Cấu hình chi tiết</div>

                        <div class="pd-spec-accordion">
                            @for (int gi = 0; gi < groups.Count; gi++)
                            {
                                var g = groups[gi];
                                if (g.Rows == null || !g.Rows.Any()) { continue; }

                                var accId = "acc_" + gi;
                                <div class="acc-item">
                                    <button class="acc-head" type="button" data-target="#@accId">
                                        <span>@g.Title</span>
                                        <i class="fa-solid fa-chevron-down"></i>
                                    </button>

                                    <div class="acc-body" id="@accId" style="@(gi == 0 ? "display:block" : "display:none")">
                                        <table class="pd-spec-table">
                                            <tbody>
                                                @foreach (var row in g.Rows)
                                                {
                                                    <tr>
                                                        <td class="k">@Label(row.Key)</td>
                                                        <td class="v">@Pretty(row.Key, row.Value)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>

                                        @if (g.Title.Contains("Tiện ích") && featureList.Any())
                                        {
                                            <div class="pd-spec-tags">
                                                @foreach (var f in featureList.Distinct(StringComparer.OrdinalIgnoreCase))
                                                {
                                                    <span class="tag">@f</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="pd-spec-note">
                            <i class="fa-regular fa-circle-check"></i>
                            Thông số có thể thay đổi theo phiên bản / thị trường. Vui lòng liên hệ để xác nhận.
                        </div>
                    </div>
                }
            </div>

            <!-- ===== TAB 2: DESCRIPTION ===== -->
            <div id="tab-desc" class="pd-pane">
                <div class="pd-desc">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        @Html.Raw(Model.Description)
                    }
                    else
                    {
                        <div class="pd-empty">Chưa có mô tả cho sản phẩm này.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- =========================
         REVIEWS (GIỮ LOGIC CŨ)
    ========================== -->
    <div class="product-reviews mt-5">
        <h5 class="fw-bold text-danger mb-3">📝 Đánh giá sản phẩm</h5>

        @{
            var reviews = ViewBag.Reviews as List<website_e_commerce.Models.Reviews>;
            double avgRating = (reviews != null && reviews.Count > 0) ? reviews.Average(r => r.Rating) : 0;
            int totalReviews = reviews?.Count ?? 0;
        }

        @if (totalReviews > 0)
        {
            <div class="rating-summary mb-3 d-flex align-items-center">
                <div class="stars me-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Floor(avgRating))
                        {
                            <i class="fa-solid fa-star text-warning"></i>
                        }
                        else if (i - avgRating < 1)
                        {
                            <i class="fa-solid fa-star-half-stroke text-warning"></i>
                        }
                        else
                        {
                            <i class="fa-regular fa-star text-muted"></i>
                        }
                    }
                </div>
                <div class="fw-bold fs-5 text-dark">@avgRating.ToString("0.0") / 5</div>
                <div class="text-muted ms-2">(@totalReviews đánh giá)</div>
            </div>
        }
        else
        {
            <p class="text-muted">Chưa có đánh giá nào cho sản phẩm này.</p>
        }

        <!-- FORM GỬI ĐÁNH GIÁ -->
        <form id="reviewForm" method="post" action="/Review/AddReview" class="card border-0 shadow-sm p-3">
            <input type="hidden" name="ProductId" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label fw-bold d-block">Đánh giá của bạn:</label>
                <div class="rating-stars d-flex flex-row-reverse justify-content-start">
                    @for (int i = 5; i >= 1; i--)
                    {
                        <input type="radio" id="star-@i" name="Rating" value="@i" class="d-none" />
                        <label for="star-@i" class="star">&#9733;</label>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Tiêu đề</label>
                <input type="text" name="Title" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Nội dung</label>
                <textarea name="Body" rows="4" class="form-control" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary fw-bold">Gửi đánh giá</button>

            <div id="reviewMessage" class="alert alert-success mt-3 d-none mb-0">
                ✅ Cảm ơn bạn đã gửi đánh giá!
            </div>
        </form>

        <hr class="my-4" />

        <h6 class="fw-bold mb-3">📣 Các đánh giá gần đây</h6>
        <div id="reviewList" class="card border-0 shadow-sm p-3">
            @if (reviews != null && reviews.Any())
            {
                foreach (var r in reviews)
                {
                    <div class="review-item border-bottom py-3" id="review-@r.Id">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@r.Title</strong>
                                <small class="text-muted">(@r.CreatedAt.ToString("dd/MM/yyyy"))</small>
                            </div>
                            <div>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fa@((i <= r.Rating) ? " fa-solid fa-star text-warning" : " fa-regular fa-star text-secondary")"></i>
                                }
                            </div>
                        </div>

                        <p class="mb-1 mt-1">@r.Body</p>

                        @if (r.Replies != null && r.Replies.Any())
                        {
                            <div class="review-replies ms-4 mt-2">
                                @foreach (var reply in r.Replies.OrderBy(x => x.CreatedAt))
                                {
                                    <div class="reply-item small py-1">
                                        <span class="fw-bold @(reply.IsAuto ? "text-danger" : "text-primary")">@reply.UserName:</span>
                                        <span>@reply.Content</span>
                                        <small class="text-muted">(@reply.CreatedAt.ToString("dd/MM/yyyy HH:mm"))</small>
                                    </div>
                                }
                            </div>
                        }

                        <div class="reply-form-wrapper ms-4 mt-2">
                            <button type="button" class="btn btn-link p-0 small text-primary toggle-reply" data-review-id="@r.Id">
                                💬 Trả lời
                            </button>

                            <form class="reply-form d-none mt-2" data-review-id="@r.Id">
                                <input type="hidden" name="ReviewId" value="@r.Id" />
                                <textarea name="Content" class="form-control form-control-sm mb-2" rows="2" placeholder="Nhập nội dung trả lời..."></textarea>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Gửi trả lời</button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted mb-0">Chưa có đánh giá nào cho sản phẩm này.</p>
            }
        </div>
    </div>
</div>

<!-- Toast -->
<div id="toastCart" class="toast-cart">✅ Sản phẩm đã được thêm vào giỏ hàng!</div>

<style>
    /* =========================
           PAGE LOOK (GIỐNG WEB THỊ TRƯỜNG)
        ========================== */
    .pd-page {
        max-width: 1180px;
    }

    .pd-top {
        border-radius: 16px;
    }

    .pd-name {
        font-size: 26px;
        font-weight: 800;
        line-height: 1.25;
        margin-bottom: 6px;
    }

    /* Gallery */

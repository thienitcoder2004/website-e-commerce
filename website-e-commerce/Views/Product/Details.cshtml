</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        /* =============================
           🖼️  XỬ LÝ HÌNH ẢNH SẢN PHẨM
        ============================== */
        const mainImage = document.getElementById("mainProductImage");
        const thumbs = document.querySelectorAll(".thumb-image");
        const container = document.getElementById("thumbContainer");
        const btnPrev = document.getElementById("thumbPrev");
        const btnNext = document.getElementById("thumbNext");

        if (thumbs && mainImage) {
            thumbs.forEach(img => {
                img.addEventListener("click", function () {
                    thumbs.forEach(t => t.classList.remove("active"));
                    this.classList.add("active");
                    mainImage.src = this.src;
                });
            });
        }

        if (btnPrev && btnNext && container) {
            btnPrev.addEventListener("click", () => container.scrollBy({ left: -240, behavior: "smooth" }));
            btnNext.addEventListener("click", () => container.scrollBy({ left: 240, behavior: "smooth" }));
        }

        /* =============================
           🛒  XỬ LÝ THÊM VÀO GIỎ HÀNG
        ============================== */
        const formCart = document.getElementById("addToCartForm");

        if (formCart) {
            formCart.addEventListener("submit", function (e) {
                e.preventDefault();

                const formData = new FormData(formCart);
                fetch(formCart.action, { method: "POST", body: formData })
                    .then(res => {
                        if (res.ok) showToastCart();
                        else alert("Lỗi khi thêm vào giỏ hàng!");
                    })
                    .catch(() => alert("Không thể kết nối đến máy chủ!"));
            });
        }

        function showToastCart() {
            const toast = document.getElementById("toastCart");
            if (!toast) return;
            toast.classList.add("show");
            setTimeout(() => toast.classList.remove("show"), 2000);
        }

        /* =============================
           🔢  CHỌN SỐ LƯỢNG
        ============================== */
        const maxQty = @Model.WebQuantity;
        const minusBtn = document.querySelector(".btn-qty.minus");
        const plusBtn = document.querySelector(".btn-qty.plus");
        const qtyInput = document.querySelector(".qty-input");

        if (qtyInput && minusBtn && plusBtn) {

            if (maxQty <= 1) {
                plusBtn.disabled = true;
            }

            minusBtn.addEventListener("click", () => {
                let v = parseInt(qtyInput.value);
                if (v > 1) qtyInput.value = v - 1;
                if (parseInt(qtyInput.value) < maxQty) plusBtn.disabled = false;
            });

            plusBtn.addEventListener("click", () => {
                let v = parseInt(qtyInput.value);
                if (v < maxQty) qtyInput.value = v + 1;
                if (parseInt(qtyInput.value) >= maxQty) plusBtn.disabled = true;
            });
        }

        /* =============================
           📑  CHUYỂN TAB THÔNG TIN
        ============================== */
        const tabButtons = document.querySelectorAll(".tab-btn");
        const tabPanes = document.querySelectorAll(".pd-pane");

        if (tabButtons && tabPanes) {
            tabButtons.forEach(btn => {
                btn.addEventListener("click", () => {
                    tabButtons.forEach(b => b.classList.remove("active"));
                    tabPanes.forEach(p => p.classList.remove("active"));
                    btn.classList.add("active");

                    const tabId = btn.getAttribute("data-tab");
                    const pane = document.getElementById("tab-" + tabId);
                    if (pane) pane.classList.add("active");
                });
            });
        }

        /* =============================
           ✅ Accordion Specs
        ============================== */
        document.querySelectorAll(".acc-head").forEach(h => {
            h.addEventListener("click", () => {
                const target = document.querySelector(h.getAttribute("data-target"));
                const isOpen = target && target.style.display === "block";

                // close others
                document.querySelectorAll(".acc-body").forEach(b => b.style.display = "none");
                document.querySelectorAll(".acc-head").forEach(x => x.classList.remove("open"));

                if (target) {
                    target.style.display = isOpen ? "none" : "block";
                    if (!isOpen) h.classList.add("open");
                }
            });
        });

        /* =============================
           ✍️  GỬI ĐÁNH GIÁ SẢN PHẨM
        ============================== */
        const reviewForm = document.getElementById("reviewForm");

        if (reviewForm) {
            reviewForm.addEventListener("submit", function (e) {
                e.preventDefault();

                const rating = document.querySelector('input[name="Rating"]:checked');
                if (!rating) {
                    alert("⚠️ Vui lòng chọn số sao đánh giá!");
                    return;
                }

                const formData = new FormData(this);

                fetch(this.action, { method: "POST", body: formData })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            const msg = document.getElementById("reviewMessage");
                            if (msg) msg.classList.remove("d-none");
                            this.reset();
                            document.querySelectorAll('input[name="Rating"]').forEach(r => r.checked = false);

                            setTimeout(() => {
                                if (msg) msg.classList.add("d-none");
                                location.reload();
                            }, 1200);
                        } else {
                            alert(data.message || "Có lỗi xảy ra khi gửi đánh giá!");
                        }
                    })
                    .catch(() => alert("Không thể gửi đánh giá, vui lòng thử lại!"));
            });
        }

        /* =============================
           💬  TRẢ LỜI ĐÁNH GIÁ
        ============================== */
        document.querySelectorAll(".toggle-reply").forEach(btn => {
            btn.addEventListener("click", function () {
                const id = this.dataset.reviewId;
                const form = document.querySelector(`form.reply-form[data-review-id="${id}"]`);
                if (form) form.classList.toggle("d-none");
            });
        });

        document.querySelectorAll("form.reply-form").forEach(f => {
            f.addEventListener("submit", function (e) {
                e.preventDefault();
                const fd = new FormData(this);

                const content = fd.get("Content");
                if (!content || !content.toString().trim()) {
                    alert("Vui lòng nhập nội dung trả lời.");
                    return;
                }

                fetch("/Review/AddReply", { method: "POST", body: fd })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) location.reload();
                        else alert(data.message || "Không thể gửi trả lời.");
                    })
                    .catch(() => alert("Không thể kết nối đến máy chủ."));
            });
        });

    });
</script>

@model website_e_commerce.Models.Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4 p-3">
        <div class="row">
            <div class="col-md-5 text-center">
                <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name" />
            </div>

            <div class="col-md-7">
                <h3>@Model.Name</h3>
                <p><strong>Danh mục:</strong> @Model.Category?.Name</p>
                <p><strong>Giá cũ:</strong> <span class="text-decoration-line-through">@String.Format("{0:N0}đ", Model.OldPrice)</span></p>
                <p><strong>Giá mới:</strong> <span class="text-danger">@String.Format("{0:N0}đ", Model.NewPrice)</span></p>
                <p><strong>Giảm giá:</strong> @Model.DiscountPercent%</p>
                <p><strong>Mô tả:</strong></p>
                <p>@Model.Description</p>

                <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <div class="d-flex align-items-center mb-3">
                        <label for="quantity" class="me-2 fw-bold">Số lượng:</label>
                        <input type="number" id="quantity" name="quantity" value="1" min="1" class="form-control w-25" />
                    </div>
                    <button type="submit" class="btn btn-success me-2">🛒 Thêm vào giỏ hàng</button>
                    <a asp-action="Product/Index" class="btn btn-secondary">⬅ Trở lại</a>
                </form>
            </div>
        </div>
    </div>
</div>

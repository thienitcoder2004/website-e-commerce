@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Tabs
            const tabs = document.querySelectorAll(".c-tab");
            const panes = {
                highlight: document.getElementById("tab-highlight"),
                detail: document.getElementById("tab-detail"),
            };

            function activateTab(key){
                tabs.forEach(x => x.classList.remove("active"));
                tabs.forEach(x => { if(x.getAttribute("data-tab") === key) x.classList.add("active"); });
                Object.values(panes).forEach(p => p.classList.remove("active"));
                panes[key].classList.add("active");
                updateRows();
            }

            tabs.forEach(t => {
                t.addEventListener("click", () => activateTab(t.getAttribute("data-tab")));
            });

            // Accordion
            document.querySelectorAll(".c-group").forEach((g, idx) => {
                const head = g.querySelector(".c-group-head");
                if (!head) return;
                if (idx === 0) g.classList.add("open");
                head.addEventListener("click", () => g.classList.toggle("open"));
            });

            // Only Different
            const chk = document.getElementById("onlyDifferent");
            function normalizeText(s) { return (s || "").trim().toLowerCase().replace(/\s+/g, " "); }

            function updateRows() {
                if (!chk) return;
                const onlyDiff = chk.checked;

                document.querySelectorAll(".compare-row").forEach(row => {
                    const tds = row.querySelectorAll("td");
                    if (!tds || tds.length === 0) return;

                    const values = Array.from(tds).map(td => normalizeText(td.innerText));
                    const first = values[0];
                    const allSame = values.every(v => v === first);

                    row.style.display = (onlyDiff && allSame) ? "none" : "";
                });
            }

            if (chk) {
                chk.addEventListener("change", updateRows);
                updateRows();
            }
        });
    </script>
}

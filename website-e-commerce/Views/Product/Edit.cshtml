@model website_e_commerce.Models.Product
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4">
    <h3 class="mb-3 text-primary">✏️ Chỉnh sửa sản phẩm</h3>
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="OldPrice" class="form-label"></label>
            <input asp-for="OldPrice" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="NewPrice" class="form-label"></label>
            <input asp-for="NewPrice" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="DiscountPercent" class="form-label"></label>
            <input asp-for="DiscountPercent" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Danh mục</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Ảnh hiện tại</label><br />
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" style="max-width: 150px; border-radius: 8px;" />
            }
        </div>

        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label">Cập nhật ảnh mới</label>
            <input asp-for="ImageUrl" type="file" name="imageUrl" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">💾 Cập nhật</button>
        <a asp-action="Index" class="btn btn-secondary">⬅ Trở lại</a>
    </form>
</div>

@model website_e_commerce.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4 text-center">➕ Sửa sản phẩm</h2>

    <form asp-action="Edit" enctype="multipart/form-data" method="post" class="shadow p-4 rounded bg-light">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="OldPrice" class="form-label"></label>
                <input asp-for="OldPrice" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="NewPrice" class="form-label"></label>
                <input asp-for="NewPrice" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="DiscountPercent" class="form-label"></label>
                <input asp-for="DiscountPercent" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Ảnh chính</label>
                <input type="file" name="imageUrl" class="form-control" />
            </div>

            <div class="col-md-12">
                <label class="form-label">Ảnh phụ (nhiều ảnh)</label>
                <input type="file" name="extraImages" class="form-control" multiple />
            </div>

            <div class="col-md-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" rows="3" class="form-control"></textarea>
            </div>

            <div class="col-md-12">
                <label asp-for="Specifications" class="form-label"></label>
                <textarea asp-for="Specifications" rows="3" class="form-control"></textarea>
            </div>

            <div class="col-md-6">
                <label asp-for="GiftPromotion" class="form-label"></label>
                <textarea asp-for="GiftPromotion" class="form-control"></textarea>
            </div>

            <div class="col-md-6">
                <label asp-for="SalePromotion" class="form-label"></label>
                <textarea asp-for="SalePromotion" class="form-control"></textarea>
            </div>
        </div>

        <div class="mt-4 text-center">
            <button type="submit" class="btn btn-primary px-4">💾 Lưu</button>
            <a asp-action="Index" class="btn btn-secondary px-4">⬅ Quay lại</a>
        </div>
    </form>
</div>

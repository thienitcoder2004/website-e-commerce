@model website_e_commerce.Models.News
@{
    ViewData["Title"] = "Xóa bài viết";
}

<div class="container mt-5" style="max-width:800px;">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="fw-bold mb-0">⚠️ Xác nhận xóa bài viết</h4>
        </div>

        <div class="card-body">

            <p class="fs-5">Bạn có chắc chắn muốn xóa bài viết sau?</p>

            <div class="border rounded p-3 bg-light mb-4">
                <h5 class="fw-bold text-danger">@Model.Title</h5>
                <p><strong>Tác giả:</strong> @Model.Author</p>
                <p><strong>Ngày đăng:</strong> @Model.PublishedDate.ToString("dd/MM/yyyy")</p>
                <p><strong>Tóm tắt:</strong> @Model.Summary</p>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="rounded mt-3" style="height:200px; object-fit:cover;" />
                }
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="text-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">Hủy</a>
                    <button class="btn btn-danger px-4" type="submit">Xóa ngay</button>
                </div>
            </form>

        </div>
    </div>
</div>

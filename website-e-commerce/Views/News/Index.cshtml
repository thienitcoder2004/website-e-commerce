@model IEnumerable<website_e_commerce.Models.News>
@using website_e_commerce.Models

@{
    ViewData["Title"] = "Tin tức";

    int totalNews = ViewBag.TotalNews ?? (Model?.Count() ?? 0);
    var list = (Model ?? Enumerable.Empty<News>()).ToList();
}
@{
    var latest = list.OrderByDescending(x => x.PublishedDate).ToList();
    var featured = latest.FirstOrDefault();
    var below3 = latest.Skip(1).Take(3).ToList();
    var grid = latest.Skip(4).Take(9).ToList();          // tin nhỏ phía dưới
    var tabLatest = latest.Take(15).ToList();            // tab "Tin mới"
    var tabMost = list.OrderByDescending(x => x.ViewCount).Take(15).ToList(); // tab "Đọc nhiều"
}

<style>
    #toastNotif {
        position: fixed;
        top: 25px;
        right: 25px;
        padding: 14px 26px;
        background: linear-gradient(135deg, #28a745, #42d67c);
        color: white;
        font-weight: 600;
        border-radius: 10px;
        opacity: 0;
        transform: translateY(-20px);
        transition: all .4s ease;
        z-index: 9999;
        pointer-events: none;
    }
    #toastNotif.show { opacity: 1; transform: translateY(0); }
</style>

<style>
    /* ====== ADMIN TABLE STYLE (giữ nguyên bạn) ====== */
    .news-card {
        transition: all 0.3s ease;
        border-radius: 16px;
        overflow: hidden;
        background-color: #fff;
        border: 1px solid #eee;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    }
    .news-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }
    .news-card img { height: 220px; object-fit: cover; width: 100%; }
    .news-title { font-size: 1.05rem; font-weight: 600; margin-bottom: 8px; color: #222; transition: color 0.2s; }
    .news-title:hover { color: #0d6efd; }
    .news-meta { font-size: 0.9rem; color: #777; margin-bottom: 10px; }
    .news-summary { color: #555; font-size: 0.95rem; min-height: 70px; }
</style>

@if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
{
    <style>
        .news-page-wrapper {
            background: radial-gradient(circle at top left, #eef2ff, #ffffff);
            border-radius: 18px;
            padding: 28px 24px;
            margin-top: 20px;
            box-shadow: 0 8px 24px rgba(15,23,42,0.12);
        }
        .news-title {
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .06em;
            font-size: 18px;
        }
        .news-subtitle { font-size: 13px; color: #6b7280; }
        .news-badge-summary {
            font-size: 13px;
            padding: 6px 14px;
            border-radius: 999px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            color: #4b5563;
        }
        .btn-news-add {
            border-radius: 999px;
            padding: 8px 18px;
            font-size: 14px;
        }
        .news-table-wrapper {
            border-radius: 16px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 4px 18px rgba(15,23,42,0.08);
        }
        .table thead th {
            background: #0d6efd;
            color: white;
            border-bottom: none;
            font-size: 14px;
            text-transform: uppercase;
        }
        .table tbody tr:hover { background: #f3f4ff; }
        .news-thumb {
            width: 110px;
            height: 70px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #e5e7eb;
        }
        .status-pill {
            font-size: 12px;
            padding: 6px 12px;
            border-radius: 999px;
            font-weight: 600;
            display: inline-block;
        }
        .st-published { background: #e6ffed; color: #0f8a39; border: 1px solid #9ef8c2; }
        .st-draft { background: #ececec; color: #6b7280; border: 1px solid #bdbdbd; }
    </style>

    <div class="container">
        <div class="news-page-wrapper">
            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h2 class="news-title text-primary mb-1">📰 Quản lý tin tức</h2>
                    <p class="news-subtitle mb-0">Theo dõi các bài viết tin tức và cập nhật nội dung trang Blog.</p>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="news-badge-summary">
                        <i class="fa-solid fa-newspaper me-1"></i> Tổng tin tức:
                        <strong>@totalNews</strong>
                    </span>

                    <a asp-action="Add" class="btn btn-success btn-news-add">
                        <i class="fa-solid fa-plus"></i> Thêm tin mới
                    </a>
                </div>
            </div>

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    @TempData["Message"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- TABLE -->
            <div class="news-table-wrapper">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center">
                        <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th class="text-start ps-4">Tiêu đề</th>
                            <th>Tác giả</th>
                            <th>Ngày đăng</th>
                            <th style="width:120px;">Lượt xem</th>
                            <th style="width:140px;">Trạng thái</th>
                            <th style="width:200px;">Hành động</th>
                        </tr>
                        </thead>

                        <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var news in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(string.IsNullOrWhiteSpace(news.ImageUrl) ? "/images/news/no-image.png" : news.ImageUrl)"
                                             class="news-thumb"
                                             onerror="this.onerror=null;this.src='/images/news/no-image.png';" />
                                    </td>
                                    <td class="fw-semibold text-start">@news.Title</td>
                                    <td>@news.Author</td>
                                    <td>@news.PublishedDate.ToString("dd/MM/yyyy")</td>
                                    <td>@news.ViewCount</td>

                                    <td>
                                        @if (news.IsPublished)
                                        {
                                            <span class="status-pill st-published">
                                                <i class="fa-solid fa-circle-check"></i> Đã đăng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill st-draft">
                                                <i class="fa-solid fa-clock"></i> Chưa đăng
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="Detail" asp-route-id="@news.Id" class="btn btn-sm btn-info">
                                                <i class="fa-solid fa-circle-info"></i>
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@news.Id" class="btn btn-sm btn-warning">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>

                                            <form asp-action="Delete" asp-route-id="@news.Id" method="post"
                                                  onsubmit="return confirm('Bạn có chắc muốn xoá tin tức này?');">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="py-4 text-muted">Không có tin tức nào.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- PHÂN TRANG ADMIN (giữ nguyên nếu bạn đang dùng ViewBag.TotalPages) -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">Trước</a>
                        </li>

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>

    <div id="toastNotif"><span id="toastMessage"></span></div>

    @section Scripts {
        <script>
            function showToast(message) {
                const toast = document.getElementById("toastNotif");
                document.getElementById("toastMessage").innerText = message;
                toast.classList.add("show");
                setTimeout(() => toast.classList.remove("show"), 2500);
            }

            @if (TempData["Message"] != null)
            {
                <text>
                    showToast(@Json.Serialize(TempData["Message"]));
                </text>
            }
        </script>
    }
}
else
{
    <style>
        /* ===== Page shell ===== */
        .news-page {
            padding-bottom: 34px;
        }

        .news-breadcrumb {
            background: #fff;
            border-bottom: 1px solid #eceff4;
            padding: 12px 0;
        }

        .news-breadcrumb a {
            text-decoration: none;
            color: #0d6efd;
            font-weight: 600;
        }

        .news-breadcrumb .sep {
            margin: 0 8px;
            color: #94a3b8;
        }

        .news-header {
            background: #fff;
            padding: 20px 0 10px;
        }

        .news-header h1 {
            text-align: center;
            font-weight: 900;
            margin: 0;
            letter-spacing: .2px;
        }

        /* ===== Feature icons row (cam) ===== */
        .shop-features {
            background: #fff;
            padding: 18px 0;
            border-top: 1px solid #f1f5f9;
            border-bottom: 1px solid #eef2f7;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
        }
        @@media (max-width: 992px){ .feature-grid { grid-template-columns: repeat(2,1fr);} }
        @@media (max-width: 576px){ .feature-grid { grid-template-columns: 1fr;} }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 10px;
            border-radius: 14px;
            border: 1px solid #f1f5f9;
            background: #fff;
        }

        .feature-ico {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            background: #fff7ed;
            border: 1px solid #ffedd5;
            color: #f97316;
            font-size: 22px;
            flex: 0 0 auto;
        }

        .feature-title { font-weight: 900; margin: 0; font-size: 14px; }
        .feature-sub { margin: 2px 0 0; color: #64748b; font-size: 13px; }

        /* ===== News layout like newspaper ===== */
        .news-wrap {
            padding-top: 18px;
        }

        .news-main {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 16px;
            align-items: start;
        }
        @@media (max-width: 992px){ .news-main { grid-template-columns: 1fr; } }

        /* Left featured */
        .featured {
            background: #fff;
            border-radius: 18px;
            border: 1px solid #eef2f7;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(15,23,42,0.08);
        }

        .featured-img {
            width: 100%;
            aspect-ratio: 16/9;
            background: #e2e8f0;
        }
        .featured-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

        .featured-body {
            padding: 16px 16px 18px;
        }

        .featured-title {
            font-size: 22px;
            font-weight: 900;
            margin: 0 0 10px;
            line-height: 1.25;
        }

        .meta-line {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            color: #64748b;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .meta-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 10px;
            border-radius: 999px;
            background: #f8fafc;
            border: 1px solid #eef2f7;
        }

        .featured-sum {
            color: #334155;
            font-size: 14px;
            line-height: 1.6;
            margin: 0;
        }

        .btn-read {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
            padding: 10px 14px;
            border-radius: 12px;
            background: #0d6efd;
            color: #fff;
            text-decoration: none;
            font-weight: 900;
            box-shadow: 0 10px 22px rgba(13,110,253,.24);
        }
        .btn-read:hover { filter: brightness(.95); }

        .cat-pill {
            position: absolute;
            left: 12px;
            top: 12px;
            background: rgba(220,38,38,0.95);
            color: #fff;
            padding: 5px 10px;
            border-radius: 999px;
            font-weight: 900;
            font-size: 12px;
        }

        .img-rel {
            position: relative;
        }

        /* Right sidebar tabs */
        .sidebox {
            background: #fff;
            border-radius: 18px;
            border: 1px solid #eef2f7;
            box-shadow: 0 10px 30px rgba(15,23,42,0.08);
            overflow: hidden;
        }

        .side-tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            border-bottom: 1px solid #eef2f7;
        }

        .tab-btn {
            padding: 12px 12px;
            font-weight: 900;
            background: #fff;
            border: 0;
            cursor: pointer;
        }

        .tab-btn.active {
            color: #0d6efd;
            border-bottom: 3px solid #0d6efd;
        }

        .side-list {
            max-height: 420px;
            overflow: auto;
            padding: 10px 10px 6px;
        }

        .side-item {
            display: grid;
            grid-template-columns: 16px 1fr;
            gap: 10px;
            padding: 10px 10px;
            border-radius: 14px;
            text-decoration: none;
            color: inherit;
        }

        .side-item:hover { background: #f8fafc; }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: #94a3b8;
            margin-top: 7px;
        }

        .side-title {
            font-weight: 800;
            font-size: 13.5px;
            line-height: 1.3;
            margin: 0;
        }

        .side-meta {
            margin: 6px 0 0;
            font-size: 12.5px;
            color: #64748b;
        }

        .side-footer {
            padding: 12px;
            border-top: 1px solid #eef2f7;
            background: #fff;
        }

        .btn-more {
            width: 100%;
            border: 1px solid #e5e7eb;
            background: #f8fafc;
            padding: 10px 12px;
            border-radius: 12px;
            font-weight: 900;
            cursor: pointer;
        }

        /* Below 3 small articles */
        .below-3 {
            margin-top: 14px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }
        @@media (max-width: 992px){ .below-3 { grid-template-columns: 1fr; } }

        .mini-card {
            background: #fff;
            border-radius: 16px;
            border: 1px solid #eef2f7;
            padding: 14px;
            box-shadow: 0 10px 26px rgba(15,23,42,0.06);
            text-decoration: none;
            color: inherit;
            transition: transform .16s ease, box-shadow .16s ease;
        }
        .mini-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 34px rgba(15,23,42,0.10);
        }

        .mini-title {
            font-weight: 900;
            margin: 0 0 8px;
            line-height: 1.35;
            font-size: 14px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 38px;
        }
        .mini-sum {
            color: #475569;
            font-size: 13px;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 56px;
        }

        /* Grid cards */
        .grid-news {
            margin-top: 16px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }
        @@media (max-width: 992px){ .grid-news { grid-template-columns: repeat(2, 1fr); } }
        @@media (max-width: 576px){ .grid-news { grid-template-columns: 1fr; } }

        .card-news {
            background: #fff;
            border-radius: 18px;
            border: 1px solid #eef2f7;
            overflow: hidden;
            box-shadow: 0 10px 28px rgba(15,23,42,0.08);
            text-decoration: none;
            color: inherit;
            transition: transform .16s ease, box-shadow .16s ease;
        }
        .card-news:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 36px rgba(15,23,42,0.12);
        }

        .card-img {
            width: 100%;
            aspect-ratio: 16/9;
            background: #e2e8f0;
        }
        .card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

        .card-body2 { padding: 12px 12px 14px; }
        .card-title2 {
            margin: 0 0 8px;
            font-weight: 900;
            font-size: 14.5px;
            line-height: 1.35;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 40px;
        }
        .card-sum2 {
            margin: 0;
            color: #475569;
            font-size: 13px;
            line-height: 1.55;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 60px;
        }

        /* Xem tất cả center bottom */
        .center-link {
            display: flex;
            justify-content: center;
            margin-top: 18px;
        }

        .btn-all {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 18px;
            border-radius: 999px;
            border: 1px solid #e5e7eb;
            background: #fff;
            font-weight: 900;
            text-decoration: none;
            color: #0f172a;
            box-shadow: 0 10px 24px rgba(15,23,42,0.08);
        }
        .btn-all:hover { filter: brightness(.98); }
    </style>

    <div class="news-page">
        <!-- BREADCRUMB -->
        <div class="news-breadcrumb">
            <div class="container">
                <a href="/">Trang chủ</a>
                <span class="sep">/</span>
                <span class="fw-bold">Tin tức</span>
            </div>
        </div>

        <!-- TITLE -->
        <div class="news-header">
            <div class="container">
                <h1>Tin tức</h1>
                <p class="text-center text-muted mb-0">Cập nhật tin mới nhất, ưu đãi, mẹo công nghệ mỗi ngày.</p>
            </div>
        </div>

        <!-- NEWS CONTENT -->
        <div class="container news-wrap">
            @if (featured == null)
            {
                <div class="alert alert-info">
                    Chưa có tin tức nào để hiển thị.
                </div>
            }
            else
            {
                <div class="news-main">
                    <!-- LEFT -->
                    <div>
                        <div class="featured">
                            <div class="featured-img img-rel">
                                <img src="@(string.IsNullOrWhiteSpace(featured.ImageUrl) ? "/images/news/no-image.png" : featured.ImageUrl)"
                                     alt="@featured.Title"
                                     onerror="this.onerror=null;this.src='/images/news/no-image.png';" />
                                @if (!string.IsNullOrWhiteSpace(featured.Category))
                                {
                                    <span class="cat-pill">@featured.Category</span>
                                }
                            </div>

                            <div class="featured-body">
                                <div class="meta-line">
                                    <span class="meta-pill">📅 @featured.PublishedDate.ToString("dd/MM/yyyy")</span>
                                    <span class="meta-pill">👁️ @featured.ViewCount</span>
                                    @if (!string.IsNullOrWhiteSpace(featured.Author))
                                    {
                                        <span class="meta-pill">✍️ @featured.Author</span>
                                    }
                                </div>

                                <h2 class="featured-title">@featured.Title</h2>

                                <p class="featured-sum">
                                    @(string.IsNullOrWhiteSpace(featured.Summary) ? "Xem chi tiết để đọc nội dung đầy đủ." : featured.Summary)
                                </p>

                                <a class="btn-read" asp-controller="News" asp-action="Detail" asp-route-id="@featured.Id">
                                    Xem chi tiết →
                                </a>
                            </div>
                        </div>

                        <!-- 3 tin nhỏ ngay dưới (giống ảnh bạn gửi) -->
                        @if (below3.Any())
                        {
                            <div class="below-3">
                                @foreach (var n in below3)
                                {
                                    <a class="mini-card" asp-controller="News" asp-action="Detail" asp-route-id="@n.Id">
                                        <h3 class="mini-title">@n.Title</h3>
                                        <p class="mini-sum">
                                            @(string.IsNullOrWhiteSpace(n.Summary) ? "Xem chi tiết để đọc đầy đủ." : n.Summary)
                                        </p>
                                    </a>
                                }
                            </div>
                        }
                    </div>

                    <!-- RIGHT (TAB) -->
                    <div class="sidebox">
                        <div class="side-tabs">
                            <button type="button" class="tab-btn active" data-tab="latestTab">Tin mới</button>
                            <button type="button" class="tab-btn" data-tab="mostTab">Đọc nhiều</button>
                        </div>

                        <div class="side-list" id="latestTab">
                            @foreach (var n in tabLatest)
                            {
                                <a class="side-item" asp-controller="News" asp-action="Detail" asp-route-id="@n.Id">
                                    <div class="dot"></div>
                                    <div>
                                        <p class="side-title">@n.Title</p>
                                        <div class="side-meta">
                                            📅 @n.PublishedDate.ToString("dd/MM/yyyy") · 👁️ @n.ViewCount
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>

                        <div class="side-list" id="mostTab" style="display:none;">
                            @foreach (var n in tabMost)
                            {
                                <a class="side-item" asp-controller="News" asp-action="Detail" asp-route-id="@n.Id">
                                    <div class="dot"></div>
                                    <div>
                                        <p class="side-title">@n.Title</p>
                                        <div class="side-meta">
                                            📅 @n.PublishedDate.ToString("dd/MM/yyyy") · 👁️ @n.ViewCount
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>

                        <div class="side-footer">
                            <button type="button" class="btn-more" onclick="window.scrollTo({top: document.body.scrollHeight, behavior:'smooth'});">
                                Xem thêm
                            </button>
                        </div>
                    </div>
                </div>

                <!-- GRID tin nhỏ phía dưới -->
                @if (grid.Any())
                {
                    <div class="grid-news">
                        @foreach (var n in grid)
                        {
                            <a class="card-news" asp-controller="News" asp-action="Detail" asp-route-id="@n.Id">
                                <div class="card-img">
                                    <img src="@(string.IsNullOrWhiteSpace(n.ImageUrl) ? "/images/news/no-image.png" : n.ImageUrl)"
                                         alt="@n.Title"
                                         onerror="this.onerror=null;this.src='/images/news/no-image.png';" />
                                </div>
                                <div class="card-body2">
                                    <h3 class="card-title2">@n.Title</h3>
                                    <p class="card-sum2">
                                        @(string.IsNullOrWhiteSpace(n.Summary) ? "Xem chi tiết để đọc nội dung đầy đủ." : n.Summary)
                                    </p>
                                </div>
                            </a>
                        }
                    </div>

                    <!-- Xem tất cả (đặt giữa dưới góc) -->
                    <div class="center-link">
                        <a class="btn-all" href="/News">
                            Xem tất cả
                        </a>
                    </div>
                }
            }
        </div>
    </div>

    @section Scripts {
        <script>
            (function () {
                const btns = document.querySelectorAll(".tab-btn");
                const latest = document.getElementById("latestTab");
                const most = document.getElementById("mostTab");

                btns.forEach(b => {
                    b.addEventListener("click", function () {
                        btns.forEach(x => x.classList.remove("active"));
                        this.classList.add("active");

                        const tab = this.getAttribute("data-tab");
                        if (tab === "latestTab") {
                            latest.style.display = "block";
                            most.style.display = "none";
                        } else {
                            latest.style.display = "none";
                            most.style.display = "block";
                        }
                    });
                });
            })();
        </script>
    }
}

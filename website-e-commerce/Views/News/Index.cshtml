@model IEnumerable<website_e_commerce.Models.News>

<style>
    .news-card {
        transition: all 0.3s ease;
        border-radius: 16px;
        overflow: hidden;
        background-color: #fff;
        border: 1px solid #eee;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    }

        .news-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }

        .news-card img {
            height: 220px;
            object-fit: cover;
            width: 100%;
        }

    .news-title {
        font-size: 1.05rem;
        font-weight: 600;
        margin-bottom: 8px;
        color: #222;
        transition: color 0.2s;
    }

        .news-title:hover {
            color: #0d6efd;
        }

    .news-meta {
        font-size: 0.9rem;
        color: #777;
        margin-bottom: 10px;
    }

    .news-summary {
        color: #555;
        font-size: 0.95rem;
        min-height: 70px;
    }

    .btn-group-sm .btn {
        font-size: 0.85rem;
        padding: 4px 10px;
        border-radius: 8px;
    }

    .add-button {
        background-color: #198754;
        color: #fff;
        border-radius: 8px;
        padding: 8px 14px;
        text-decoration: none;
        transition: 0.2s;
    }

        .add-button:hover {
            background-color: #157347;
        }
</style>

@if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
{
    <div class="container mt-5">
        <h2 class="text-center text-primary mb-4">📰 Danh sách tin tức</h2>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="mb-3 text-end">
            <a asp-action="Add" class="btn btn-success">
                <i class="fa-solid fa-plus"></i> Thêm tin mới
            </a>
        </div>

        <table class="table table-bordered table-hover align-middle shadow-sm">
            <thead class="table-primary text-center">
                <tr>
                    <th style="width:120px;">Ảnh</th>
                    <th>Tiêu đề</th>
                    <th>Tác giả</th>
                    <th>Ngày đăng</th>
                    <th style="width:120px;">Lượt xem</th>
                    <th style="width:140px;">Trạng thái</th>
                    <th style="width:200px;">Hành động</th>
                </tr>
            </thead>

            <tbody class="text-center">
                @if (Model != null && Model.Any())
                {
                    foreach (var news in Model)
                    {
                        <tr>
                            <td>
                                <img src="@news.ImageUrl" class="rounded" style="width:100px; height:60px; object-fit:cover;" />
                            </td>

                            <td class="fw-semibold text-start">@news.Title</td>
                            <td>@news.Author</td>
                            <td>@news.PublishedDate.ToString("dd/MM/yyyy")</td>
                            <td>@news.ViewCount</td>

                            <td>
                                @if (news.IsPublished)
                                {
                                    <span class="badge bg-success">Đã đăng</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Chưa đăng</span>
                                }
                            </td>

                            <td>
                                <a asp-action="Detail" asp-route-id="@news.Id" class="btn btn-sm btn-info me-1">
                                    <i class="fa-solid fa-circle-info"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@news.Id" class="btn btn-sm btn-warning me-1">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>

                                <form asp-action="Delete" asp-route-id="@news.Id" method="post"
                                      onsubmit="return confirm('⚠️ Bạn có chắc muốn xóa bài viết này?');"
                                      style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">Không có tin tức nào.</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">Trước</a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
else
{
    <section class="container mt-5">
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-md-4">
                        <div class="news-card h-100">
                            <img src="@item.ImageUrl" alt="@item.Title" />
                            <div class="p-3 d-flex flex-column">
                                <a href="/News/Detail/@item.Id" class="news-title">@item.Title</a>
                                <p class="news-meta">
                                    📅 @item.PublishedDate.ToString("dd/MM/yyyy") — ✍️ <i>@item.Author</i>
                                </p>
                                <p class="news-summary flex-grow-1">@item.Summary</p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted">
                    <p>Không có tin tức nào để hiển thị.</p>
                </div>
            }
        </div>
    </section>
}


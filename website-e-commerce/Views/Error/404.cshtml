@{
    Layout = null;
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}

<div class="d-flex justify-content-center align-items-center">
    <div class="error-404-container">
        <img src="https://cdn-icons-png.flaticon.com/512/2748/2748558.png"
             alt="404" class="error-404-img" />

        <h1 class="error-404-title">Ôi không! Trang bạn tìm không tồn tại </h1>

        <p class="error-404-desc">
            Có thể link đã bị xoá, thay đổi hoặc bạn nhập sai đường dẫn.
        </p>

        <a href="/" class="error-404-btn">Quay về trang chủ</a>

@model IEnumerable<website_e_commerce.Models.PromotionCode>
@{
    ViewData["Title"] = "Quản lý mã khuyến mãi";
}

<div class="container mt-4">
    <h2 class="text-center fw-bold text-danger mb-4">🎁 Quản lý mã khuyến mãi</h2>
    <a asp-action="Add" class="btn btn-success mb-3">+ Thêm mã mới</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-bordered table-hover text-center align-middle shadow-sm">
        <thead class="table-danger">
            <tr>
                <th>Mã</th>
                <th>Giảm %</th>
                <th>Giảm tiền</th>
                <th>Thời gian áp dụng</th>
                <th>Lượt / Giới hạn</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.DiscountPercent%</td>
                    <td>@String.Format("{0:N0}₫", item.DiscountAmount)</td>
                    <td>@item.StartDate.ToShortDateString() - @item.EndDate.ToShortDateString()</td>
                    <td>@item.UsageCount / @item.MaxUsage</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary">Ngưng</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="btn btn-danger btn-sm" onclick="return confirm('Xóa mã này?')">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
